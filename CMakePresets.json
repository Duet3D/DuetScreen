{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "Base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cmakeExecutable": "${sourceDir}/env/bin/cmake",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "BUILD_SHARED_LIBS": "OFF",
                "BUILD_TESTING": "OFF"
            }
        },
        {
            "name": "Debug",
            "hidden": true,
            "inherits": "Base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTING": "ON",
                "DUETSCREEN_LOG_TIMESTAMPS": "ON",
                "DUETSCREEN_LOG_THREAD": "ON",
                "DUETSCREEN_DEBUG_BORDERS": "ON",
                "DUETSCREEN_ENABLE_CONSOLE_SHELL": "ON",
                "DUETSCREEN_USE_PCH": "ON",
                "DUETSCREEN_SPLIT_DWARF": "OFF"
            }
        },
        {
            "name": "Profiling",
            "hidden": true,
            "cacheVariables": {
                "DUETSCREEN_ENABLE_PROFILING": "ON",
                "DUETSCREEN_ENABLE_LV_PROFILING": "ON"
            }
        },
        {
            "name": "Release",
            "hidden": true,
            "inherits": "Base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "DUETSCREEN_LOG_TIMESTAMPS": "ON",
                "DUETSCREEN_LOG_THREAD": "OFF"
            }
        },
        {
            "name": "Simulation-Base",
            "hidden": true,
            "description": "Configure the project to be run locally on the host machine",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc-15",
                "CMAKE_CXX_COMPILER": "g++-15",
                "PROCESSOR": "Simulation"
            }
        },
        {
            "name": "Simulation",
            "displayName": "Simulation",
            "description": "Configure the project to be run locally on the host machine",
            "inherits": [
                "Simulation-Base",
                "Debug",
                "Profiling"
            ]
        },
        {
            "name": "Simulation-Release",
            "displayName": "Simulation-Release",
            "description": "Configure the project to be run locally on the host machine",
            "inherits": [
                "Simulation-Base",
                "Release"
            ]
        },
        {
            "name": "Test",
            "displayName": "Unit Tests",
            "description": "Configure the project to build and run unit tests",
            "inherits": "Simulation-Release",
            "cacheVariables": {
                "BUILD_TESTING": "ON",
                "ENABLE_COVERAGE": "ON",
                "DUETSCREEN_USE_FIXED_TEST_STRINGS": "ON",
                "DUETSCREEN_USE_LV_ANIMATION": "OFF",
                "DUETSCREEN_USE_PCH": "ON"
            }
        },
        {
            "name": "T113-Base",
            "hidden": true,
            "description": "Configure the project to be run on T113 with debug symbols",
            "cacheVariables": {
                "PROCESSOR": "T113"
            }
        },
        {
            "name": "T113-Debug",
            "displayName": "T113 Debug",
            "description": "Configure the project to be run on T113 with debug symbols",
            "inherits": [
                "T113-Base",
                "Debug",
                "Profiling"
            ]
        },
        {
            "name": "T113-Release",
            "displayName": "T113 Release",
            "description": "Configure the project to be run on T113 without debug symbols",
            "inherits": [
                "T113-Base",
                "Release"
            ]
        },
        {
            "name": "T113-Release_with_profiling",
            "displayName": "T113 Release with Profiling",
            "description": "Configure the project to be run on T113 without debug symbols but with profiling enabled",
            "inherits": [
                "T113-Release",
                "Profiling"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "T113-Debug",
            "description": "",
            "displayName": "",
            "configurePreset": "T113-Debug"
        },
        {
            "name": "T113-Release",
            "description": "",
            "displayName": "",
            "configurePreset": "T113-Release"
        },
        {
            "name": "T113-Release_with_profiling",
            "description": "",
            "displayName": "",
            "configurePreset": "T113-Release_with_profiling"
        },
        {
            "name": "Simulation",
            "description": "",
            "displayName": "",
            "configurePreset": "Simulation"
        },
        {
            "name": "Simulation-Release",
            "description": "",
            "displayName": "",
            "configurePreset": "Simulation-Release"
        },
        {
            "name": "Test",
            "description": "",
            "displayName": "",
            "configurePreset": "Test"
        }
    ]
}