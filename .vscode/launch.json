{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "inputs": [
        {
            "id": "log_filters",
            "type": "promptString",
            "description": "Log filters (quote enclosed and space separated e.g. \"filter1\" \"filter2\"), add `-f` to follow the log file"
        },
        {
            "id": "gtest_filter",
            "type": "promptString",
            "description": "GoogleTest filter (e.g. SuiteName.TestName or pattern like SuiteName.*)",
            "default": "*"
        },
        {
            "id": "duetscreen_ip_address",
            "type": "promptString",
            "description": "IP address for DuetScreen"
        }
    ],
    "configurations": [
        {
            "name": "Debug DuetScreen",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/out/build/${command:cmake.activeConfigurePresetName}/DuetScreen",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "CMake: build",
            "stopAtEntry": false,
            "linux": {
                "MIMode": "gdb",
                "miDebuggerPath": "/usr/bin/gdb"
            },
            "osx": {
                "MIMode": "lldb"
            },
            "windows": {
                "MIMode": "gdb",
                "miDebuggerPath": "C:\\MinGw\\bin\\gdb.exe"
            },
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
            ],
            "miDebuggerArgs": "-x '${workspaceFolder}/.vscode/gdb.conf'"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug DuetScreen - LLDB",
            "program": "${workspaceFolder}/out/build/${command:cmake.activeConfigurePresetName}/DuetScreen",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "CMake: build"
        },
        {
            "name": "Debug GTest",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/out/build/${command:cmake.activeConfigurePresetName}/tests/DuetScreen.tests",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "CMake: build tests",
            "stopAtEntry": false,
            "linux": {
                "MIMode": "gdb",
                "miDebuggerPath": "/usr/bin/gdb"
            },
            "osx": {
                "MIMode": "lldb"
            },
            "windows": {
                "MIMode": "gdb",
                "miDebuggerPath": "C:\\MinGw\\bin\\gdb.exe"
            },
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
            ],
            "miDebuggerArgs": "-x '${workspaceFolder}/.vscode/gdb.conf'"
        },
        {
            "name": "Debug GTest - CMake Tools",
            "type": "cppdbg",
            "request": "launch",
            "program": "${cmake.testProgram}",
            "args": [
                "${cmake.testArgs}"
            ],
            "cwd": "${workspaceFolder}",
            // "preLaunchTask": "CMake: build tests",
            "stopAtEntry": false,
            "linux": {
                "MIMode": "gdb",
                "miDebuggerPath": "/usr/bin/gdb"
            },
            "osx": {
                "MIMode": "lldb"
            },
            "windows": {
                "MIMode": "gdb",
                "miDebuggerPath": "C:\\MinGw\\bin\\gdb.exe"
            },
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
            ],
            "miDebuggerArgs": "-x '${workspaceFolder}/.vscode/gdb.conf'"
        },
        {
            "name": "Debug GTest (filter prompt)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/out/build/${command:cmake.activeConfigurePresetName}/tests/DuetScreen.tests",
            "args": [
                "--gtest_filter=${input:gtest_filter}"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "CMake: build tests",
            "stopAtEntry": false,
            "linux": {
                "MIMode": "gdb",
                "miDebuggerPath": "/usr/bin/gdb"
            },
            "osx": {
                "MIMode": "lldb"
            },
            "windows": {
                "MIMode": "gdb",
                "miDebuggerPath": "C:\\MinGw\\bin\\gdb.exe"
            },
            "environment": [
                {
                    "name": "GTEST_COLOR",
                    "value": "yes"
                }
            ],
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
            ],
            "miDebuggerArgs": "-x '${workspaceFolder}/.vscode/gdb.conf'"
        },
        {
            // This configuration does not work yet.
            // Issues:
            // - Source mapping does not work fully
            //  - Breakpoints need to be set in the buildroot source directory, but vscode stops in the workspace directory
            // - Not all breakpoints are hit
            // - A SIGTRAP is received whenever a thread is joined
            // Fix:
            // - It is suspected that the version of gdbserver on the DuetScreen is not compatible with lldb
            // - Possibly compiling lldb-server on the DuetScreen will fix this
            "type": "lldb",
            "request": "launch",
            "name": "(WIP) Remote Debug DuetScreen - LLDB",
            "program": "${config:buildroot_path}/output/build/duetscreen-HEAD/out/build/T113-Debug/DuetScreen",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Start gdbserver on DuetScreen",
            "targetCreateCommands": [
                "target create ${config:buildroot_path}/output/build/duetscreen-HEAD/out/build/T113-Debug/DuetScreen"
            ],
            "processCreateCommands": [
                "gdb-remote ${input:duetscreen_ip_address}:3000",
                "settings set target.source-map ${config:buildroot_path}/output/build/duetscreen-HEAD ${workspaceFolder}"
            ],
            // "sourceMap": {
            //     "${config:buildroot_path}/output/build/duetscreen-HEAD/src": "${workspaceFolder}/src"
            // }
        },
        {
            "name": "Remote Debug DuetScreen",
            "type": "cppdbg",
            "request": "launch",
            "envFile": "${workspaceFolder}/.vscode/.env",
            "program": "${config:buildroot_path}/output/build/duetscreen-HEAD/out/build/T113-Debug/DuetScreen",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Start gdbserver on DuetScreen",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb-multiarch",
            "miDebuggerServerAddress": "${input:duetscreen_ip_address}:3000",
            "miDebuggerArgs": "-x '${workspaceFolder}/.vscode/gdb.conf'",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
            ],
            "externalConsole": false,
            "sourceFileMap": {
                "${config:buildroot_path}/output/build/duetscreen-HEAD/src": "${workspaceFolder}/src",
                "${config:buildroot_path}/output/build/duetscreen-HEAD/libraries": "${workspaceFolder}/libraries"
            }
        },
        {
            "name": "Remote Debug DuetScreen - Release",
            "type": "cppdbg",
            "request": "launch",
            "envFile": "${workspaceFolder}/.vscode/.env",
            "program": "${config:buildroot_path}/output/build/duetscreen-HEAD/out/build/T113/DuetScreen",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Start gdbserver on DuetScreen",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "miDebuggerServerAddress": "${input:duetscreen_ip_address}:3000",
            "miDebuggerPath": "${config:buildroot_path}/output/host/bin/arm-none-linux-gnueabihf-gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set scheduler-locking",
                    "text": "set scheduler-locking on",
                    "ignoreFailures": false
                }
            ],
            "externalConsole": false,
            "sourceFileMap": {
                "${config:buildroot_path}/output/build/duetscreen-HEAD/src": "${workspaceFolder}/src",
                "${config:buildroot_path}/output/build/duetscreen-HEAD/libraries": "${workspaceFolder}/libraries"
            }
        },
        {
            "name": "Python: Filter Local Logs",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/filter_logs.py",
            "console": "integratedTerminal",
            "args": "${input:log_filters}"
        },
        {
            "name": "Python: Filter Remote Logs",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/filter_logs.py --remote ${input:duetscreen_ip_address}",
            "console": "integratedTerminal",
            "args": "${input:log_filters}"
        },
        {
            "name": "Python: Get Object Model Data",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/get_object_model_data.py",
            "console": "integratedTerminal",
            "args": [
                "--ip",
                "${input:duetscreen_ip_address}"
            ]
        },
        {
            "name": "Python: Run Tests",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/run_tests.py",
            "console": "integratedTerminal",
            "args": [
                "--test_filter",
                "${input:gtest_filter}",
                "--skip_configure"
            ]
        },
        {
            "name": "Python: LVGL Wrapper Generator",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/generate_lvgl_wrappers.py",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
            // "args": "--widgets tabview"
        }
    ],
}