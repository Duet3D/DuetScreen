{
	"version": "2.0.0",
	"inputs": [
		{
			"id": "test_filters",
			"type": "promptString",
			"description": "Test filters"
		},
		{
			"id": "lvgl_test_filters",
			"type": "promptString",
			"description": "Test filters"
		},
		{
			"id": "duetscreen_ip_address",
			"type": "promptString",
			"description": "IP address for DuetScreen"
		},
		{
			"id": "build_type",
			"type": "pickString",
			"description": "Build type for DuetScreen",
			"options": [
				"Release",
				"Release_with_profiling",
				"Debug",
			],
			"default": "Release"
		}
	],
	"tasks": [
		{
			"type": "cmake",
			"label": "CMake: configure",
			"command": "configure",
			"preset": "${command:cmake.activeConfigurePresetName}",
			"problemMatcher": [],
			"detail": "CMake template configure task",
			"group": "build"
		},
		{
			"type": "cmake",
			"label": "CMake: build",
			"command": "build",
			"targets": [
				"DuetScreen"
			],
			"preset": "${command:cmake.activeBuildPresetName}",
			"problemMatcher": [],
			"detail": "CMake template build task",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"dependsOn": []
		},
		{
			"type": "cmake",
			"label": "CMake: build tests",
			"command": "build",
			"targets": [
				"DuetScreen.tests"
			],
			"preset": "${command:cmake.activeBuildPresetName}",
			"problemMatcher": [],
			"detail": "CMake template build task",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"dependsOn": []
		},
		{
			"type": "shell",
			"label": "Clang Format",
			"command": "find src/ -iname '*.h' -o -iname '*.cpp' -print | xargs clang-format -i",
			"problemMatcher": [],
			"group": {
				"kind": "none",
				"isDefault": false
			}
		},
		{
			"type": "shell",
			"label": "LVGL Format",
			"command": "env/bin/python scripts/code-format.py",
			"options": {
				"cwd": "${workspaceFolder}/libraries/lvgl"
			},
			"problemMatcher": [],
			"group": {
				"kind": "none",
				"isDefault": false
			}
		},
		{
			"label": "Clean DuetScreen for Remote",
			"type": "shell",
			"command": "rm -rf output/build/duetscreen-HEAD; rm -rf dl/duetscreen",
			"args": [],
			"options": {
				"cwd": "${workspaceFolder}/${config:buildroot_path}"
			},
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"problemMatcher": [],
			"detail": "Cleans the DuetScreen build directory for remote debugging"
		},
		{
			"label": "Build DuetScreen for Remote",
			"type": "shell",
			"command": "echo \"Building ${input:build_type}...\"; make duetscreen-reconfigure",
			"args": [],
			"options": {
				"cwd": "${workspaceFolder}/${config:buildroot_path}",
				"env": {
					"DUETSCREEN_SRC": "${workspaceFolder}",
					"DUETSCREEN_PRESET": "T113-${input:build_type}",
					"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games:/snap/bin"
				}
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [
				"$gcc"
			],
			"detail": "Builds DuetScreen for remote debugging"
		},
		{
			"label": "Push DuetScreen - SSH",
			"type": "shell",
			"options": {
				"cwd": "${workspaceFolder}/${config:buildroot_path}",
				"shell": {
					"executable": "/bin/bash",
					"args": [
						"-i",
						"-c"
					]
				}
			},
			"command": "./scripts/push_duetscreen_ssh.sh ${input:duetscreen_ip_address}",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [],
			"detail": "Push the DuetScreen binary to the screen",
			"dependsOn": [
				"Build DuetScreen for Remote"
			],
			"runOptions": {
				"instanceLimit": 1
			}
		},
		{
			"label": "Push Assets - SSH",
			"type": "shell",
			"command": "ssh root@${input:duetscreen_ip_address} 'rm -rf /etc/assets; mkdir -p /etc/assets'; scp -r assets root@${input:duetscreen_ip_address}:/etc/",
			"options": {
				"shell": {
					"executable": "/bin/bash",
					"args": [
						"-i",
						"-c"
					]
				}
			},
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"problemMatcher": [],
			"detail": "Push the DuetScreen assets to the screen",
			"dependsOn": [],
			"runOptions": {
				"instanceLimit": 1
			}
		},
		{
			"label": "Push Libraries - SSH",
			"type": "shell",
			"options": {
				"cwd": "${workspaceFolder}/${config:buildroot_path}",
				"shell": {
					"executable": "/bin/bash",
					"args": [
						"-i",
						"-c"
					]
				}
			},
			"command": "scp output/target/usr/lib/*lvgl* root@${input:duetscreen_ip_address}:/usr/lib",
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"problemMatcher": [],
			"detail": "Push the DuetScreen libraries to the screen",
			"dependsOn": [],
			"runOptions": {
				"instanceLimit": 1
			}
		},
		{
			"label": "Start DuetScreen on remote",
			"type": "shell",
			"command": "ssh root@${input:duetscreen_ip_address} '/etc/init.d/S21DuetScreenMonitor stop; start-stop-daemon -K -n DuetScreen; /etc/init.d/20DuetScreen start'",
			"options": {
				"shell": {
					"executable": "/bin/bash",
					"args": [
						"-i",
						"-c"
					]
				}
			},
			"problemMatcher": [],
			"isBackground": true
		},
		{
			"label": "Start DuetScreenMonitor on remote",
			"type": "shell",
			"command": "ssh root@${input:duetscreen_ip_address} '/etc/init.d/S21DuetScreenMonitor stop; start-stop-daemon -K -n DuetScreen; /etc/init.d/S21DuetScreenMonitor start'",
			"options": {
				"shell": {
					"executable": "/bin/bash",
					"args": [
						"-i",
						"-c"
					]
				}
			},
			"problemMatcher": [],
			"isBackground": true
		},
		{
			"label": "Stop DuetScreen on remote",
			"type": "shell",
			"command": "ssh root@${input:duetscreen_ip_address} '/etc/init.d/S21DuetScreenMonitor stop; start-stop-daemon -K -n DuetScreen'",
			"options": {
				"shell": {
					"executable": "/bin/bash",
					"args": [
						"-i",
						"-c"
					]
				}
			},
			"problemMatcher": [],
			"isBackground": true
		},
		{
			"label": "Start gdbserver on DuetScreen",
			"type": "shell",
			"command": "ssh root@${input:duetscreen_ip_address} 'gdbserver :3000 DuetScreen'",
			"options": {
				"shell": {
					"executable": "/bin/bash",
					"args": [
						"-i",
						"-c"
					]
				}
			},
			"problemMatcher": [],
			"isBackground": true
		},
		{
			"label": "Upload config.json",
			"type": "shell",
			"command": "scp config.json root@${input:duetscreen_ip_address}:/etc/duetscreen.json",
			"options": {
				"shell": {
					"executable": "/bin/bash",
					"args": [
						"-i",
						"-c"
					]
				}
			},
			"problemMatcher": []
		},
		{
			"label": "Create update.tar.gz",
			"type": "shell",
			"command": "./scripts/create_upgrade.sh",
			"problemMatcher": [],
			"detail": "Create a tar.gz file for the update",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"dependsOn": [
				"Build DuetScreen for Remote - Release"
			]
		},
		{
			"label": "Print Release Notes",
			"type": "shell",
			"command": "./scripts/release_notes.sh",
			"problemMatcher": []
		},
		{
			"type": "cmake",
			"label": "CMake: configure Tests",
			"command": "configure",
			"preset": "Test",
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Run Tests",
			"type": "shell",
			"command": "env/bin/python scripts/run_tests.py --test_filter='${input:test_filters}' --skip_configure",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": {
				"kind": "test",
				"isDefault": false
			},
			"problemMatcher": []
		},
		{
			"label": "Run LVGL Tests",
			"type": "shell",
			"command": "env/bin/python scripts/run_tests.py --test_filter='${input:lvgl_test_filters}' --lvgl-tests",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": {
				"kind": "test",
				"isDefault": false
			},
			"problemMatcher": [],
			"dependsOn": [
				"LVGL Format"
			]
		},
		{
			"label": "Configure & Run Tests",
			"type": "shell",
			"command": "env/bin/python scripts/run_tests.py --test_filter='${input:test_filters}'",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": {
				"kind": "test",
				"isDefault": false
			},
			"problemMatcher": []
		},
		{
			"label": "Run Test Coverage",
			"type": "shell",
			"command": "env/bin/python scripts/run_tests.py --test_filter='${input:test_filters}' --coverage",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": {
				"kind": "test",
				"isDefault": false
			},
			"problemMatcher": []
		},
		{
			"label": "Verify i18n translations",
			"type": "shell",
			"command": "env/bin/python scripts/manage_translations.py",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		}
	]
}