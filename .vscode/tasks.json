{
	// Every task runs a script in scripts/; run one with --help to see what else it can do
	"version": "2.0.0",
	"inputs": [
		{
			"id": "test_filters",
			"type": "promptString",
			"description": "Test filter (a CTest regular expression, empty for all)"
		},
		{
			"id": "lvgl_test_filters",
			"type": "promptString",
			"description": "LVGL test suite (empty for all)"
		},
		{
			"id": "duetscreen_ip_address",
			"type": "command",
			"command": "extension.commandvariable.promptStringRemember",
			"args": {
				"key": "duetscreen_ip_address",
				"description": "IP address for DuetScreen"
			}
		},
		{
			"id": "build_type",
			"type": "pickString",
			"description": "Build type for DuetScreen",
			"options": [
				"Release",
				"Release_with_profiling",
				"Debug",
			],
			"default": "Release"
		},
		{
			// Resolves to build.py's option; the serial number is only prompted for when ON is picked
			"id": "hardware_test",
			"type": "command",
			"command": "extension.commandvariable.pickStringRemember",
			"args": {
				"description": "Build DuetScreen as a hardware test image?",
				"options": [
					["OFF", ""],
					["ON", "--hardware-test '${promptStringRemember:serial}'"]
				],
				"default": "",
				"promptStringRemember": {
					"serial": {
						"key": "hardware_test_serial",
						"description": "Hardware test serial number prefix",
						"default": "AD-04-01_"
					}
				}
			}
		}
	],
	"tasks": [
		{
			"label": "Build",
			"type": "shell",
			"command": "scripts/build.py ${command:cmake.activeConfigurePresetName}",
			"problemMatcher": ["$gcc"],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "Builds DuetScreen with the active CMake preset"
		},
		{
			"label": "Build Tests",
			"type": "shell",
			"command": "scripts/build.py ${command:cmake.activeConfigurePresetName} --target DuetScreen.tests",
			"problemMatcher": ["$gcc"],
			"group": "build",
			"detail": "Builds the tests with the active CMake preset"
		},
		{
			"label": "Clang Format",
			"type": "shell",
			"command": "scripts/format.py",
			"problemMatcher": []
		},
		{
			"label": "LVGL Format",
			"type": "shell",
			"command": "scripts/format.py --lvgl",
			"problemMatcher": []
		},
		{
			"label": "Build DuetScreen for Remote",
			"type": "shell",
			"command": "scripts/build.py T113-${input:build_type} --duet-simulator",
			"problemMatcher": ["$gcc"],
			"group": "build",
			"detail": "Builds DuetScreen for the screen with Buildroot, with the simulated Duet"
		},
		{
			"label": "Rebuild DuetScreen for Remote from Clean",
			"type": "shell",
			"command": "scripts/build.py T113-${input:build_type} --duet-simulator --clean",
			"problemMatcher": ["$gcc"],
			"group": "build",
			"detail": "Removes Buildroot's build of DuetScreen, then builds it again"
		},
		{
			"label": "Build Buildroot sdcard.img",
			"type": "shell",
			"command": "scripts/build.py T113-${input:build_type} --image ${input:hardware_test}",
			"problemMatcher": ["$gcc"],
			"group": "build",
			"detail": "Builds the screen's whole firmware with the local DuetScreen, as output/images/sdcard.img in Buildroot"
		},
		{
			"label": "Deploy DuetScreen - SSH",
			"type": "shell",
			"command": "scripts/build.py T113-${input:build_type} --duet-simulator --deploy ${input:duetscreen_ip_address}",
			"problemMatcher": ["$gcc"],
			"group": "build",
			"detail": "Builds DuetScreen for the screen, copies it and the assets to the screen, and restarts it",
			"runOptions": {
				"instanceLimit": 1
			}
		},
		{
			"label": "Push Assets - SSH",
			"type": "shell",
			"command": "scripts/screen.py ${input:duetscreen_ip_address} push assets",
			"problemMatcher": [],
			"detail": "Replaces the screen's assets with assets/, and restarts DuetScreen",
			"runOptions": {
				"instanceLimit": 1
			}
		},
		{
			"label": "Upload config.json",
			"type": "shell",
			"command": "scripts/screen.py ${input:duetscreen_ip_address} push config",
			"problemMatcher": []
		},
		{
			"label": "Start DuetScreen on remote",
			"type": "shell",
			"command": "scripts/screen.py ${input:duetscreen_ip_address} start --no-monitor",
			"problemMatcher": []
		},
		{
			"label": "Start DuetScreenMonitor on remote",
			"type": "shell",
			"command": "scripts/screen.py ${input:duetscreen_ip_address} start",
			"problemMatcher": []
		},
		{
			"label": "Stop DuetScreen on remote",
			"type": "shell",
			"command": "scripts/screen.py ${input:duetscreen_ip_address} stop",
			"problemMatcher": []
		},
		{
			"label": "Start gdbserver on DuetScreen",
			"type": "shell",
			"command": "scripts/screen.py ${input:duetscreen_ip_address} gdbserver",
			"problemMatcher": [],
			"isBackground": true
		},
		{
			"label": "Create update.tar.gz",
			"type": "shell",
			"command": "scripts/create_upgrade.py",
			"problemMatcher": [],
			"detail": "Makes out/DuetScreen.tar.gz from what Buildroot last built"
		},
		{
			"label": "Print Release Notes",
			"type": "shell",
			"command": "scripts/release_notes.py",
			"problemMatcher": []
		},
		{
			"label": "Run Tests",
			"type": "shell",
			"command": "scripts/run_tests.py --filter '${input:test_filters}' --skip-configure",
			"group": "test",
			"problemMatcher": []
		},
		{
			"label": "Run LVGL Tests",
			"type": "shell",
			"command": "scripts/run_tests.py --lvgl --filter '${input:lvgl_test_filters}'",
			"group": "test",
			"problemMatcher": []
		},
		{
			"label": "Configure & Run Tests",
			"type": "shell",
			"command": "scripts/run_tests.py --filter '${input:test_filters}'",
			"group": "test",
			"problemMatcher": []
		},
		{
			"label": "Run Test Coverage",
			"type": "shell",
			"command": "scripts/run_tests.py --filter '${input:test_filters}' --coverage",
			"group": "test",
			"problemMatcher": []
		},
		{
			"label": "Verify i18n translations",
			"type": "shell",
			"command": "scripts/manage_translations.py",
			"problemMatcher": []
		}
	]
}
