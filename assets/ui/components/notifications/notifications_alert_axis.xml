<!--
  One axis an M291 alert lets the user jog: three steps back, its position, three steps forward. The steps are
  disabled until the axis is homed.

  Fields:   an alert.axes row: label, homed (src/UI/Presenters/Notifications/NotificationsPresenter.h)
-->
<component>
	<view extends="lv_obj" width="100%" height="content" flex_flow="row" style_pad_all="2" style_pad_column="2"
		  style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center">
		<ds_button name="rel_move_1" text="-2" width="0%" height="content" flex_grow="1" style_text_align="center">
			<bind_state_if_eq subject="homed" state="disabled" ref_value="0"/>
			<action trigger="clicked" name="alert.jog" arg="-2"/>
		</ds_button>
		<ds_button name="rel_move_2" text="-0.2" width="0%" height="content" flex_grow="1" style_text_align="center">
			<bind_state_if_eq subject="homed" state="disabled" ref_value="0"/>
			<action trigger="clicked" name="alert.jog" arg="-0.2"/>
		</ds_button>
		<ds_button name="rel_move_3" text="-0.02" width="0%" height="content" flex_grow="1" style_text_align="center">
			<bind_state_if_eq subject="homed" state="disabled" ref_value="0"/>
			<action trigger="clicked" name="alert.jog" arg="-0.02"/>
		</ds_button>
		<lv_label name="label" bind_text="label" flex_grow="3" style_text_align="center"/>
		<ds_button name="rel_move_4" text="0.02" width="0%" height="content" flex_grow="1" style_text_align="center">
			<bind_state_if_eq subject="homed" state="disabled" ref_value="0"/>
			<action trigger="clicked" name="alert.jog" arg="0.02"/>
		</ds_button>
		<ds_button name="rel_move_5" text="0.2" width="0%" height="content" flex_grow="1" style_text_align="center">
			<bind_state_if_eq subject="homed" state="disabled" ref_value="0"/>
			<action trigger="clicked" name="alert.jog" arg="0.2"/>
		</ds_button>
		<ds_button name="rel_move_6" text="2" width="0%" height="content" flex_grow="1" style_text_align="center">
			<bind_state_if_eq subject="homed" state="disabled" ref_value="0"/>
			<action trigger="clicked" name="alert.jog" arg="2"/>
		</ds_button>
	</view>
</component>
