<!--
  A small status bar button showing an override (`value`, a subject such as move.speed_factor) that opens its dialog
  (`action`, e.g. factors.speed): the `status_speed` and `status_extrusion` widgets.
-->
<component>
	<api>
		<prop name="value" type="string" default="move.speed_factor"/>
		<prop name="action" type="string" default="actions.factors.speed"/>
		<prop name="icon" type="string" default=""/>
	</api>

	<view extends="lv_obj" width="content" height="content" scrollable="false">
		<style name="pad_zero"/>
		<ds_button name="button" bind_text="$value" width="content" height="content">
			<style name="pad_tiny"/>
			<action trigger="clicked" name="$action"/>
		</ds_button>
	</view>
</component>
