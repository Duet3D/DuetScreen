<!--
  A small status bar button that sends G-code (`gcode`), labelled `label`: the `status_gcode` widget
  (status_gcode.widget.json).
-->
<component>
	<api>
		<prop name="label" type="string" default=""/>
		<prop name="gcode" type="string" default=""/>
	</api>

	<view extends="lv_obj" width="content" height="content" scrollable="false">
		<style name="pad_zero"/>
		<ds_button name="button" text="$label" width="content" height="content">
			<style name="pad_tiny"/>
			<action trigger="clicked" name="gcode" arg="$gcode"/>
		</ds_button>
	</view>
</component>
