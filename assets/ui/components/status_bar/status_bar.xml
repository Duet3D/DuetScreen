<!--
  The status bar across the top of the screen: connection and state on the left, the printer's name in the middle,
  and on the right the status bar's buttons, then the current tool's temperatures. The buttons are the widgets of its
  layout (layouts/status_bar.json, none by default), which the user can change.

  The name is at most 40% wide and centred, and the right side (buttons and temperatures) at most 30% wide, so they
  never overlap. The temperatures are spans so the tool and the temperatures share a baseline whatever the theme's
  fonts.

  Data:     machine.summary, machine.name (src/UI/Xml/Data/MachineSource.h); current_tool.*
            (src/UI/Xml/Data/ToolSource.h)
-->
<component>
	<styles>
		<!-- While customising, the slot has room to be tapped, to add a button, even when it is empty -->
		<style name="slot_editing" min_width="80" min_height="24" border_color="#highlight" border_width="1"
			   border_opa="60%"/>
	</styles>

	<view extends="lv_obj" width="100%" height="content" scrollable="false">
		<lv_label name="status" bind_text="machine.summary" align="left_mid"/>

		<!-- Long names scroll -->
		<lv_label name="name" bind_text="machine.name" align="center" long_mode="scroll_circular"
				  style_max_width="40%" style_text_align="center"/>

		<lv_obj name="right" align="right_mid" width="content" height="content" style_max_width="30%"
				scrollable="false" flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center"
				style_pad_column="#pad_small">
			<style name="pad_zero"/>
			<ds_layout name="buttons" slot="status_bar" width="content" height="content" scrollable="false"
					   flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center"
					   style_pad_column="#pad_small">
				<style name="pad_zero"/>
				<bind_style_if_eq name="slot_editing" subject="customise.editing" ref_value="1"/>
			</ds_layout>

			<lv_spangroup name="temperatures" width="content" height="content" style_text_align="right">
				<bind_flag_if_eq subject="current_tool.shown" flag="hidden" ref_value="0"/>
				<bind_style_if_eq name="text_warning" subject="current_tool.fault" ref_value="1"/>
				<lv_spangroup-span bind_text="current_tool.label" style="text_emphasis"/>
				<lv_spangroup-span bind_text="current_tool.heaters"/>
			</lv_spangroup>
		</lv_obj>
	</view>
</component>
