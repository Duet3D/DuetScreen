<!--
  A value gauge's face: its name, then its value large in the middle, with a detail (the target, or the heater's
  state) below it.

  Fields:   a gauges row: name, detail (src/UI/Xml/Data/GaugeSource.h)
  Actions:  gauges.edit
-->
<component>
	<view extends="lv_obj" width="100%" height="100%" scrollable="false" flex_flow="column"
		  style_flex_cross_place="center" style_flex_track_place="center">
		<style name="pad_zero"/>
		<action trigger="clicked" name="actions.gauge.edit"/>

		<lv_label name="title" bind_text="name" width="100%" long_mode="scroll_circular" clickable="false">
			<style name="widget_title"/>
		</lv_label>
		<lv_obj name="readout" width="100%" flex_grow="1" flex_flow="column" style_flex_main_place="center"
				style_flex_cross_place="center" style_flex_track_place="center" clickable="false"
				scrollable="false">
			<style name="pad_zero"/>
			<gauge_reading name="reading"/>
			<lv_label name="detail" bind_text="detail" clickable="false">
				<style name="widget_detail"/>
			</lv_label>
		</lv_obj>
	</view>
</component>
