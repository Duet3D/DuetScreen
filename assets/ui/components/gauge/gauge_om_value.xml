<!--
  Any value the printer reports, by its object model path: the `om_value` widget (widgets/gauges/om_value.json).
  `path` is what follows `om.` in an object model name (docs/XML_UI_API.md, Object model), and gives text: a field, or
  a field through a converter that gives text, e.g. `state.upTime|duration` or `heat.heaters[1].current|fixed:1`.
  `label` names it; `unit` follows it.

  Data:     the object model (om.*)
-->
<component>
	<api>
		<prop name="path" type="string" default="state.upTime|duration"/>
		<prop name="label" type="string" default="Up time"/>
		<prop name="unit" type="string" default=""/>
	</api>

	<view extends="lv_obj" width="100%" height="100%" scrollable="false" flex_flow="column"
		  style_flex_cross_place="center" style_flex_track_place="center">
		<style name="card"/>
		<lv_label name="title" text="$label" width="100%" long_mode="scroll_circular">
			<style name="widget_title"/>
		</lv_label>
		<lv_obj name="readout" width="100%" flex_grow="1" flex_flow="row" style_flex_main_place="center"
				style_flex_cross_place="end" style_flex_track_place="center" scrollable="false">
			<style name="pad_zero"/>
			<lv_label name="value" bind_text="${path}">
				<style name="widget_value"/>
				<!-- The value is the widget's point, so it grows with the room there is -->
				<bind_style_if name="widget_value_large" cond="widget.size_class eq 1"/>
				<bind_style_if name="widget_value_huge" cond="widget.size_class eq 2"/>
			</lv_label>
			<lv_label name="unit" text="$unit" style_pad_bottom="3">
				<style name="widget_detail"/>
			</lv_label>
		</lv_obj>
	</view>
</component>
