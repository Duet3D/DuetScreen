<!--
  One value as a number: the `value_gauge` widget (widgets/gauges/value_gauge.json). `source` chooses the value, as for
  the arc gauge (gauge_arc.xml). Tap it to change the value, where that means something.

  Data:     the global gauges list (src/UI/Xml/Data/GaugeSource.h); Actions: gauges.edit
-->
<component>
	<api>
		<prop name="source" type="string" default="job.progress"/>
	</api>

	<view extends="lv_obj" width="100%" height="100%" scrollable="false">
		<style name="card"/>
		<ds_list name="list" list="gauges" key="id" value="$source" item="gauge_value_face" width="100%"
				 height="100%" scrollable="false" style_pad_all="0"/>
	</view>
</component>
