<!--
  One value on a bar: the `bar_gauge` widget (widgets/gauges/bar_gauge.json). `source` chooses the value, as for the
  arc gauge (gauge_arc.xml). Tap it to change the value, where that means something.

  Data:     the global source.gauge.gauges list (src/UI/Xml/Data/GaugeSource.h); Actions: actions.gauge.edit
-->
<component>
	<api>
		<prop name="source" type="string" default="bed.0"/>
	</api>

	<view extends="lv_obj" width="100%" height="100%" scrollable="false">
		<style name="card"/>
		<ds_list name="list" list="source.gauge.gauges" key="row.id" value="$source" item="gauge_bar_face" width="100%" height="100%"
				 scrollable="false" style_pad_all="0"/>
	</view>
</component>
