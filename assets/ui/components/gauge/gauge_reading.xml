<!--
  A gauge's value and its unit, e.g. "61.2 °C", larger the more room the widget has.

  Fields:   a gauges row: text, unit (src/UI/Xml/Data/GaugeSource.h); the placed widget's widget.size_class
-->
<component>
	<view extends="lv_obj" width="content" height="content" flex_flow="row" style_flex_cross_place="end"
		  clickable="false" scrollable="false">
		<style name="pad_zero"/>
		<lv_label name="value" bind_text="text">
			<style name="widget_value"/>
			<!-- The value is the gauge's point, so it grows with the room there is -->
			<bind_style_if name="widget_value_large" cond="widget.size_class eq 1"/>
			<bind_style_if name="widget_value_huge" cond="widget.size_class eq 2"/>
		</lv_label>
		<lv_label name="unit" bind_text="unit" style_pad_bottom="3">
			<style name="widget_detail"/>
		</lv_label>
	</view>
</component>
