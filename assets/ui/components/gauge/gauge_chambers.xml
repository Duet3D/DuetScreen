<!--
  A gauge for each chamber, or with `key`, the chambers whose key is `match` (one chamber): named for its heater's
  sensor, else "Chamber <n>". See gauge_heater_slots.xml.

  Props:    key, match, look, flow, grow, portrait  as gauge_list.xml
  Fields:   rows of om.heat.chamberHeaters
-->
<component>
	<api>
		<prop name="key" type="string" default=""/>
		<prop name="match" type="string" default=""/>
		<prop name="look" type="string" default="bar"/>
		<prop name="flow" type="string" default="column"/>
		<prop name="grow" type="string" default="1"/>
		<prop name="portrait" type="string" default="widget.portrait"/>
	</api>

	<view extends="gauge_heater_slots" list="om.heat.chamberHeaters" key="$key" match="$match" look="$look"
		  flow="$flow" grow="$grow" portrait="$portrait"
		  title="om.sensors.analog[{om.heat.heaters[{row.value}].sensor}].name|default:tr.temperature.chamber_number:{row.index}"/>
</component>
