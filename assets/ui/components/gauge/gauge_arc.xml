<!--
  An arc gauge: its title above, then the arc, with the target filled in muted colour under the value, coloured by
  `state`; the reading and the detail inside the arc.

  One of the gauge faces (gauge_bar, gauge_arc, gauge_value), which take the same props: see gauge_bar.xml, and
  Gauges in docs/XML_UI.md.
-->
<component>
	<api>
		<prop name="shown" type="string" default="1"/>
		<prop name="title" type="string" default="''"/>
		<prop name="value" type="string" default="0"/>
		<prop name="text" type="string" default="''"/>
		<prop name="unit" type="string" default="''"/>
		<prop name="min" type="string" default="0"/>
		<prop name="max" type="string" default="100"/>
		<prop name="target" type="string" default="0"/>
		<prop name="detail" type="string" default="''"/>
		<prop name="state" type="string" default="''"/>
		<prop name="grow" type="string" default="1"/>
		<prop name="portrait" type="string" default="widget.portrait"/>
		<prop name="frame" type="string" default="pad_zero"/>
		<prop name="tap_action" type="string" default=""/>
		<prop name="tap_arg" type="string" default=""/>
		<prop name="hold_action" type="string" default=""/>
		<prop name="hold_arg" type="string" default=""/>
	</api>

	<view extends="lv_obj" width="100%" height="100%" scrollable="false" flex_flow="column"
		  style_flex_cross_place="center" style_flex_track_place="center" style_min_width="110" style_min_height="110">
		<style name="pad_zero"/>
		<style name="$frame"/>
		<bind_flag_if cond="not (${shown})" flag="hidden"/>
		<action trigger="single_clicked" name="$tap_action" arg="$tap_arg"/>
		<action trigger="long_pressed" name="$hold_action" arg="$hold_arg"/>

		<lv_label name="title" bind_text="$title" width="100%" long_mode="scroll_circular" clickable="false">
			<style name="widget_title"/>
		</lv_label>

		<lv_obj name="dial" width="100%" flex_grow="1" scrollable="false" clickable="false">
			<style name="pad_zero"/>
			<ds_arc name="target" bind_value="$target" bind_min="$min" bind_max="$max" bg_start_angle="135"
					bg_end_angle="45" width="100%" height="100%" align="center">
				<style name="gauge_arc"/>
				<style name="gauge_arc_indic" selector="indicator"/>
				<style name="gauge_arc_target" selector="indicator"/>
				<bind_style_if_eq name="gauge_standby_target" subject="$state" ref_value="standby" selector="indicator"/>
			</ds_arc>
			<!-- Over the target, with no track of its own -->
			<ds_arc name="value" bind_value="$value" bind_min="$min" bind_max="$max" bg_start_angle="135"
					bg_end_angle="45" width="100%" height="100%" align="center" style_arc_opa="0">
				<style name="gauge_arc_indic" selector="indicator"/>
				<bind_style_if_eq name="gauge_standby" subject="$state" ref_value="standby" selector="indicator"/>
				<bind_style_if_eq name="gauge_off" subject="$state" ref_value="off" selector="indicator"/>
				<bind_style_if_eq name="gauge_fault" subject="$state" ref_value="fault" selector="indicator"/>
			</ds_arc>
			<lv_obj name="readout" width="content" height="content" align="center" flex_flow="column"
					style_flex_cross_place="center" style_flex_track_place="center" clickable="false"
					scrollable="false">
				<style name="pad_zero"/>
				<gauge_reading name="reading" text="$text" unit="$unit" grow="$grow"/>
				<lv_label name="detail" bind_text="$detail" clickable="false">
					<style name="widget_detail"/>
				</lv_label>
			</lv_obj>
		</lv_obj>
	</view>
</component>
