<!--
  One value on an arc: the `arc_gauge` widget (widgets/gauges/arc_gauge.json). `source` chooses the value, the id of a
  row of the global gauges list: a heater, a fan, the job's progress, … It shows nothing while the printer has no such
  value. Tap it to change the value, where that means something.

  Data:     the global gauges list (src/UI/Xml/Data/GaugeSource.h); Actions: gauges.edit
-->
<component>
	<api>
		<prop name="source" type="string" default="tool.0.0"/>
	</api>

	<view extends="lv_obj" width="100%" height="100%" scrollable="false">
		<style name="card"/>
		<ds_list name="list" list="gauges" key="id" value="$source" item="gauge_arc_face" width="100%" height="100%"
				 scrollable="false" style_pad_all="0"/>
	</view>
</component>
