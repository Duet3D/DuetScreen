<!--
  An arc gauge's face: its name above, then the arc, with the target filled in muted colour under the value, coloured
  by its heater's state; the value and a detail (the target, or the heater's state) inside the arc.

  Fields:   a gauges row: name, value, min, max, target, state, detail (src/UI/Xml/Data/GaugeSource.h)
  Actions:  gauges.edit
-->
<component>
	<view extends="lv_obj" width="100%" height="100%" scrollable="false" flex_flow="column"
		  style_flex_cross_place="center" style_flex_track_place="center">
		<style name="pad_zero"/>
		<action trigger="clicked" name="gauges.edit"/>

		<lv_label name="title" bind_text="name" width="100%" long_mode="dots" clickable="false">
			<style name="widget_title"/>
		</lv_label>

		<lv_obj name="dial" width="100%" flex_grow="1" scrollable="false" clickable="false">
			<style name="pad_zero"/>
			<ds_arc name="target" bind_value="target" bind_min="min" bind_max="max" bg_start_angle="135"
					bg_end_angle="45" width="100%" height="100%" align="center">
				<style name="gauge_arc"/>
				<style name="gauge_arc_indic" selector="indicator"/>
				<style name="gauge_arc_target" selector="indicator"/>
				<bind_style_if_eq name="gauge_standby_target" subject="state" ref_value="standby" selector="indicator"/>
			</ds_arc>
			<!-- Over the target, with no track of its own -->
			<ds_arc name="value" bind_value="value" bind_min="min" bind_max="max" bg_start_angle="135"
					bg_end_angle="45" width="100%" height="100%" align="center" style_arc_opa="0">
				<style name="gauge_arc_indic" selector="indicator"/>
				<bind_style_if_eq name="gauge_standby" subject="state" ref_value="standby" selector="indicator"/>
				<bind_style_if_eq name="gauge_off" subject="state" ref_value="off" selector="indicator"/>
				<bind_style_if_eq name="gauge_fault" subject="state" ref_value="fault" selector="indicator"/>
			</ds_arc>
			<lv_obj name="readout" width="content" height="content" align="center" flex_flow="column"
					style_flex_cross_place="center" style_flex_track_place="center" clickable="false"
					scrollable="false">
				<style name="pad_zero"/>
				<gauge_reading name="reading"/>
				<lv_label name="detail" bind_text="detail" clickable="false">
					<style name="widget_detail"/>
				</lv_label>
			</lv_obj>
		</lv_obj>
	</view>
</component>
