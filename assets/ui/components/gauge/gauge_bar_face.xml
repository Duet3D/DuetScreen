<!--
  A bar gauge's face: its name and value in a line above the bar, the target filled in muted colour under the value,
  coloured by its heater's state, and a detail (the target, or the heater's state) below. In a tall, narrow place the
  name goes above the value, and the bar stands up (LVGL draws a bar taller than it is wide upright).

  Fields:   a source.gauge.gauges row: row.name, row.value, row.min, row.max, row.target, row.state, row.detail (src/UI/Xml/Data/GaugeSource.h)
  Actions:  actions.gauge.edit
-->
<component>
	<styles>
		<!-- The name beside the value, or above it in a tall, narrow place. Styles rather than attributes, which
			 would win over them -->
		<style name="gauge_bar_beside" layout="flex" flex_flow="row" flex_main_place="space_between"
			   flex_cross_place="end"/>
		<style name="gauge_bar_stacked" layout="flex" flex_flow="column" flex_cross_place="start"/>
		<!-- Beside the value, the name takes what room is left (with a width, so a long one shortens rather than
			 widening) -->
		<style name="gauge_bar_title_beside" flex_grow="1" width="0"/>
		<style name="gauge_bar_title_stacked" width="100%"/>
	</styles>

	<view extends="lv_obj" width="100%" height="100%" scrollable="false" flex_flow="column">
		<style name="pad_zero"/>
		<action trigger="clicked" name="actions.gauge.edit"/>

		<lv_obj name="header" width="100%" height="content" clickable="false" scrollable="false">
			<style name="pad_zero"/>
			<!-- Too narrow for the name beside the value: one above the other -->
			<bind_style_if name="gauge_bar_beside" cond="not widget.portrait"/>
			<bind_style_if name="gauge_bar_stacked" cond="widget.portrait"/>
			<lv_label name="title" bind_text="row.name" long_mode="scroll_circular" clickable="false">
				<style name="widget_title"/>
				<bind_style_if name="gauge_bar_title_beside" cond="not widget.portrait"/>
				<bind_style_if name="gauge_bar_title_stacked" cond="widget.portrait"/>
			</lv_label>
			<gauge_reading name="reading"/>
		</lv_obj>

		<lv_obj name="track" width="100%" flex_grow="1" style_min_height="12" scrollable="false" clickable="false">
			<style name="pad_zero"/>
			<ds_bar name="target" bind_value="row.target" bind_min="row.min" bind_max="row.max" label_format="" width="100%"
					height="100%">
				<style name="gauge_bar"/>
				<style name="gauge_bar_indic" selector="indicator"/>
				<style name="gauge_bar_target" selector="indicator"/>
				<bind_style_if_eq name="gauge_standby_target" subject="row.state" ref_value="standby" selector="indicator"/>
			</ds_bar>
			<!-- Over the target, with no track of its own -->
			<ds_bar name="value" bind_value="row.value" bind_min="row.min" bind_max="row.max" label_format="" width="100%"
					height="100%" style_bg_opa="0">
				<style name="gauge_bar_indic" selector="indicator"/>
				<bind_style_if_eq name="gauge_standby" subject="row.state" ref_value="standby" selector="indicator"/>
				<bind_style_if_eq name="gauge_off" subject="row.state" ref_value="off" selector="indicator"/>
				<bind_style_if_eq name="gauge_fault" subject="row.state" ref_value="fault" selector="indicator"/>
			</ds_bar>
		</lv_obj>

		<lv_label name="detail" bind_text="row.detail" width="100%" long_mode="scroll_circular" clickable="false">
			<style name="widget_detail"/>
		</lv_label>
	</view>
</component>
