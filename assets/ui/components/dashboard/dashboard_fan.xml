<!--
  One fan, chosen by its number (`fan`), with its speed and buttons: the `fan` widget (widgets/fans/fan.json), the fan's
  card as the Fans page shows it. It shows nothing while the printer has no such fan.

  Data:     the global fans list (src/UI/Xml/Data/FanSource.h); Actions: fans.set_speed (the fans presenter)
-->
<component presenter="fans">
	<api>
		<prop name="fan" type="int" default="0"/>
	</api>

	<view extends="lv_obj" width="100%" height="100%" scrollable="false" flex_flow="column"
		  style_flex_main_place="center">
		<style name="pad_zero"/>
		<ds_list name="list" list="fans" key="number" value="$fan" item="fan_card" width="100%" height="content"/>
	</view>
</component>
