<!--
  The dashboard's tools widget (widgets/temperature/tools.json): the tools, beds and chambers, in the style its
  setting picks:

    - all equally (1): every tool's card, compact, then the beds' and chambers' heaters (tools_list.xml)
    - one, with the rest summarised (2): a column of tiles, one per tool (dashboard_tool_tile.xml), beside the card of
      the tool shown in detail, then the beds and chambers: the tool in use, until another's tile is tapped (tapping
      the tool in use's goes back); each scrolls on its own
    - automatic (0): all equally while every tool is a print head and they have four heater rows or fewer, else one
      with the rest summarised (source.tool.summary_auto)

  Tapping a tile shows a tool; Select, on its card, makes it the tool in use.

  Props:    style: 0 automatic, 1 all equally, 2 one with the rest summarised
  Data:     source.tool.* (src/UI/Xml/Data/ToolSource.h); om.tools
  Actions:  actions.tool.show (src/UI/Presenters/Control/Temperature/ToolActions.h); the cards'
-->
<component>
	<api>
		<prop name="style" type="int" default="0"/>
	</api>

	<view extends="lv_obj" width="100%" height="100%" flex_flow="column" scroll_dir="ver">
		<style name="card"/>
		<style name="pad_gap"/>

		<tools_list name="equal" compact="1">
			<bind_flag_if cond="${style} eq 2 or (${style} eq 0 and source.tool.summary_auto eq 1)" flag="hidden"/>
		</tools_list>

		<!-- The tiles in a column of their own, scrolling apart from the tool shown beside them -->
		<lv_obj name="summary" width="100%" height="100%" flex_flow="row" scrollable="false">
			<style name="pad_zero"/>
			<style name="pad_gap"/>
			<bind_flag_if cond="${style} eq 1 or (${style} eq 0 and source.tool.summary_auto eq 0)" flag="hidden"/>
			<ds_list name="tiles" list="source.tool.tiles" item="dashboard_tool_tile" width="30%" height="100%"
					 flex_flow="column" scroll_dir="ver" style_min_width="120" style_max_width="150" style_pad_all="0"
					 style_pad_row="8"/>
			<lv_obj name="detail" height="100%" flex_grow="1" flex_flow="column" scroll_dir="ver">
				<style name="pad_zero"/>
				<style name="pad_gap"/>
				<ds_list name="shown" list="om.tools" key="row.index" bind_value="source.tool.shown" item="tools_tool"
						 item.compact="1" width="100%" height="content" style_pad_all="0" scrollable="false"/>
				<tools_beds name="bed_chamber"/>
			</lv_obj>
		</lv_obj>
	</view>
</component>
