<!--
  The tools, beds and chambers, with their heaters' states and temperatures.

  Data:     the global tools, beds and chambers lists (src/UI/Xml/Data/ToolSource.h, HeatSource.h)
  Actions:  tools.toggle, heaters.toggle, heaters.set_active, heaters.set_standby
            (src/UI/Presenters/Control/Temperature/HeaterActions.h)

  Temperatures are typed on the shared number pad.
-->
<component>
	<view extends="lv_obj" flex_flow="column">
		<style name="pad_zero"/>

		<lv_obj name="tools" width="100%" height="content" flex_flow="column" style_pad_all="0">
			<ds_list name="list" list="tools" item="dashboard_tool" width="100%" height="content" flex_flow="column"
					 style_flex_main_place="start" style_flex_cross_place="start" style_flex_track_place="start"/>
		</lv_obj>

		<lv_obj name="beds" width="100%" height="content" flex_flow="column" style_pad_all="0">
			<ds_list name="list" list="beds" item="dashboard_heater_card" width="100%" height="content" flex_flow="column"
					 style_flex_main_place="start" style_flex_cross_place="start" style_flex_track_place="start"/>
		</lv_obj>

		<lv_obj name="chambers" width="100%" height="content" flex_flow="column" style_pad_all="0">
			<ds_list name="list" list="chambers" item="dashboard_heater_card" width="100%" height="content" flex_flow="column"
					 style_flex_main_place="start" style_flex_cross_place="start" style_flex_track_place="start"/>
		</lv_obj>
	</view>
</component>
