<!--
  The tools, beds and chambers, with their heaters' states and temperatures.

  Data:     the object model's om.tools, om.heat.bedHeaters and om.heat.chamberHeaters
  Actions:  actions.tool.toggle, actions.heater.toggle, actions.heater.set_active, actions.heater.set_standby
            (src/UI/Presenters/Control/Temperature/ToolActions.h, HeaterActions.h)

  Temperatures are typed on the shared number pad. `graph_key` (the widget's setting) shows each heater's colour key
  on the temperature graph.

  It is the dashboard's `tools` widget (widgets/temperature/tools.json), a card that fills the place it is given.
-->
<component>
	<api>
		<prop name="graph_key" type="bool" default="true"/>
	</api>

	<view extends="lv_obj" width="100%" height="100%" flex_flow="column">
		<style name="pad_zero"/>
		<style name="card"/>

		<lv_obj name="tools" width="100%" height="content" flex_flow="column" style_pad_all="0">
			<ds_list name="list" list="om.tools" item="dashboard_tool" item.graph_key="$graph_key" width="100%" height="content" flex_flow="column"
					 style_flex_main_place="start" style_flex_cross_place="start" style_flex_track_place="start"/>
		</lv_obj>

		<lv_obj name="beds" width="100%" height="content" flex_flow="column" style_pad_all="0">
			<ds_list name="list" list="om.heat.bedHeaters" item="dashboard_bed" item.graph_key="$graph_key" width="100%" height="content" flex_flow="column"
					 style_flex_main_place="start" style_flex_cross_place="start" style_flex_track_place="start"/>
		</lv_obj>

		<lv_obj name="chambers" width="100%" height="content" flex_flow="column" style_pad_all="0">
			<ds_list name="list" list="om.heat.chamberHeaters" item="dashboard_chamber" item.graph_key="$graph_key" width="100%" height="content" flex_flow="column"
					 style_flex_main_place="start" style_flex_cross_place="start" style_flex_track_place="start"/>
		</lv_obj>
	</view>
</component>
