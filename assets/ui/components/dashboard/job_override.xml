<!--
  One override of the running job, as the job status shows them (dashboard_job_status.xml): what it is, muted, over its
  value, as a box; tap it to change it in its shared dialog.

  Props:    title_tag   the translation key of what it is, e.g. `tr.job.speed`
            value       the name of its value, e.g. `source.move.speed_factor`
            tap_action  the action run when it is tapped, e.g. `actions.factors.speed`
            shown       an expression: it is hidden while this is false (default 1)
-->
<component>
	<api>
		<prop name="title_tag" type="string"/>
		<prop name="value" type="string"/>
		<prop name="tap_action" type="string"/>
		<prop name="shown" type="string" default="1"/>
	</api>
	<view extends="lv_obj" width="1" height="content" flex_grow="1" flex_flow="column" scrollable="false"
		  style_flex_cross_place="center" style_flex_track_place="center">
		<style name="btn"/>
		<style name="pressed" selector="pressed"/>
		<bind_flag_if cond="not (${shown})" flag="hidden"/>
		<action trigger="clicked" name="$tap_action"/>
		<lv_label name="title" translation_tag="$title_tag" clickable="false">
			<style name="text_muted"/>
		</lv_label>
		<lv_label name="value" bind_text="$value" clickable="false">
			<style name="text_emphasis"/>
		</lv_label>
	</view>
</component>
