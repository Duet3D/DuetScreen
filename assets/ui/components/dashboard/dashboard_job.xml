<!--
  The job, in a card: the `job` widget (widgets/jobs/job.json). Two pages: what is ready to start (job_ready.xml), and
  the job's status (dashboard_job_status.xml), which a job starting opens over it; once the job has ended, or while it
  runs, Back goes to the first. Which is shown is source.job.page, so every job widget shows the same. In a plain
  container because a placed widget's root can't be a DuetScreen widget (see XmlView.h).

  Props:    recent: how many of the newest jobs to offer; macros: how many macros
  Data:     source.job.page (src/UI/Xml/Data/JobSource.h)
-->
<component>
	<api>
		<prop name="recent" type="int" default="5"/>
		<prop name="macros" type="int" default="4"/>
	</api>

	<view extends="lv_obj" width="100%" height="100%" scrollable="false">
		<style name="card"/>
		<ds_pages name="pages" bind_page="source.job.page" width="100%" height="100%">
			<ds_pages-page name="ready" title_tag="tr.file.jobs">
				<ds_view name="job_ready" view="job_ready" shown="true" width="100%" height="100%"
						 prop_recent="$recent" prop_macros="$macros"/>
			</ds_pages-page>
			<ds_pages-page name="status" title_tag="tr.app_drawer.status">
				<ds_view name="dashboard_job_status" view="dashboard_job_status" shown="true" width="100%"
						 height="100%"/>
			</ds_pages-page>
		</ds_pages>
	</view>
</component>
