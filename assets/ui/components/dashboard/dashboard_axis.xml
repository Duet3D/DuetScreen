<!--
  One axis' position in the job status panel: its letter above its position.

  Fields:   a move.axes row: letter, position (src/UI/Xml/Data/MoveSource.h)
-->
<component>
	<view extends="lv_obj" width="content" height="content" flex_grow="1" style_min_width="content" scrollable="false"
		  flex_flow="column">
		<style name="bg_light"/>
		<style name="pad_zero"/>
		<lv_label bind_text="letter" width="100%" style_text_align="center"/>
		<lv_label bind_text="position" width="100%" style_text_align="center"/>
	</view>
</component>
