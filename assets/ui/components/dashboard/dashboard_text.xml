<!--
  Text the user writes: the `text` widget (widgets/text/text.json), in a theme font (`size`: small, normal, emphasis,
  header, large, xlarge or huge) and a palette colour (`colour`), aligned left, centre or right, on a card or on
  nothing (`background`: a theme style, card or base). The text wraps, and is centred top to bottom.
-->
<component>
	<api>
		<prop name="text" type="string" default=""/>
		<prop name="size" type="string" default="normal"/>
		<prop name="colour" type="string" default="text"/>
		<prop name="align" type="string" default="center"/>
		<prop name="background" type="string" default="card"/>
	</api>

	<view extends="lv_obj" width="100%" height="100%" flex_flow="column" style_flex_main_place="center">
		<style name="$background"/>
		<lv_label name="text" text="$text" width="100%" long_mode="wrap" style_text_font="font_${size}"
				  style_text_color="#${colour}" style_text_align="$align"/>
	</view>
</component>
