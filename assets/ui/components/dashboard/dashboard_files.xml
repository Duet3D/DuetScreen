<!--
  The jobs, macros and the job's status, as tabs: jobs (disabled while there is a job), macros, and the job's status,
  shown whenever a job starts. It is the `files` widget (widgets/jobs/files.json), in a plain container because a placed
  widget's root can't be a DuetScreen widget (see XmlView.h).
-->
<component>
	<view extends="lv_obj" width="100%" height="100%" scrollable="false">
		<style name="pad_zero"/>
		<ds_tabs name="tabs" width="100%" height="100%">
			<ds_tabs-tab name="jobs" title_tag="file.jobs" bind_disabled="machine.job_active">
				<ds_view name="dashboard_jobs" view="file_browser" presenter="dashboard_jobs" shown="true"/>
			</ds_tabs-tab>
			<ds_tabs-tab name="macros" title_tag="file.macros">
				<ds_view name="dashboard_macros" view="file_browser" presenter="dashboard_macros" shown="true"/>
			</ds_tabs-tab>
			<ds_tabs-tab name="status" title_tag="app_drawer.status" select_on="job.file">
				<ds_view name="dashboard_job_status" view="dashboard_job_status" shown="true"/>
			</ds_tabs-tab>
		</ds_tabs>
	</view>
</component>
