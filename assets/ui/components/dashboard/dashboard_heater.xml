<!--
  One heater: its name, its state (tap to cycle active, standby and off), its temperature, and its active and standby
  targets (tap to set). The state can't be changed while printing. In a widget less than wide (widget.*), the standby
  target isn't shown.

  Props:    label, active, standby: the names of its name and its targets, which a tool's heater and a bed's differ
            in (dashboard_tool_heater.xml, dashboard_heater_card.xml)
  Fields:   a row whose row.value is the heater number: its state and temperature are om.heat.heaters[{row.value}]
-->
<component>
	<api>
		<prop name="label" type="string"/>
		<prop name="active" type="string"/>
		<prop name="standby" type="string"/>
	</api>

	<view extends="lv_obj" width="100%" height="content" flex_flow="row" style_text_align="center"
		  style_flex_main_place="space_between" style_flex_cross_place="center" style_flex_track_place="center">
		<style name="tool_list_heater"/>

		<lv_label name="label" bind_text="$label" flex_grow="3" style_text_align="left"/>

		<ds_button name="status" bind_text="om.heat.heaters[{row.value}].state|translate:tr.temperature.status" flex_grow="3">
			<style name="border_color_card" selector="checked"/>
			<style name="action_btn"/>
			<bind_state_if_eq subject="source.machine.printing" state="disabled" ref_value="1"/>
			<action trigger="clicked" name="actions.heater.toggle"/>
		</ds_button>

		<lv_label name="current" bind_text="om.heat.heaters[{row.value}].current|fixed:1" flex_grow="2"/>

		<ds_button name="active" bind_text="$active" flex_grow="2">
			<style name="input"/>
			<action trigger="clicked" name="actions.heater.set_active"/>
		</ds_button>

		<ds_button name="standby" bind_text="$standby" flex_grow="2">
			<style name="input"/>
			<!-- The other columns need the room more, in all but a wide widget -->
			<bind_flag_if cond="widget.width_class lt 2" flag="hidden"/>
			<action trigger="clicked" name="actions.heater.set_standby"/>
		</ds_button>
	</view>
</component>
