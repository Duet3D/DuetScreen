<!--
  The dashboard, the home page: the tool list and temperature graph on the left, and the jobs, macros and print
  status tabs on the right.
-->
<component>
	<view extends="lv_obj" width="100%" height="100%" scrollable="false" style_pad_all="0"
		  style_layout="grid" style_grid_column_dsc_array="fr(3) fr(2)" style_grid_row_dsc_array="content fr(1)">
		<ds_view name="dashboard_tools" view="dashboard_tools" shown="true" height="content" style_max_height="50%"
				 style_grid_cell_x_align="stretch" style_grid_cell_column_pos="0" style_grid_cell_column_span="1"
				 style_grid_cell_y_align="start" style_grid_cell_row_pos="0" style_grid_cell_row_span="1">
			<style name="card"/>
		</ds_view>

		<!-- The last minute; the axis reaches at least 300°C, or the highest heater limit -->
		<ds_graph name="temperature_graph" history="temperatures" seconds="60"
				  y_min="0" y_max="300" bind_y_max="temperatures.limit"
				  style_grid_cell_x_align="stretch" style_grid_cell_column_pos="0" style_grid_cell_column_span="1"
				  style_grid_cell_y_align="stretch" style_grid_cell_row_pos="1" style_grid_cell_row_span="1">
			<style name="card"/>
		</ds_graph>

		<!-- Jobs (disabled while there is a job), macros, and the job's status, shown whenever a job starts -->
		<ds_tabs name="dashboard_tabs"
				 style_grid_cell_x_align="stretch" style_grid_cell_column_pos="1" style_grid_cell_column_span="1"
				 style_grid_cell_y_align="stretch" style_grid_cell_row_pos="0" style_grid_cell_row_span="2">
			<ds_tabs-tab name="jobs" title_tag="file.jobs" bind_disabled="machine.job_active">
				<ds_view name="dashboard_jobs" view="file_browser" presenter="dashboard_jobs" shown="true"/>
			</ds_tabs-tab>
			<ds_tabs-tab name="macros" title_tag="file.macros">
				<ds_view name="dashboard_macros" view="file_browser" presenter="dashboard_macros" shown="true"/>
			</ds_tabs-tab>
			<ds_tabs-tab name="status" title_tag="app_drawer.status" select_on="job.file">
				<ds_view name="dashboard_job_status" view="dashboard_job_status" shown="true"/>
			</ds_tabs-tab>
		</ds_tabs>
	</view>
</component>
