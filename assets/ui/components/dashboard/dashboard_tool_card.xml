<!--
  One tool, chosen by its number (`tool`), with its heaters: the `tool` widget (tool.widget.json). It shows nothing
  while the printer has no such tool.

  Data:     the global tools list (src/UI/Xml/Data/ToolSource.h)
  Actions:  tools.toggle, heaters.toggle, heaters.set_active, heaters.set_standby
            (src/UI/Presenters/Control/Temperature/HeaterActions.h)
-->
<component>
	<api>
		<prop name="tool" type="int" default="0"/>
	</api>

	<view extends="lv_obj" width="100%" height="100%" flex_flow="column">
		<style name="pad_zero"/>
		<style name="card"/>
		<ds_list name="list" list="tools" key="number" value="$tool" item="dashboard_tool" width="100%"
				 height="content"/>
	</view>
</component>
