<!--
  One tool, chosen by its number (`tool`), with its heaters: the `tool` widget (widgets/temperature/tool.json). It shows nothing
  while the printer has no such tool.

  Data:     the object model's om.tools
  Actions:  actions.tool.toggle, actions.heater.toggle, actions.heater.set_active, actions.heater.set_standby
            (src/UI/Presenters/Control/Temperature/ToolActions.h, HeaterActions.h)
-->
<component>
	<api>
		<prop name="tool" type="int" default="0"/>
	</api>

	<view extends="lv_obj" width="100%" height="100%" flex_flow="column">
		<style name="pad_zero"/>
		<style name="card"/>
		<ds_list name="list" list="om.tools" key="row.index" value="$tool" item="dashboard_tool" width="100%"
				 height="content"/>
	</view>
</component>
