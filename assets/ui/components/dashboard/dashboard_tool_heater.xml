<!--
  One of a tool's heaters in the tool list: a heater row (dashboard_heater.xml) named for its sensor, else "Heater
  <number>", with the tool's own targets for it.

  Props:    graph_key: whether its colour key shows (dashboard_heater.xml)
  Fields:   a row of a tool's om.tools[…].heaters: row.value (the heater number), row.index (its slot); the tool is the
            row around it (parent.active, parent.standby)
-->
<component>
	<api>
		<prop name="graph_key" type="bool" default="true"/>
	</api>

	<view extends="dashboard_heater" graph_key="$graph_key"
		  label="om.sensors.analog[{om.heat.heaters[{row.value}].sensor}].name|default:tr.temperature.heater:{row.value}"
		  active="parent.active[{row.index}]|int" standby="parent.standby[{row.index}]|int"/>
</component>
