<!--
  The current job's progress and times: the `job_progress` widget (widgets/jobs/job_progress.json).

  Data:     job.file, job.progress, job.elapsed, job.remaining (src/UI/Xml/Data/JobSource.h)
-->
<component>
	<view extends="lv_obj" width="100%" height="100%" flex_flow="column" style_flex_main_place="center">
		<style name="card"/>
		<lv_label name="file" bind_text="job.file" width="100%" long_mode="dots"/>
		<ds_bar name="progress" min="0" max="100" label_format="{}%" bind_value="job.progress" width="100%"
				height="content"/>
		<lv_obj name="times" width="100%" height="content" flex_flow="row" style_flex_main_place="space_between">
			<style name="pad_zero"/>
			<lv_label name="elapsed" bind_text="job.elapsed"/>
			<lv_label name="remaining" bind_text="job.remaining"/>
		</lv_obj>
	</view>
</component>
