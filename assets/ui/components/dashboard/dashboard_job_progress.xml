<!--
  The current job's progress and times: the `job_progress` widget (widgets/jobs/job_progress.json). The file is its
  title, on one line (scrolling by, if it is too long), then the progress, then the time taken and the time left.

  Data:     the job's file, om.job.file.fileName; job.progress, job.elapsed, job.remaining (src/UI/Xml/Data/JobSource.h)
-->
<component>
	<view extends="lv_obj" width="100%" height="100%" scrollable="false" flex_flow="column"
		  style_flex_main_place="space_between">
		<style name="card"/>
		<lv_label name="file" bind_text="om.job.file.fileName" width="100%" long_mode="scroll_circular">
			<style name="widget_title"/>
		</lv_label>
		<ds_bar name="progress" min="0" max="100" label_format="{}%" bind_value="job.progress" width="100%"
				height="content"/>
		<lv_obj name="times" width="100%" height="content" flex_flow="row" style_flex_main_place="space_between"
				scrollable="false">
			<style name="pad_zero"/>
			<lv_label name="elapsed" bind_text="job.elapsed">
				<style name="widget_detail"/>
			</lv_label>
			<lv_label name="remaining" bind_text="job.remaining">
				<style name="widget_detail"/>
			</lv_label>
		</lv_obj>
	</view>
</component>
