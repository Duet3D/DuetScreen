<!--
  What is ready to start, the `job` widget's first page (dashboard_job.xml): while a job runs, it, tapped to see its
  status; else the last job, to print again; every job, newest first, in a list that fills the room left and scrolls,
  each tapped to ask whether to start it (the dialog says
  why not while a job runs); and the macros, each tapped to ask whether to run it. All files opens the Files page's jobs; the refresh
  button lists the files again (they are also listed again on coming back to the dashboard and when a job ends).

  Props:    macros: how many macros to show
  Data:     source.job.* (src/UI/Xml/Data/JobSource.h): the job, how the last ended and its thumbnail;
            source.files.* (src/UI/Xml/Data/FilesSource.h): the newest jobs and the macros;
            source.machine.job_active (src/UI/Xml/Data/MachineSource.h): whether a job runs
  Actions:  job.print_again (global: src/UI/Presenters/Dashboard/JobActions.h), files.ask_start, files.ask_run and
            files.refresh (global: src/UI/Presenters/FileBrowser/FilesActions.h), navigation.open, open_page
  It has no presenter: everything it shows and does is global.
-->
<component>
	<api>
		<prop name="macros" type="int" default="4"/>
	</api>

	<!-- Its scrollbar runs clear of the rows, in the room on the right -->
	<view extends="lv_obj" width="100%" height="100%" flex_flow="column" scroll_dir="ver" style_pad_row="12"
		  style_pad_right="14">
		<style name="pad_zero"/>

		<!-- What the machine is ready for, and every file -->
		<lv_obj name="header" width="100%" height="content" flex_flow="row" scrollable="false"
				style_flex_cross_place="center" style_flex_track_place="center" style_pad_all="0">
			<lv_label name="ready_print" translation_tag="tr.job.ready_print" flex_grow="1" long_mode="dots">
				<style name="text_header"/>
				<bind_flag_if cond="om.state.machineMode|eq:CNC or om.state.machineMode|eq:Laser" flag="hidden"/>
			</lv_label>
			<lv_label name="ready" translation_tag="tr.job.ready" flex_grow="1" long_mode="dots">
				<style name="text_header"/>
				<bind_flag_if cond="om.state.machineMode|eq:CNC eq 0 and om.state.machineMode|eq:Laser eq 0" flag="hidden"/>
			</lv_label>
			<ds_button name="refresh" text="&#xF021;" width="content" height="content" style_pad_hor="12"
					   style_pad_ver="8" style_margin_right="8">
				<action trigger="clicked" name="actions.files.refresh"/>
			</ds_button>
			<lv_obj name="all_files" width="content" height="content" flex_flow="row" scrollable="false"
					style_flex_cross_place="center" style_flex_track_place="center" style_pad_hor="12"
					style_pad_ver="8" style_pad_column="8">
				<style name="btn"/>
				<style name="pressed" selector="pressed"/>
				<action trigger="clicked" name="actions.navigation.open" arg="files/jobs"/>
				<lv_label name="text" translation_tag="tr.job.all_files" clickable="false"/>
				<lv_label name="chevron" text="&#xF054;" clickable="false">
					<style name="text_muted"/>
				</lv_label>
			</lv_obj>
		</lv_obj>

		<!-- The job, while it runs: tapped, its status -->
		<ds_setting_group name="now" title_tag="tr.job.current_job" width="100%">
			<bind_flag_if_eq subject="source.machine.job_active" flag="hidden" ref_value="0"/>
			<lv_obj name="current" height="content" flex_flow="row" scrollable="false" style_flex_cross_place="center"
					style_flex_track_place="center">
				<style name="setting_row"/>
				<style name="pressed" selector="pressed"/>
				<action trigger="clicked" name="actions.navigation.open_page" arg="status"/>
				<lv_obj name="picture" width="40" height="40" flex_flow="row" scrollable="false" clickable="false"
						style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center"
						style_pad_all="0" style_bg_opa="0" style_border_width="0">
					<ds_thumbnail name="thumbnail" bind_src="source.job.thumbnail" inner_align="contain" height="100%"
								  style_max_width="100%"/>
				</lv_obj>
				<lv_obj name="about" width="1" height="content" flex_grow="1" flex_flow="column" scrollable="false"
						clickable="false" style_pad_all="0" style_bg_opa="0" style_border_width="0">
					<lv_label name="name" bind_text="source.job.name" width="100%" long_mode="dots">
						<style name="setting_title"/>
					</lv_label>
					<lv_obj name="detail" width="100%" height="content" flex_flow="row" scrollable="false"
							clickable="false" style_pad_all="0" style_pad_column="6" style_bg_opa="0"
							style_border_width="0">
						<lv_label name="state" bind_text="source.job.state">
							<style name="setting_hint"/>
						</lv_label>
						<lv_label name="progress" bind_text="source.job.progress" bind_text-fmt="· %d%%">
							<style name="setting_hint"/>
						</lv_label>
					</lv_obj>
				</lv_obj>
				<lv_label name="chevron" text="&#xF054;">
					<style name="text_muted"/>
				</lv_label>
			</lv_obj>
		</ds_setting_group>

		<!-- The last job, while there is one and none runs -->
		<ds_setting_group name="last" title_tag="tr.job.last_job" width="100%">
			<bind_flag_if_eq subject="source.job.print_again_control" flag="hidden" ref_value="0"/>
			<lv_obj name="last_job" height="content" flex_flow="row" scrollable="false" style_flex_cross_place="center"
					style_flex_track_place="center">
				<style name="setting_row"/>
				<!-- No larger than 88 x 88; the room it keeps when there is no thumbnail lines the rows up -->
				<lv_obj name="picture" width="88" height="88" flex_flow="row" scrollable="false" clickable="false"
						style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center"
						style_pad_all="0" style_bg_opa="0" style_border_width="0">
					<ds_thumbnail name="thumbnail" bind_src="source.job.thumbnail" inner_align="contain" height="100%"
								  style_max_width="100%"/>
				</lv_obj>
				<lv_obj name="about" width="1" height="content" flex_grow="1" flex_flow="column" scrollable="false"
						clickable="false" style_pad_all="0" style_pad_row="4" style_bg_opa="0" style_border_width="0">
					<lv_label name="name" bind_text="source.job.name" width="100%" long_mode="dots">
						<style name="setting_title"/>
					</lv_label>
					<lv_label name="detail" bind_text="source.job.last_detail" width="100%">
						<style name="setting_hint"/>
					</lv_label>
					<ds_button name="print_again" translation_tag="tr.status.print_again" height="content"
							   style_min_width="content" style_margin_top="6">
						<style name="action_btn"/>
						<bind_state_if_not_eq subject="source.job.print_again_control" state="disabled" ref_value="2"/>
						<action trigger="clicked" name="actions.job.print_again"/>
					</ds_button>
				</lv_obj>
			</lv_obj>
		</ds_setting_group>

		<!-- Every job, newest first, filling the room the rest leaves (at least two rows' worth), scrolling on its own;
			 only the rows on screen are built -->
		<ds_setting_group name="recent" title_tag="tr.job.recent" width="100%" height="1" flex_grow="1" fill="true"
						  style_min_height="100">
			<bind_flag_if_eq subject="source.files.recent_count" flag="hidden" ref_value="0"/>
			<ds_list name="list" list="source.files.recent" item="job_recent_row" windowed="true" item_height="58"
					 width="100%" height="100%" scroll_dir="ver">
				<style name="setting_list"/>
			</ds_list>
		</ds_setting_group>

		<!-- The first macros, two to a line -->
		<ds_setting_group name="macros" title_tag="tr.job.macros" width="100%">
			<bind_flag_if_eq subject="source.files.macro_count" flag="hidden" ref_value="0"/>
			<ds_list name="list" list="source.files.macros" item="job_macro" flow="row_wrap" limit="$macros"
					 width="100%" height="content" style_pad_row="8" style_pad_column="8">
				<style name="setting_row"/>
			</ds_list>
		</ds_setting_group>
	</view>
</component>
