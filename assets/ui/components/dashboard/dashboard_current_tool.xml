<!--
  The tool in use, with its heaters (and, with `graph_key`, their colour keys on the temperature graph): the `current_tool` widget (widgets/temperature/current_tool.json). Says so when
  there is none.

  Data:     the object model: state.currentTool, and that tool (dashboard_current_tool_card.xml)
-->
<component>
	<api>
		<prop name="graph_key" type="bool" default="true"/>
	</api>

	<view extends="lv_obj" width="100%" height="100%" flex_flow="column">
		<style name="card"/>
		<lv_label name="no_tool" translation_tag="tr.widget.no_tool">
			<style name="widget_detail"/>
			<bind_flag_if cond="om.state.currentTool|exists eq 1 and om.state.currentTool|int ge 0" flag="hidden"/>
		</lv_label>
		<ds_scope name="tool" path="om.tools[{om.state.currentTool}]" item="dashboard_current_tool_card" item.graph_key="$graph_key" width="100%"
				  height="content">
			<style name="pad_zero"/>
			<bind_flag_if cond="om.state.currentTool|exists eq 0 or om.state.currentTool|int lt 0" flag="hidden"/>
		</ds_scope>
	</view>
</component>
