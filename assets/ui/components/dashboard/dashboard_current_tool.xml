<!--
  The tool in use, as the Control page's Tools tab shows it, compact (tools_tool.xml): the `current_tool` widget
  (widgets/temperature/current_tool.json). Says so when there is none.

  Data:     the object model: state.currentTool, and that tool
-->
<component>
	<view extends="lv_obj" width="100%" height="100%" flex_flow="column" scroll_dir="ver">
		<style name="card"/>
		<lv_label name="no_tool" translation_tag="tr.widget.no_tool">
			<style name="widget_detail"/>
			<bind_flag_if cond="om.state.currentTool|exists eq 1 and om.state.currentTool|int ge 0" flag="hidden"/>
		</lv_label>
		<ds_list name="list" list="om.tools" key="row.index" bind_value="om.state.currentTool|int" item="tools_tool"
				 item.compact="1" width="100%" height="content" style_pad_all="0" scrollable="false"/>
	</view>
</component>
