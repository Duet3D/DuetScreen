<!--
  A bed or chamber in the tool list: one heater row (dashboard_heater.xml) in a card, named for its heater's sensor,
  else "<label_tag> <number>". A slot without a heater (-1) isn't shown.

  Props:    label_tag  the translation of its name when its sensor has none, with the number in it
                       (dashboard_bed.xml, dashboard_chamber.xml)
  Fields:   a row of om.heat.bedHeaters or om.heat.chamberHeaters: row.index (its number), row.value (its heater)
-->
<component>
	<api>
		<prop name="label_tag" type="string"/>
	</api>

	<view extends="lv_obj" width="100%" height="content" flex_flow="column">
		<style name="tool_list_tool"/>
		<style name="tool_selected" selector="checked"/>
		<bind_flag_if cond="row.value|int lt 0" flag="hidden"/>

		<lv_obj name="heaters" width="100%" height="content" flex_flow="column" style_pad_all="0">
			<lv_obj name="list" width="100%" height="content" flex_flow="column" style_pad_all="0"
					style_flex_main_place="start" style_flex_cross_place="start" style_flex_track_place="start">
				<dashboard_heater name="0"
								  label="om.sensors.analog[{om.heat.heaters[{row.value}].sensor}].name|default:${label_tag}:{row.index}"
								  active="om.heat.heaters[{row.value}].active|int"
								  standby="om.heat.heaters[{row.value}].standby|int"/>
			</lv_obj>
		</lv_obj>
	</view>
</component>
