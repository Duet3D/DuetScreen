<!--
  One extruder of a tool on the Temperature tab: its extrusion factor. Tap to change the tool's factors.

  Fields:   an extruders row: factor (src/UI/Screens/Temperature/TemperaturePresenter.h)
-->
<component>
	<view extends="ds_button" bind_text="factor" width="content" height="content">
		<action trigger="clicked" name="factors.extrusion"/>
	</view>
</component>
