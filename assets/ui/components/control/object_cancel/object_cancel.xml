<!--
  The Object Cancel tab: the job's objects drawn on the bed and listed, the one being printed named above the bed,
  and a button to cancel it. Tapping an object cancels it, or resumes it if cancelled, after asking. Cancel Current
  Object only asks if confirmations are on, and stands out when it won't.

  Fields and actions: src/UI/Screens/ObjectCancel/ObjectCancelPresenter.h
-->
<component presenter="object_cancel">
	<view extends="lv_obj" width="100%" height="100%" style_layout="grid"
		  style_grid_column_dsc_array="fr(2) fr(1)" style_grid_row_dsc_array="fr(1) content">
		<style name="bg_dark"/>

		<ds_plot name="object_canvas" title_tag="object_cancel.current_object_prefix" title_style="text_emphasis"
				 bind_detail="current_object" bind_x_min="x_min" bind_x_max="x_max" bind_y_min="y_min"
				 bind_y_max="y_max" style_pad_right="20"
				 style_grid_cell_column_pos="0" style_grid_cell_x_align="stretch"
				 style_grid_cell_row_pos="0" style_grid_cell_row_span="2" style_grid_cell_y_align="stretch">
			<style name="card"/>
			<style name="pad_base"/>
			<ds_plot_layer name="objects_layer">
				<ds_list name="objects" list="objects" item="job_object_rect" width="100%" height="100%"
						 style_pad_all="0" scrollable="false"/>
			</ds_plot_layer>
		</ds_plot>

		<lv_obj name="object_list" flex_flow="column"
				style_grid_cell_column_pos="1" style_grid_cell_x_align="stretch"
				style_grid_cell_row_pos="0" style_grid_cell_y_align="stretch">
			<style name="card"/>
			<lv_obj name="header" width="100%" height="content" style_min_width="content" flex_flow="row"
					style_flex_main_place="start" style_flex_cross_place="center" style_flex_track_place="center">
				<style name="bg_color_header"/>
				<style name="list_header"/>
				<lv_label name="title" translation_tag="object_cancel.objects_header" width="content" height="content">
					<style name="list_title"/>
				</lv_label>
			</lv_obj>
			<ds_list name="list" list="objects" item="job_object_item" width="100%" flex_grow="1" flex_flow="column"
					 style_flex_main_place="start" style_flex_cross_place="start" style_flex_track_place="start"/>
		</lv_obj>

		<ds_button name="cancel_current" translation_tag="object_cancel.cancel_current" width="100%" height="50"
				   style_min_height="content"
				   style_grid_cell_column_pos="1" style_grid_cell_x_align="stretch"
				   style_grid_cell_row_pos="1" style_grid_cell_y_align="start">
			<bind_style name="actionBtn" subject="confirmations" ref_value="0"/>
			<action trigger="clicked" name="object_cancel.cancel_current"/>
		</ds_button>

		<question_dialog name="confirm_object_cancel" open="confirm" title="confirm_title" text="confirm_text"
						 confirm="object_cancel.confirm" close="object_cancel.close_dialog"/>
	</view>
</component>
