<!--
  One fan, a row of <ds_list list="om.fans">: off, its speed, and full speed. In a widget less than wide (widget.*), only
  its speed. Names are the fan's (om.fans[N]): name, requestedValue, thermostatic…; `index` is the fan number.
-->
<component>
	<view extends="lv_obj" width="100%" height="content"
		  flex_flow="row" style_flex_main_place="start" style_flex_cross_place="center" style_flex_track_place="center">
		<style name="card"/>

		<!-- Temperature-controlled fans can't be set by hand, and a gap in the fan numbers has no fan -->
		<bind_flag_if cond="thermostatic.lowTemperature|exists eq 1 or exists eq 0" flag="hidden"/>

		<ds_button name="off" translation_tag="fan.off" width="60" height="100%" style_min_width="content">
			<!-- The slider needs the room more, in all but a wide widget -->
			<bind_flag_if cond="widget.width_class lt 2" flag="hidden"/>
			<action trigger="clicked" name="fans.set_speed" arg="0"/>
		</ds_button>

		<ds_slider name="slider" bind_label="name|default:fine_tune.fan" bind_value="requestedValue|percent" min="0"
				   max="100" numberpad="true"
				   flex_grow="1" width="100%" height="content" style_pad_all="5">
			<style name="no_border"/>
			<action trigger="value_confirmed" name="fans.set_speed"/>
		</ds_slider>

		<ds_button name="max" translation_tag="fan.max" width="60" height="100%" style_min_width="content">
			<!-- The slider needs the room more, in all but a wide widget -->
			<bind_flag_if cond="widget.width_class lt 2" flag="hidden"/>
			<action trigger="clicked" name="fans.set_speed" arg="100"/>
		</ds_button>
	</view>
</component>
