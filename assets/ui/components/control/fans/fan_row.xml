<!--
  One fan, a row of <ds_list list="om.fans">: its name, then its speed. A fan you set has a slider (tap its value to
  type one) with Off and Max beside it, which a narrow widget leaves out. A fan the firmware runs by temperature
  (thermostatic) says so, and when it comes on, and shows its speed as a reading. A gap in the fan numbers has no fan.

  Fields:   a row of om.fans: row.index (the fan number), row.name, row.requestedValue, row.actualValue,
            row.thermostatic.lowTemperature
  Actions:  actions.fan.set_speed (src/UI/Presenters/Control/Fans/FanActions.h)
-->
<component>
	<!-- Where there isn't room for the slider beside the name, it goes under it, as wide as the row -->
	<view extends="lv_obj" height="content" flex_flow="row_wrap" scrollable="false"
		  style_flex_cross_place="center" style_flex_track_place="center">
		<style name="setting_row"/>
		<bind_flag_if_eq subject="row.exists" flag="hidden" ref_value="0"/>

		<lv_obj name="titles" height="content" flex_grow="1" style_min_width="140" flex_flow="column"
				scrollable="false">
			<style name="pad_zero"/>
			<lv_label name="title" bind_text="row.name|default:tr.fan.header:{row.index}" width="100%"
					  long_mode="dots">
				<style name="setting_title"/>
			</lv_label>
			<lv_label name="hint" bind_text="row.thermostatic.lowTemperature|format:tr.fan.automatic" width="100%">
				<style name="setting_hint"/>
				<bind_flag_if cond="row.thermostatic.lowTemperature|exists eq 0" flag="hidden"/>
			</lv_label>
		</lv_obj>

		<!-- Set by hand -->
		<lv_obj name="controls" width="62%" height="content" flex_grow="1" style_min_width="280" flex_flow="row"
				scrollable="false"
				style_flex_cross_place="center" style_flex_track_place="center">
			<style name="pad_zero"/>
			<style name="pad_gap"/>
			<bind_flag_if cond="row.thermostatic.lowTemperature|exists eq 1" flag="hidden"/>
			<ds_button name="off" translation_tag="tr.fan.off" height="content" style_min_height="40"
					   style_min_width="content">
				<!-- The slider needs the room more, in all but a wide widget -->
				<bind_flag_if cond="widget.width_class lt 2" flag="hidden"/>
				<action trigger="clicked" name="actions.fan.set_speed" arg="0"/>
			</ds_button>
			<ds_slider name="slider" bind_value="row.requestedValue|percent" min="0" max="100" numberpad="true"
					   flex_grow="1" height="content" style_pad_all="0">
				<style name="no_border"/>
				<action trigger="value_confirmed" name="actions.fan.set_speed"/>
			</ds_slider>
			<ds_button name="max" translation_tag="tr.fan.max" height="content" style_min_height="40"
					   style_min_width="content">
				<bind_flag_if cond="widget.width_class lt 2" flag="hidden"/>
				<action trigger="clicked" name="actions.fan.set_speed" arg="100"/>
			</ds_button>
		</lv_obj>

		<!-- Run by temperature: its speed, a percentage -->
		<lv_obj name="reading" width="content" height="content" flex_flow="row" scrollable="false"
				style_flex_cross_place="end" style_flex_track_place="end">
			<style name="pad_zero"/>
			<bind_flag_if cond="row.thermostatic.lowTemperature|exists eq 0" flag="hidden"/>
			<lv_label name="value" bind_text="row.actualValue|percent">
				<style name="reading"/>
			</lv_label>
			<lv_label name="unit" text=" %">
				<style name="text_muted"/>
			</lv_label>
		</lv_obj>
	</view>
</component>
