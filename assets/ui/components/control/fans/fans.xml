<!--
  The Fans tab, and the `fans` widget: a row per fan (fan_row.xml), in one group. A fan you set has a slider; a fan
  the firmware runs by temperature shows its speed.

  Data:     the object model's fans (om.fans). Each fan_row binds to its own fan's fields.
  Actions:  actions.fan.set_speed (src/UI/Presenters/Control/Fans/FanActions.h)
-->
<component>
	<view extends="lv_obj" width="100%" height="100%" flex_flow="column" scroll_dir="ver">
		<style name="bg_dark"/>
		<style name="card"/>
		<ds_setting_group name="fans" title_tag="tr.fan.title" width="100%">
			<ds_list name="list" list="om.fans" item="fan_row">
				<style name="setting_list"/>
			</ds_list>
		</ds_setting_group>
	</view>
</component>
