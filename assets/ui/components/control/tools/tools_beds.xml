<!--
  The beds' and chambers' heaters, a row each (tools_slot_heater.xml), in a group shown while there is one: under the tools
  on the Control page's Tools tab (tools_list.xml) and in the dashboard's tools widget (dashboard_tools.xml).

  Data:     om.heat.bedHeaters, om.heat.chamberHeaters
-->
<component>
	<api>
		<!-- An expression: lower and less padded rows, where room is short (heater_row.xml) -->
		<prop name="compact" type="string" default="0"/>
	</api>
	<view extends="ds_setting_group" title_tag="tr.tools.bed_and_chamber" width="100%">
		<!-- A heater number of -1 is none -->
		<bind_flag_if cond="om.heat.bedHeaters|count_at_least:0 lt 1 and om.heat.chamberHeaters|count_at_least:0 lt 1"
					  flag="hidden"/>
		<ds_list name="beds" list="om.heat.bedHeaters" item="tools_slot_heater"
				 item.label_tag="tr.temperature.bed_number" item.compact="$compact">
			<style name="setting_list"/>
		</ds_list>
		<ds_list name="chambers" list="om.heat.chamberHeaters" item="tools_slot_heater"
				 item.label_tag="tr.temperature.chamber_number" item.compact="$compact">
			<style name="setting_list"/>
		</ds_list>
	</view>
</component>
