<!--
  One of the tool in use's extruders on the Tools tab (tools_current.xml): its extrusion factor as a value and a thin
  bar from 0 to 200%, so 100% is halfway. Tap it to open the extrusion factor dialog for the tool.

  Fields:   a row of the tool's om.tools[…].extruders: row.value (the extruder number); its factor is
            om.move.extruders[{row.value}].factor
  Actions:  actions.factors.extrusion (src/UI/Presenters/Modals/FactorsActions.h)
-->
<component>
	<view extends="lv_obj" height="content" flex_flow="column" scrollable="false" style_pad_row="8">
		<style name="setting_row"/>
		<style name="pressed" selector="pressed"/>
		<action trigger="clicked" name="actions.factors.extrusion" arg="{om.state.currentTool}"/>
		<lv_obj name="line" width="100%" height="content" flex_flow="row" scrollable="false" clickable="false"
				style_flex_cross_place="center" style_flex_track_place="center" style_pad_all="0">
			<lv_label name="label" bind_text="row.value|format:tr.fine_tune.extruder" flex_grow="1" long_mode="dots">
				<style name="setting_title"/>
			</lv_label>
			<lv_label name="value" bind_text="om.move.extruders[{row.value}].factor|percent" bind_text-fmt="%d%%">
				<style name="reading"/>
			</lv_label>
		</lv_obj>
		<ds_bar name="bar" bind_value="om.move.extruders[{row.value}].factor|percent" min="0" max="200"
				label_format="" width="100%" height="4" clickable="false">
			<style name="gauge_bar"/>
			<style name="gauge_bar_indic" selector="indicator"/>
		</ds_bar>
	</view>
</component>
