<!--
  One tool, as a card: its name, then "In use" and Deselect, or Select; a row per heater (tools_tool_heater.xml); its
  filament, if it takes any (tap to choose one to load); and the speed it starts its spindle at, if it has one (− and
  + step it; tap it to type it), on a printer's tool too. Outlined while it is the tool in use. A gap in the tools (a
  null item) isn't shown. `compact` leaves out the filament and spindle rows. Nothing that would change the job can be
  pressed while printing.

  Props:    compact  an expression, e.g. from tools_list.xml
  Fields:   a row of om.tools: row.index (the tool number), row.name, row.state, row.heaters, row.filamentExtruder,
            row.spindle, row.spindleRpm
  Actions:  actions.tool.toggle, actions.filament.*, actions.spindle.set_rpm/slower/faster
            (src/UI/Presenters/Control/Temperature/)
-->
<component>
	<api>
		<!-- An expression: lower rows, without the filament and spindle rows, as the dashboard has -->
		<prop name="compact" type="string" default="0"/>
	</api>
	<view extends="lv_obj" width="100%" height="content" scrollable="false">
		<style name="setting_group"/>
		<style name="tool_selected" selector="checked"/>
		<bind_flag_if_eq subject="row.exists" flag="hidden" ref_value="0"/>
		<bind_state_if_eq subject="row.state|eq:active" state="checked" ref_value="1"/>

		<lv_obj name="header" height="content" flex_flow="row" scrollable="false"
				style_flex_cross_place="center" style_flex_track_place="center">
			<style name="setting_row"/>
			<bind_style_if name="setting_row_compact" cond="${compact}"/>
			<lv_label name="name" bind_text="row.name|default:tr.temperature.default_tool_name:{row.index}"
					  flex_grow="1" long_mode="dots">
				<style name="text_header"/>
			</lv_label>
			<lv_label name="in_use" translation_tag="tr.tools.in_use">
				<style name="chip"/>
				<style name="chip_accent"/>
				<bind_flag_if_eq subject="row.state|eq:active" flag="hidden" ref_value="0"/>
			</lv_label>
			<ds_button name="deselect" translation_tag="tr.tools.deselect" height="content" style_min_height="36">
				<bind_flag_if_eq subject="row.state|eq:active" flag="hidden" ref_value="0"/>
				<bind_state_if_eq subject="source.machine.printing" state="disabled" ref_value="1"/>
				<action trigger="clicked" name="actions.tool.toggle" arg="{row.index}"/>
			</ds_button>
			<ds_button name="select" translation_tag="tr.tools.select" height="content" style_min_height="36">
				<bind_flag_if_eq subject="row.state|eq:active" flag="hidden" ref_value="1"/>
				<bind_state_if_eq subject="source.machine.printing" state="disabled" ref_value="1"/>
				<action trigger="clicked" name="actions.tool.toggle" arg="{row.index}"/>
			</ds_button>
		</lv_obj>

		<ds_list name="heaters" list="row.heaters" item="tools_tool_heater" item.compact="$compact">
			<style name="setting_list"/>
		</ds_list>

		<ds_setting name="filament" title_tag="tr.tools.filament">
			<bind_flag_if cond="(${compact}) or row.filamentExtruder|int lt 0" flag="hidden"/>
			<ds_button name="choose"
					   bind_text="om.move.extruders[{row.filamentExtruder}].filament|default:tr.filament.not_loaded"
					   height="content" style_min_height="36">
				<bind_state_if_eq subject="source.machine.printing" state="disabled" ref_value="1"/>
				<action trigger="clicked" name="actions.filament.choose" arg="{row.index}"/>
			</ds_button>
			<ds_button name="unload" translation_tag="tr.filament.unload" height="content" style_min_height="36">
				<bind_state_if_eq subject="source.machine.printing" state="disabled" ref_value="1"/>
				<action trigger="clicked" name="actions.filament.unload" arg="{row.index}"/>
			</ds_button>
		</ds_setting>

		<!-- The speed it starts its spindle at: − and + step it, tap it to type it -->
		<ds_setting name="spindle" title_tag="tr.spindle.speed" hint_tag="tr.spindle.speed_hint">
			<bind_flag_if cond="(${compact}) or row.spindle|int lt 0" flag="hidden"/>
			<ds_button name="slower" text="−" width="48" height="content" style_min_height="40">
				<action trigger="clicked" name="actions.spindle.slower" arg="{row.index}"/>
			</ds_button>
			<ds_button name="speed" bind_text="row.spindleRpm|format:tr.units.rpm" height="content"
					   style_min_height="40" style_min_width="110">
				<action trigger="clicked" name="actions.spindle.set_rpm" arg="{row.index}"/>
			</ds_button>
			<ds_button name="faster" text="+" width="48" height="content" style_min_height="40">
				<action trigger="clicked" name="actions.spindle.faster" arg="{row.index}"/>
			</ds_button>
		</ds_setting>
	</view>
</component>
