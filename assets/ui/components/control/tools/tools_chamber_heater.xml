<!--
  A chamber's heater, as a row (heater_row.xml), named for its sensor, else "Chamber <number>", with the heater's own
  targets.

  Fields:   a row of om.heat.chamberHeaters: row.value (the heater number, -1 for none), row.index (the chamber's
            number)
-->
<component>
	<api>
		<!-- An expression: lower and less padded, where room is short (heater_row.xml) -->
		<prop name="compact" type="string" default="0"/>
	</api>
	<view extends="heater_row" compact="$compact"
		  label="om.sensors.analog[{om.heat.heaters[{row.value}].sensor}].name|default:tr.temperature.chamber_number:{row.index}"
		  active="om.heat.heaters[{row.value}].active|format:tr.units.degrees"
		  standby="om.heat.heaters[{row.value}].standby|format:tr.units.degrees"/>
</component>
