<!--
  A bed's or a chamber's heater, as a row (heater_row.xml), named for its sensor, else "<label_tag> <number>", with
  the heater's own targets (tools_beds.xml lists them).

  Props:    label_tag  the translation of its name when its sensor has none, with the number in it, e.g.
                       tr.temperature.bed_number
            compact    an expression: lower and less padded, where room is short (heater_row.xml)
  Fields:   a row of om.heat.bedHeaters or chamberHeaters: row.value (the heater number, -1 for none), row.index (the
            bed's or chamber's number)
-->
<component>
	<api>
		<prop name="label_tag" type="string" default="tr.temperature.bed_number"/>
		<prop name="compact" type="string" default="0"/>
	</api>
	<view extends="heater_row" compact="$compact"
		  label="om.sensors.analog[{om.heat.heaters[{row.value}].sensor}].name|default:${label_tag}:{row.index}"
		  active="om.heat.heaters[{row.value}].active|format:tr.units.degrees"
		  standby="om.heat.heaters[{row.value}].standby|format:tr.units.degrees"/>
</component>
