<!--
  The Bed mesh tab, and the `heightmap` widget. On the left, the mesh shown, with its colour scale. On the right:
  probing the bed (G29) and levelling it (G32); the meshes saved on the printer (tap one to show it, Load to use it);
  how values are coloured; and the shown mesh's statistics, in the displayed unit.

  Fields and actions: src/UI/Presenters/Control/Heightmap/HeightmapPresenter.h
-->
<component presenter="heightmap">
	<view extends="lv_obj" width="100%" height="100%" flex_flow="row" scrollable="false">
		<style name="bg_dark"/>
		<ds_heatmap name="heightmap" bind_surface="presenter.surface" bind_title="presenter.title" height="100%"
					flex_grow="1">
			<style name="card"/>
		</ds_heatmap>

		<lv_obj name="side" width="34%" height="100%" flex_flow="column" scroll_dir="ver" style_min_width="240">
			<style name="card"/>
			<style name="pad_gap"/>
			<ds_setting_group name="probe" title_tag="tr.heightmap.probe_group" width="100%">
				<ds_setting name="probe_bed" title_tag="tr.heightmap.probe_bed" hint_tag="tr.heightmap.probe_bed_hint">
					<ds_button name="mesh_bed_level" translation_tag="tr.heightmap.probe">
						<style name="action_btn"/>
						<bind_state_if_eq subject="presenter.levelling_usable" state="disabled" ref_value="0"/>
						<action trigger="clicked" name="actions.gcode.send" arg="G29"/>
					</ds_button>
				</ds_setting>
				<ds_setting name="level_bed" title_tag="tr.heightmap.level_bed" hint_tag="tr.heightmap.level_bed_hint">
					<ds_button name="true_bed_level" translation_tag="tr.heightmap.level">
						<bind_state_if_eq subject="presenter.levelling_usable" state="disabled" ref_value="0"/>
						<action trigger="clicked" name="actions.gcode.send" arg="G32"/>
					</ds_button>
				</ds_setting>
			</ds_setting_group>

			<ds_setting_group name="saved" title_tag="tr.heightmap.saved" width="100%">
				<ds_list name="list" list="presenter.maps" item="heightmap_file">
					<style name="setting_list"/>
				</ds_list>
				<lv_obj name="no_maps" height="content" scrollable="false">
					<style name="setting_row"/>
					<bind_flag_if_eq subject="presenter.has_maps" flag="hidden" ref_value="1"/>
					<lv_label name="text" translation_tag="tr.heightmap.no_maps" width="100%">
						<style name="setting_hint"/>
					</lv_label>
				</lv_obj>
			</ds_setting_group>

			<ds_setting_group name="colours" title_tag="tr.heightmap.colours" width="100%">
				<!-- The choice goes under the text: the column is too narrow for both on a line -->
				<ds_setting name="scale" title_tag="tr.heightmap.scale" hint_tag="tr.heightmap.scale_hint"
							flex_flow="row_wrap">
					<lv_obj name="options" width="100%">
						<style name="setting_options"/>
						<ds_button name="heightmap_fixed" translation_tag="tr.heightmap.fixed" flex_grow="1">
							<style name="setting_option"/>
							<bind_state_if_eq subject="presenter.mode" state="checked" ref_value="0"/>
							<action trigger="clicked" name="presenter.heightmap.mode" arg="fixed"/>
						</ds_button>
						<ds_button name="heightmap_auto" translation_tag="tr.heightmap.auto" flex_grow="1">
							<style name="setting_option"/>
							<bind_state_if_eq subject="presenter.mode" state="checked" ref_value="1"/>
							<action trigger="clicked" name="presenter.heightmap.mode" arg="auto"/>
						</ds_button>
					</lv_obj>
				</ds_setting>
			</ds_setting_group>

			<!-- A label and its value a line each, so the statistics take little room -->
			<ds_setting_group name="statistics" title_tag="tr.heightmap.last_probe" width="100%">
				<lv_obj name="table" height="content" scrollable="false" style_layout="grid"
						style_grid_column_dsc_array="fr(1) content"
						style_grid_row_dsc_array="content content content content content content"
						style_pad_row="4">
					<style name="setting_row"/>
					<lv_label name="num_points_title" translation_tag="tr.heightmap.points" style_grid_cell_column_pos="0" style_grid_cell_row_pos="0">
						<style name="setting_hint"/>
					</lv_label>
					<lv_label name="num_points" bind_text="presenter.stats.points" style_grid_cell_column_pos="1" style_grid_cell_row_pos="0"
							  style_grid_cell_x_align="end"/>
					<lv_label name="area_title" translation_tag="tr.heightmap.area_title" style_grid_cell_column_pos="0" style_grid_cell_row_pos="1">
						<style name="setting_hint"/>
					</lv_label>
					<lv_label name="area" bind_text="presenter.stats.area" style_grid_cell_column_pos="1" style_grid_cell_row_pos="1"
							  style_grid_cell_x_align="end"/>
					<lv_label name="min_error_title" translation_tag="tr.heightmap.lowest" style_grid_cell_column_pos="0" style_grid_cell_row_pos="2">
						<style name="setting_hint"/>
					</lv_label>
					<lv_label name="min_error" bind_text="presenter.stats.min" style_grid_cell_column_pos="1" style_grid_cell_row_pos="2"
							  style_grid_cell_x_align="end"/>
					<lv_label name="max_error_title" translation_tag="tr.heightmap.highest" style_grid_cell_column_pos="0" style_grid_cell_row_pos="3">
						<style name="setting_hint"/>
					</lv_label>
					<lv_label name="max_error" bind_text="presenter.stats.max" style_grid_cell_column_pos="1" style_grid_cell_row_pos="3"
							  style_grid_cell_x_align="end"/>
					<lv_label name="mean_error_title" translation_tag="tr.heightmap.mean" style_grid_cell_column_pos="0" style_grid_cell_row_pos="4">
						<style name="setting_hint"/>
					</lv_label>
					<lv_label name="mean_error" bind_text="presenter.stats.mean" style_grid_cell_column_pos="1" style_grid_cell_row_pos="4"
							  style_grid_cell_x_align="end"/>
					<lv_label name="std_dev_title" translation_tag="tr.heightmap.rms" style_grid_cell_column_pos="0" style_grid_cell_row_pos="5">
						<style name="setting_hint"/>
					</lv_label>
					<lv_label name="std_dev" bind_text="presenter.stats.rms" style_grid_cell_column_pos="1" style_grid_cell_row_pos="5"
							  style_grid_cell_x_align="end"/>
				</lv_obj>
			</ds_setting_group>
		</lv_obj>
	</view>
</component>
