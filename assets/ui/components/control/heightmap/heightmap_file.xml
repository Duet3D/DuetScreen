<!--
  One height map file on the printer, as a row: its name (tap to show it), and Load, or Unload for the one the
  printer is using, which is marked as a chosen option is.

  Fields:   a presenter.maps row: row.name, row.loaded, row.load_text (HeightmapPresenter.h)
  Actions:  presenter.heightmap.show, presenter.heightmap.toggle
-->
<component>
	<view extends="lv_obj" height="content" flex_flow="row" scrollable="false"
		  style_flex_cross_place="center" style_flex_track_place="center">
		<style name="setting_row"/>
		<style name="pressed" selector="pressed"/>
		<style name="btn_checked" selector="checked"/>
		<bind_state_if_eq subject="row.loaded" state="checked" ref_value="1"/>
		<action trigger="clicked" name="presenter.heightmap.show"/>

		<lv_label name="label" bind_text="row.name" flex_grow="1" long_mode="dots" clickable="false">
			<style name="setting_title"/>
		</lv_label>
		<ds_button name="load" bind_text="row.load_text" height="content" style_min_width="content">
			<style name="action_btn"/>
			<bind_state_if_eq subject="row.loaded" state="checked" ref_value="1"/>
			<action trigger="clicked" name="presenter.heightmap.toggle"/>
		</ds_button>
	</view>
</component>
