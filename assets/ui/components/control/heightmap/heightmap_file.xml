<!--
  One height map file on the Bed Levelling tab: tap it to show it; Load (or Unload) makes the printer use it (or stop).
  Highlighted while the printer is using it.

  Fields and actions: a maps row (src/UI/Screens/Heightmap/HeightmapPresenter.h)
-->
<component>
	<view extends="lv_obj" width="100%" height="content" flex_flow="row"
		  style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center">
		<style name="bg_color_primary" selector="checked"/>
		<bind_state_if_eq subject="loaded" state="checked" ref_value="1"/>
		<action trigger="clicked" name="heightmap.show"/>

		<lv_label name="label" bind_text="name" height="content" flex_grow="1"/>
		<ds_button name="load" bind_text="load_text" width="70" height="content" style_min_width="content">
			<style name="action_btn"/>
			<bind_state_if_eq subject="loaded" state="checked" ref_value="1"/>
			<action trigger="clicked" name="heightmap.toggle"/>
		</ds_button>
	</view>
</component>
