<!--
  Z on its own, in a card: the `jog_z` widget (widgets/motion/jog_z.json), Z's column from the Move tab. It jogs by
  the distance and speed chosen in any view (the global source.jog.*).

  Data:     source.axes.z.plus_usable, minus_usable (src/UI/Xml/Data/AxesSource.h), source.machine.connected
  Actions:  actions.move.jog (src/UI/Presenters/Control/Move/MoveActions.h)
-->
<component>
	<view extends="lv_obj" width="100%" height="100%" scrollable="false" flex_flow="row"
		  style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center">
		<style name="card"/>
		<bind_state_if_eq subject="source.machine.connected" state="disabled" ref_value="0"/>
		<move_axis name="z_control" letter="'Z'" axis="source.axes.z" plus="Z+" minus="Z-"
				   height="100%"/>
	</view>
</component>
