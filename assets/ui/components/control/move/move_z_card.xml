<!--
  Z on its own, in a card: the `jog_z` widget (widgets/motion/jog_z.json). It jogs by the distance and speed chosen in
  any view (the global source.jog.*), and asks before homing as the Move tab does.

  Fields and actions: src/UI/Presenters/Control/Move/MovePresenter.h
-->
<component presenter="move">
	<view extends="lv_obj" width="100%" height="100%" scrollable="false">
		<style name="card"/>
		<style name="pad_zero"/>
		<bind_state_if_eq subject="presenter.connected" state="disabled" ref_value="0"/>
		<move_z name="z_control" width="100%" height="100%"/>
		<question_dialog name="confirm_msgbox" open="presenter.confirm" title="presenter.confirm_title" text="presenter.confirm_text"
						 confirm="presenter.move.confirm" close="presenter.move.close_dialog"/>
	</view>
</component>
