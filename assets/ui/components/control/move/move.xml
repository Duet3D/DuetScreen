<!--
  The Move tab. On the left: every axis' position (tap one to move to a position), X and Y on a pad and every other
  axis in a column, then the jog step and speed. On the right: homing; the Z offset on a printer, or work zero on a
  CNC; and the speed factor, which scales jogging too.

  Data:     source.axes.* (src/UI/Xml/Data/AxesSource.h), source.jog.* (src/UI/Xml/Data/JogSource.h),
            source.machine.connected, om.state.machineMode
  Actions:  actions.move.* (src/UI/Presenters/Control/Move/MoveActions.h); the pieces' own
-->
<component>
	<view extends="lv_obj" width="100%" height="100%" flex_flow="row" scrollable="false">
		<style name="bg_dark"/>

		<lv_obj name="jog_card" height="100%" flex_grow="1" flex_flow="column" scrollable="false">
			<style name="card"/>
			<bind_state_if_eq subject="source.machine.connected" state="disabled" ref_value="0"/>

			<move_positions name="positions" width="100%"/>

			<!-- X and Y on a pad, then a column for Z and each other axis. The spacers centre them while they fit;
				 when there are more than fit, they take no room, so the row starts at its left and scrolls sideways -->
			<lv_obj name="jog" width="100%" flex_grow="1" flex_flow="row" scroll_dir="hor"
					style_flex_cross_place="center" style_flex_track_place="center">
				<style name="pad_zero"/>
				<style name="pad_gap"/>
				<lv_obj name="start_spacer" width="0" height="1" flex_grow="1" clickable="false">
					<style name="pad_zero"/>
				</lv_obj>
				<!-- As tall as there is room for, at most 240 -->
				<move_xy name="xy_control" width="240" height="100%" style_max_height="240"/>
				<ds_list name="columns" list="source.axes.columns" item="move_axis" width="content" height="100%"
						 style_max_height="240" flex_flow="row" style_pad_all="0" style_pad_column="10"
						 scrollable="false"/>
				<lv_obj name="end_spacer" width="0" height="1" flex_grow="1" clickable="false">
					<style name="pad_zero"/>
				</lv_obj>
			</lv_obj>

			<move_jog_choices name="jog_choices" width="100%"/>
		</lv_obj>

		<lv_obj name="side" width="30%" height="100%" flex_flow="column" scroll_dir="ver">
			<style name="card"/>
			<style name="pad_gap"/>
			<move_homing name="homing"/>
			<!-- A printer's Z offset; a CNC's work zero -->
			<lv_obj name="z_offset" width="100%" height="content" scrollable="false">
				<style name="pad_zero"/>
				<bind_flag_if_eq subject="om.state.machineMode|eq:CNC" flag="hidden" ref_value="1"/>
				<ds_setting_group name="group" title_tag="tr.move.z_offset" width="100%">
					<lv_obj name="row" height="content" scrollable="false">
						<style name="setting_row"/>
						<babystep name="babystep" hide_title="true" width="100%" height="content"/>
					</lv_obj>
				</ds_setting_group>
			</lv_obj>
			<move_work_zero name="work_zero">
				<bind_flag_if_eq subject="om.state.machineMode|eq:CNC" flag="hidden" ref_value="0"/>
			</move_work_zero>
			<lv_obj flex_grow="1"/>
			<move_overrides name="overrides"/>
		</lv_obj>
	</view>
</component>
