<!--
  Every axis' position, a tile each, side by side, on as many rows as they need. Tap one to move to a position.

  Data:     the global source.axes.all (src/UI/Xml/Data/AxesSource.h)
-->
<component>
	<view extends="lv_obj" width="100%" height="content" scrollable="false">
		<style name="pad_zero"/>
		<ds_list name="list" list="source.axes.all" item="move_position" width="100%" height="content"
				 flex_flow="row_wrap" style_pad_all="0" style_pad_row="#pad" style_pad_column="#pad"
				 scrollable="false"/>
	</view>
</component>
