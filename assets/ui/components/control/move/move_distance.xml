<!--
  One jog distance choice. Tap to use it; hold to change it.

  Fields:   a source.jog.distances row: row.text, row.selected (src/UI/Xml/Data/JogSource.h); actions: JogActions.h
-->
<component>
	<view extends="ds_button" bind_text="row.text" height="100%" flex_grow="1" style_min_height="content">
		<style name="long_press"/>
		<bind_state_if_eq subject="row.selected" state="checked" ref_value="1"/>
		<action trigger="clicked" name="actions.jog.distance"/>
		<action trigger="long_pressed" name="actions.jog.edit_distance"/>
	</view>
</component>
