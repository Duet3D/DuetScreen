<!--
  One axis jogged in a column: forwards, its letter, backwards. Z, and any axis other than X and Y, has one.

  Fields:   a source.axes.columns row: row.letter, row.jog_usable (src/UI/Xml/Data/AxesSource.h)
  Actions:  actions.move.jog (src/UI/Presenters/Control/Move/MoveActions.h)
-->
<component>
	<view extends="lv_obj" width="72" height="100%" flex_flow="column" scrollable="false"
		  style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center">
		<style name="pad_zero"/>
		<style name="pad_gap"/>
		<ds_button name="increment" icon="arrow_up.png" text="+" width="100%" flex_grow="1">
			<style name="action_btn"/>
			<bind_state_if_eq subject="row.jog_usable" state="disabled" ref_value="0"/>
			<action trigger="clicked" name="actions.move.jog" arg="+"/>
		</ds_button>
		<lv_label name="letter" bind_text="row.letter" width="100%" flex_grow="1" style_text_align="center">
			<style name="axis_tile_position"/>
		</lv_label>
		<ds_button name="decrement" icon="arrow_down.png" text="−" width="100%" flex_grow="1">
			<style name="action_btn"/>
			<bind_state_if_eq subject="row.jog_usable" state="disabled" ref_value="0"/>
			<action trigger="clicked" name="actions.move.jog" arg="-"/>
		</ds_button>
	</view>
</component>
