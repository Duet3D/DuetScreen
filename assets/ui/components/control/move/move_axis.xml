<!--
  One axis jogged in a column: forwards, its letter, backwards. Z has one, and so does the axis chosen from the others.

      <move_axis letter="'Z'" usable="source.axes.z.jog_usable" plus="Z+" minus="Z-"/>

  Props:    letter  its letter, a subject's or a constant ('Z')
            usable  an int subject: 1 while it can be jogged
            plus, minus  the args of actions.move.jog that jog it each way, e.g. Z+ and Z-, or other+ and other-
  Actions:  actions.move.jog (src/UI/Presenters/Control/Move/MoveActions.h)
-->
<component>
	<api>
		<prop name="letter" type="string"/>
		<prop name="usable" type="string"/>
		<prop name="plus" type="string"/>
		<prop name="minus" type="string"/>
	</api>
	<view extends="lv_obj" width="72" height="100%" flex_flow="column" scrollable="false"
		  style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center">
		<style name="pad_zero"/>
		<style name="pad_gap"/>
		<ds_button name="increment" icon="arrow_up.png" text="+" width="100%" flex_grow="1">
			<style name="action_btn"/>
			<bind_state_if_eq subject="$usable" state="disabled" ref_value="0"/>
			<action trigger="clicked" name="actions.move.jog" arg="$plus"/>
		</ds_button>
		<lv_label name="letter" bind_text="$letter" width="100%" flex_grow="1" style_text_align="center">
			<style name="reading"/>
		</lv_label>
		<ds_button name="decrement" icon="arrow_down.png" text="−" width="100%" flex_grow="1">
			<style name="action_btn"/>
			<bind_state_if_eq subject="$usable" state="disabled" ref_value="0"/>
			<action trigger="clicked" name="actions.move.jog" arg="$minus"/>
		</ds_button>
	</view>
</component>
