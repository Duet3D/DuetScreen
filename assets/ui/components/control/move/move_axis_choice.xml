<!--
  One axis other than X, Y and Z, as a button choosing it to be jogged in the Move tab's last column; checked while it
  is the one chosen.

  Fields:   a source.axes.others row: row.letter, row.chosen (src/UI/Xml/Data/AxesSource.h)
  Actions:  actions.move.choose_axis (src/UI/Presenters/Control/Move/MoveActions.h)
-->
<component>
	<!-- A set size, so a second column of them (more than fit in one) looks like the first -->
	<view extends="ds_button" bind_text="row.letter" width="48" height="40">
		<bind_state_if_eq subject="row.chosen" state="checked" ref_value="1"/>
		<action trigger="clicked" name="actions.move.choose_axis"/>
	</view>
</component>
