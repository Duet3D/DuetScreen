<!--
  How far and how fast a jog goes: a row each, its title and unit, then its presets. Tap one to use it; hold it to
  change it. The `jog_choices` widget (widgets/motion/jog_choices.json) too.

  Data:     the global source.jog.* (src/UI/Xml/Data/JogSource.h), shared by every view that jogs
  Actions:  actions.selector.pick, actions.selector.edit_choice (in value_selector_choice.xml)
-->
<component>
	<view extends="lv_obj" width="100%" height="content">
		<style name="setting_group"/>
		<ds_setting name="distance" bind_title="source.jog.distance.title">
			<ds_list name="distances" list="source.jog.distance.choices" item="value_selector_choice" width="content"
					 flex_flow="row">
				<style name="setting_options"/>
			</ds_list>
		</ds_setting>
		<ds_setting name="feedrate" bind_title="source.jog.feedrate.title">
			<ds_list name="feedrates" list="source.jog.feedrate.choices" item="value_selector_choice" width="content"
					 flex_flow="row">
				<style name="setting_options"/>
			</ds_list>
		</ds_setting>
	</view>
</component>
