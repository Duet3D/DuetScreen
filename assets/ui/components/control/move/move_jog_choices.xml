<!--
  How far and how fast a jog goes, in a card: a row of distances and a row of speeds, each headed by its title. Tap
  one to use it; hold it to change it. The titles are in one column, so they are the same width, each choice row as
  tall as its title.

  Data:     the global source.jog.* (src/UI/Xml/Data/JogSource.h), shared by every view that jogs
  Actions:  actions.selector.pick, actions.selector.edit_choice (in value_selector_choice.xml)
-->
<component>
	<view extends="lv_obj" style_pad_all="0" style_pad_column="0" flex_flow="row">
		<style name="card"/>
		<lv_obj name="titles" width="content" height="content" flex_flow="column" style_pad_all="#pad"
				style_pad_right="0" style_pad_row="#pad">
			<lv_obj name="distance_header" width="content" height="content" style_min_width="100%" flex_flow="row"
					style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center"
					style_text_align="center">
				<style name="bg_color_header"/>
				<style name="list_header"/>
				<lv_label name="title" bind_text="source.jog.distance.title" width="content" height="content">
					<style name="list_title"/>
				</lv_label>
			</lv_obj>
			<lv_obj name="feedrate_header" width="content" height="content" style_min_width="100%" flex_flow="row"
					style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center"
					style_text_align="center">
				<style name="bg_color_header"/>
				<style name="list_header"/>
				<lv_label name="title" bind_text="source.jog.feedrate.title" width="content" height="content">
					<style name="list_title"/>
				</lv_label>
			</lv_obj>
		</lv_obj>
		<lv_obj name="choices" height="100%" flex_grow="1" flex_flow="column" style_pad_all="#pad"
				style_pad_row="#pad">
			<ds_list name="distances" list="source.jog.distance.choices" item="value_selector_choice" width="100%" flex_grow="1"
					 flex_flow="row" style_pad_all="0"
					 style_flex_main_place="center" style_flex_cross_place="center"
					 style_flex_track_place="center"/>
			<ds_list name="feedrates" list="source.jog.feedrate.choices" item="value_selector_choice" width="100%" flex_grow="1"
					 flex_flow="row" style_pad_all="0"
					 style_flex_main_place="center" style_flex_cross_place="center"
					 style_flex_track_place="center"/>
		</lv_obj>
	</view>
</component>
