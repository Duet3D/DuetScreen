<!--
  A dialog of percentages, such as the speed factor or each extruder's extrusion factor, each on a slider. Tapping a
  slider's value types it on a number pad, the dialog's next step.

      <factors_dialog dialog="speed" open="source.factors.speed.open" title="source.factors.speed.title"
                      factors="source.factors.speed.factors"/>

  `dialog` is the dialog's id, the arg of actions.factors.close; the others name its fields, published by
  FactorsSource (src/UI/Xml/Data/FactorsSource.h, src/UI/Xml/View/FactorDialog.h).
-->
<component>
	<api>
		<prop name="dialog" type="string"/>
		<prop name="open" type="string"/>
		<prop name="title" type="string"/>
		<prop name="factors" type="string"/>
	</api>

	<view extends="ds_dialog" bind_open="$open" bind_title="$title" width="70%" flex_flow="column" scrollable="false">
		<action trigger="dismissed" name="actions.factors.close" arg="$dialog"/>
		<ds_list name="list" list="$factors" item="factors_slider" width="100%" height="content" flex_flow="column"
				 style_flex_main_place="start" style_flex_cross_place="start" style_flex_track_place="start"/>
	</view>
</component>
