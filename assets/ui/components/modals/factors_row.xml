<!--
  One percentage of a factors_dialog: what it is (an extruder's number and the tools that use it; the speed factor's
  name is the dialog's title), then its slider, with − and + and its value (tap the value to type it on a number pad,
  the dialog's next step), then its quick values, the one in use marked. Its range may be a window that follows the
  value (the speed factor's); the value may be anything from 1% up, typed or reset, wherever the window is.

  Fields:   a factors row: row.label, row.detail, row.value, row.min, row.max, row.presets
            (src/UI/Xml/View/FactorDialog.h)
  Actions:  actions.factors.set, actions.factors.preset (src/UI/Presenters/Modals/FactorsActions.h)
-->
<component>
	<view extends="lv_obj" width="100%" height="content" flex_flow="column" scrollable="false" style_pad_row="8">
		<style name="pad_zero"/>
		<lv_obj name="header" width="100%" height="content" flex_flow="row" scrollable="false"
				style_flex_cross_place="center" style_flex_track_place="center" style_pad_all="0" style_pad_column="12">
			<lv_label name="label" bind_text="row.label">
				<style name="setting_title"/>
				<bind_flag_if_eq subject="row.label" flag="hidden" ref_value=""/>
			</lv_label>
			<lv_label name="detail" bind_text="row.detail" flex_grow="1" long_mode="dots">
				<style name="setting_hint"/>
			</lv_label>
		</lv_obj>
		<ds_slider name="slider" bind_label="row.label" label_shown="false" bind_value="row.value" bind_min="row.min"
				   bind_max="row.max" min="0" max="200" increment="1" decimals="0" unit="%" lowest="1"
				   out_of_range="upper" numberpad="true" width="100%" height="content">
			<action trigger="value_confirmed" name="actions.factors.set"/>
		</ds_slider>
		<ds_list name="presets" list="row.presets" item="factors_preset" width="100%" flex_flow="row">
			<style name="setting_options"/>
		</ds_list>
	</view>
</component>
