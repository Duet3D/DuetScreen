<!--
  A quick value of a factor in a factors_dialog (factors_row.xml), an option (option_button.xml) checked while it is
  the factor's value. Tap it to use it.

  Fields:   a presets row: row.text, row.chosen (src/UI/Xml/View/FactorDialog.h)
  Actions:  actions.factors.preset (src/UI/Presenters/Modals/FactorsActions.h)
-->
<component>
	<view extends="option_button" subject="row.chosen" action="actions.factors.preset" bind_text="row.text"
		  height="content" flex_grow="1" style_min_width="content"/>
</component>
