<!--
  The shared speed and extrusion factor dialogs. Any view opens them with the global actions `factors.speed` and
  `actions.factors.extrusion` (the extruders of the tool numbered `arg`, else every extruder).

  Fields and actions: src/UI/Presenters/Modals/FactorsPresenter.h
-->
<component presenter="factors">
	<!-- Takes no room: its dialogs open over the main window -->
	<view extends="lv_obj" width="0" height="0" floating="true">
		<factors_dialog name="speed_dialog" dialog="speed_dialog" open="presenter.speed_dialog.open" title="presenter.speed_dialog.title"
						factors="presenter.speed_dialog.factors" pad_shown="presenter.speed_dialog.pad_shown" pad="speed_dialog.pad"
						pad_header="presenter.speed_dialog.pad.header" pad_text="presenter.speed_dialog.pad.text"
						pad_accepted="presenter.speed_dialog.pad.accepted" pad_confirmable="presenter.speed_dialog.pad.confirmable"
						pad_signed="presenter.speed_dialog.pad.signed"/>
		<factors_dialog name="extrusion_dialog" dialog="extrusion_dialog" open="presenter.extrusion_dialog.open"
						title="presenter.extrusion_dialog.title" factors="presenter.extrusion_dialog.factors"
						pad_shown="presenter.extrusion_dialog.pad_shown" pad="extrusion_dialog.pad"
						pad_header="presenter.extrusion_dialog.pad.header" pad_text="presenter.extrusion_dialog.pad.text"
						pad_accepted="presenter.extrusion_dialog.pad.accepted" pad_confirmable="presenter.extrusion_dialog.pad.confirmable"
						pad_signed="presenter.extrusion_dialog.pad.signed"/>
	</view>
</component>
