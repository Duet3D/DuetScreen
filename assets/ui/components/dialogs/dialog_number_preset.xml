<!--
  One preset beside a number pad prompt (dialog_number.xml): what it is for and its value, marked while the pad holds
  it. Tapping it types its value into the pad.

  Fields:   a presets row: row.title, row.value, row.chosen (src/UI/Xml/Dialogs/PromptPresenters.h)
-->
<component>
	<view extends="lv_obj" width="100%" height="content" flex_flow="row" scrollable="false"
		  style_flex_cross_place="center" style_flex_track_place="center" style_min_height="38"
		  style_pad_ver="4">
		<style name="setting_row"/>
		<style name="pressed" selector="pressed"/>
		<style name="btn_checked" selector="checked"/>
		<bind_state_if_eq subject="row.chosen" state="checked" ref_value="1"/>
		<action trigger="clicked" name="presenter.number.preset"/>
		<lv_label name="title" bind_text="row.title" flex_grow="1" long_mode="dots"/>
		<lv_label name="value" bind_text="row.value">
			<style name="text_muted"/>
		</lv_label>
	</view>
</component>
