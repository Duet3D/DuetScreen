<!--
  A number pad prompt: the box showing what has been typed, with a button to empty it, the numbers that can be typed,
  and the number keys, whose OK key hands the number back. Code asks it with Prompts::askNumber() or askText()
  (src/UI/Xml/Dialogs/Prompts.h); a slider with numberpad="true" asks it when its value is tapped. What is asked for
  is the step's title.

  Fields and actions: src/UI/Xml/Dialogs/PromptPresenters.h (NumberPrompt)
-->
<component presenter="dialog_number">
	<view extends="lv_obj" width="360" height="420" flex_flow="column" scrollable="false">
		<style name="pad_zero"/>

		<lv_obj name="text_row" width="100%" height="content" flex_flow="row" scrollable="false"
				style_flex_main_place="start" style_flex_cross_place="center" style_flex_track_place="start">
			<style name="pad_zero"/>
			<ds_textarea name="text" bind_text="presenter.text" bind_accepted_chars="presenter.accepted" one_line="true"
						 keyboard="none" height="content" flex_grow="1" scrollable="false">
				<action trigger="value_changed" name="presenter.number.typed"/>
			</ds_textarea>
			<ds_button name="clear" text="&#xF2ED;" width="20%" height="100%">
				<action trigger="clicked" name="presenter.number.clear"/>
			</ds_button>
		</lv_obj>

		<lv_label name="range" bind_text="presenter.range" width="100%">
			<style name="text_muted"/>
			<bind_flag_if_eq subject="presenter.range" flag="hidden" ref_value=""/>
		</lv_label>

		<ds_keyboard name="keys" mode="numberpad" textarea="text" bind_ok_enabled="presenter.confirmable"
					 bind_sign_enabled="presenter.signed" width="100%" flex_grow="1" style_min_width="100">
			<action trigger="ready" name="presenter.number.confirm"/>
		</ds_keyboard>
	</view>
</component>
