<!--
  One value of a choice prompt (dialog_choice.xml): a row, the value chosen now in the accent colour with a tick.
  Tapping it chooses it.

  Fields:   a choices row: row.value, row.title, row.chosen (src/UI/Xml/Dialogs/PromptPresenters.h)
-->
<component>
	<view extends="lv_obj" width="100%" height="content" scrollable="false">
		<style name="pad_zero"/>
		<lv_obj name="choice" width="100%" height="content" flex_flow="row" scrollable="false"
				style_flex_cross_place="center" style_flex_track_place="center">
			<style name="dialog_row"/>
			<style name="pressed" selector="pressed"/>
			<style name="dialog_row_chosen" selector="checked"/>
			<bind_state_if_eq subject="row.chosen" state="checked" ref_value="1"/>
			<action trigger="clicked" name="presenter.choice.choose"/>
			<lv_label name="title" bind_text="row.title" flex_grow="1" long_mode="dots"/>
			<lv_label name="tick" text="&#xF00C;">
				<bind_flag_if_eq subject="row.chosen" flag="hidden" ref_value="0"/>
			</lv_label>
		</lv_obj>
	</view>
</component>
