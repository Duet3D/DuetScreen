<!--
  A sidebar button that opens a page, checked while that page is open. Each page's button is a widget of its own
  (sidebar/page_*.widget.json), which gives this component its props.

  `page` is the name the page is registered under in home.xml ("" for the home screen, opened by `action` nav.home),
  `label` the button's translation key, `icon` its image, and `flash` a subject that flashes it when it changes.

  The button is in a plain container because a placed widget's root can't be a DuetScreen widget (see XmlView.h); the
  container draws beyond itself, as the sidebar does, so the theme's shadows and glows around the button show.
-->
<component>
	<api>
		<prop name="page" type="string" default=""/>
		<prop name="action" type="string" default="nav.open"/>
		<prop name="label" type="string" default=""/>
		<prop name="icon" type="string" default=""/>
		<prop name="flash" type="string" default=""/>
	</api>

	<view extends="lv_obj" width="100%" style_min_width="content" flex_grow="1" scrollable="false"
		  overflow_visible="true" ext_draw_size="400">
		<style name="pad_zero"/>
		<ds_button name="button" translation_tag="$label" icon="$icon" width="100%" height="100%"
				   style_min_width="content" long_mode="clip" flash_on="$flash">
			<style name="sidebar_btn"/>
			<style name="console_btn_anim" selector="user_1"/>
			<bind_state_if_eq subject="nav.screen" state="checked" ref_value="$page"/>
			<action trigger="clicked" name="$action" arg="$page"/>
		</ds_button>
	</view>
</component>
