<!--
  The sidebar down the left of the screen: a button per page and the drag-to-stop E-stop.

  Each button opens a page by the name home_screen.xml registers it under, and is checked while that page is open
  (nav.screen is empty on the home screen). Add a button for any page the same way.

  The sidebar and its buttons draw beyond their own area so the E-stop stays visible while it is dragged (and
  button shadows aren't clipped at the edge).
-->
<component>
	<view extends="lv_obj" scrollable="false" overflow_visible="true" ext_draw_size="1024">
		<style name="sidebar"/>
		<style name="pad_zero"/>

		<lv_obj name="buttons" width="100%" height="100%" style_min_width="content" scrollable="false" overflow_visible="true" ext_draw_size="400"
				flex_flow="column" style_flex_main_place="start" style_flex_cross_place="center" style_flex_track_place="center">
			<style name="bg_dark"/>

			<ds_button name="home" translation_tag="side_bar.home" icon="home.png" width="100%" style_min_width="content"
					   flex_grow="1" long_mode="clip">
				<style name="sidebar_btn"/>
				<bind_state_if_eq subject="nav.screen" state="checked" ref_value=""/>
				<action trigger="clicked" name="nav.home"/>
			</ds_button>

			<ds_button name="control" translation_tag="side_bar.control" icon="control.png" width="100%"
					   style_min_width="content" flex_grow="1" long_mode="clip">
				<style name="sidebar_btn"/>
				<bind_state_if_eq subject="nav.screen" state="checked" ref_value="control"/>
				<action trigger="clicked" name="nav.open" arg="control"/>
			</ds_button>

			<ds_button name="macros" translation_tag="side_bar.files" icon="macros.png" width="100%"
					   style_min_width="content" flex_grow="1" long_mode="clip">
				<style name="sidebar_btn"/>
				<bind_state_if_eq subject="nav.screen" state="checked" ref_value="files"/>
				<action trigger="clicked" name="nav.open" arg="files"/>
			</ds_button>

			<!-- Flashes when the printer replies -->
			<ds_button name="console" translation_tag="side_bar.console" icon="console.png" width="100%"
					   style_min_width="content" flex_grow="1" long_mode="clip" flash_on="responses.count">
				<style name="sidebar_btn"/>
				<style name="console_btn_anim" selector="user_1"/>
				<bind_state_if_eq subject="nav.screen" state="checked" ref_value="console"/>
				<action trigger="clicked" name="nav.open" arg="console"/>
			</ds_button>

			<ds_button name="settings" translation_tag="side_bar.settings" icon="settings.png" width="100%"
					   style_min_width="content" flex_grow="1" long_mode="clip">
				<style name="sidebar_btn"/>
				<bind_state_if_eq subject="nav.screen" state="checked" ref_value="settings"/>
				<action trigger="clicked" name="nav.open" arg="settings"/>
			</ds_button>

			<ds_view name="estop" view="estop" shown="true" width="80" height="80"/>
		</lv_obj>
	</view>
</component>
