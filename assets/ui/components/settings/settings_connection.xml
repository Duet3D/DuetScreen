<!--
  The Connection settings tab: how the screen reaches the Duet (and, over the network, the Duet's address and
  password), how often it polls it, and the screen's own WiFi (settings_wifi.xml).

  Fields and actions: src/UI/Presenters/Settings/ConnectionSettingsPresenter.h. Numbers and the IP address are typed on
  the shared number pad; the password on the shared keyboard.
-->
<component presenter="settings_connection">
	<view extends="lv_obj" width="100%" height="100%" style_layout="grid"
		  style_grid_column_dsc_array="content fr(1)"
		  style_grid_row_dsc_array="content content content content content content content">
		<style name="card"/>

		<lv_label name="row_label_0" translation_tag="settings.duet_connection_method"
				  style_grid_cell_column_pos="0" style_grid_cell_x_align="end"
				  style_grid_cell_row_pos="0" style_grid_cell_y_align="center"/>
		<settings_dropdown name="connection_method" options="connection_methods" selected="connection_method"
						  action="settings.connection_method"
						  style_grid_cell_column_pos="1" style_grid_cell_x_align="stretch"
						  style_grid_cell_row_pos="0" style_grid_cell_y_align="center"/>
		<lv_label name="row_label_1" translation_tag="settings.usb_mode"
				  style_grid_cell_column_pos="0" style_grid_cell_x_align="end"
				  style_grid_cell_row_pos="1" style_grid_cell_y_align="center"/>
		<settings_dropdown name="usb_mode" options="usb_modes" selected="usb_mode" action="settings.usb_mode"
						  style_grid_cell_column_pos="1" style_grid_cell_x_align="stretch"
						  style_grid_cell_row_pos="1" style_grid_cell_y_align="center"/>
		<lv_label name="row_label_2" translation_tag="settings.duet_poll_interval"
				  style_grid_cell_column_pos="0" style_grid_cell_x_align="end"
				  style_grid_cell_row_pos="2" style_grid_cell_y_align="center"/>
		<ds_slider name="poll_interval" label_tag="settings.duet_poll_interval" label_shown="false"
				   numberpad="true" min="100" max="2000" bind_value="poll_interval" height="content" out_of_range="upper"
				   style_grid_cell_column_pos="1" style_grid_cell_x_align="stretch"
				   style_grid_cell_row_pos="2" style_grid_cell_y_align="center">
			<action trigger="value_confirmed" name="settings.poll_interval"/>
		</ds_slider>

		<!-- Over the network only -->
		<lv_label name="row_label_3" translation_tag="settings.duet_ip_address"
				  style_grid_cell_column_pos="0" style_grid_cell_x_align="end"
				  style_grid_cell_row_pos="3" style_grid_cell_y_align="center">
			<bind_flag_if_eq subject="network_shown" flag="hidden" ref_value="0"/>
		</lv_label>
		<ds_textarea name="duet_ip_address" bind_text="duet_ip" one_line="true" keyboard="none"
						 placeholder_tag="settings.duet_ip_address_prompt" height="content"
						 style_grid_cell_column_pos="1" style_grid_cell_x_align="stretch"
						 style_grid_cell_row_pos="3" style_grid_cell_y_align="center">
			<bind_flag_if_eq subject="network_shown" flag="hidden" ref_value="0"/>
			<action trigger="clicked" name="settings.duet_ip"/>
		</ds_textarea>
		<lv_label name="row_label_4" translation_tag="settings.duet_password"
				  style_grid_cell_column_pos="0" style_grid_cell_x_align="end"
				  style_grid_cell_row_pos="4" style_grid_cell_y_align="center">
			<bind_flag_if_eq subject="network_shown" flag="hidden" ref_value="0"/>
		</lv_label>
		<ds_textarea name="duet_password" bind_text="duet_password" one_line="true" password_mode="true"
						 placeholder_tag="settings.duet_password_prompt" height="content"
						 style_grid_cell_column_pos="1" style_grid_cell_x_align="stretch"
						 style_grid_cell_row_pos="4" style_grid_cell_y_align="center">
			<bind_flag_if_eq subject="network_shown" flag="hidden" ref_value="0"/>
			<action trigger="ready" name="settings.duet_password"/>
		</ds_textarea>

		<!-- The screen's own networking -->
		<lv_label name="row_label_5" translation_tag="settings.headers.screen_networking"
				  style_grid_cell_column_pos="0" style_grid_cell_x_align="start"
				  style_grid_cell_row_pos="5" style_grid_cell_y_align="center">
			<style name="text_emphasis"/>
		</lv_label>
		<ds_view name="settings_wifi" view="settings_wifi" shown="true" height="content"
				 style_grid_cell_column_pos="0" style_grid_cell_column_span="2" style_grid_cell_x_align="stretch"
				 style_grid_cell_row_pos="6" style_grid_cell_y_align="center"/>
	</view>
</component>
