<!--
  An extruder of the simulated Duet, a row (ds_setting) of its page: the filament loaded when the machine starts,
  typed on the keyboard (empty for none), and a button to remove it. Tools choose their extruders in their own rows.

  Fields:   a row of source.simulator.extruders (src/UI/Xml/Data/SimulatorSource.h)
  Actions:  actions.simulator.set, actions.simulator.remove
-->
<component>
	<view extends="ds_setting" bind_title="row.title">
		<lv_obj name="controls" clickable="false" scrollable="false">
			<style name="setting_controls"/>
			<lv_label name="filament_title" translation_tag="tr.simulator.fields.filament" clickable="false">
				<style name="text_muted"/>
			</lv_label>
			<ds_textarea name="filament" bind_text="row.filament" one_line="true" width="150" height="content">
				<action trigger="ready" name="actions.simulator.set" arg="filament"/>
			</ds_textarea>
			<ds_button name="remove" icon="delete.png" width="48" height="40">
				<action trigger="clicked" name="actions.simulator.remove"/>
			</ds_button>
		</lv_obj>
	</view>
</component>
