<!--
  The Developer settings tab: logging and diagnostic options, restarting and rebooting, the hardware test, the cache,
  upgrading from GitHub, sending the settings to the Duet, and the storage used. The options only some builds have
  (debug borders, SSH, ADB, setup, the system monitor) are hidden in the others, so they come last.

  Fields and actions: src/UI/Screens/Settings/DeveloperSettingsPresenter.h
-->
<component presenter="settings_developer">
	<view extends="lv_obj" width="100%" height="100%" style_layout="grid"
		  style_grid_column_dsc_array="content fr(1)"
		  style_grid_row_dsc_array="content content content content content content content content content content content">
		<style name="card"/>

		<lv_label name="row_label_0" translation_tag="settings.debug_level"
				  style_grid_cell_column_pos="0" style_grid_cell_x_align="end"
				  style_grid_cell_row_pos="0" style_grid_cell_y_align="center"/>
		<setting_dropdown name="debug_level" options="debug_levels" selected="debug_level"
						  action="settings.debug_level"
						  style_grid_cell_column_pos="1" style_grid_cell_x_align="stretch"
						  style_grid_cell_row_pos="0" style_grid_cell_y_align="center"/>
		<lv_label name="row_label_1" translation_tag="settings.enable_advanced_settings"
				  style_grid_cell_column_pos="0" style_grid_cell_x_align="end"
				  style_grid_cell_row_pos="1" style_grid_cell_y_align="center"/>
		<ds_toggle name="enable_advanced_settings"
				   style_grid_cell_column_pos="1" style_grid_cell_x_align="stretch"
				   style_grid_cell_row_pos="1" style_grid_cell_y_align="center">
			<bind_state_if_eq subject="advanced_settings" state="checked" ref_value="1"/>
			<action trigger="value_changed" name="settings.advanced_settings"/>
		</ds_toggle>
		<lv_label name="row_label_2" translation_tag="settings.enable_second_usb_channel"
				  style_grid_cell_column_pos="0" style_grid_cell_x_align="end"
				  style_grid_cell_row_pos="2" style_grid_cell_y_align="center"/>
		<ds_toggle name="enable_second_usb_channel"
				   style_grid_cell_column_pos="1" style_grid_cell_x_align="stretch"
				   style_grid_cell_row_pos="2" style_grid_cell_y_align="center">
			<bind_state_if_eq subject="second_usb_channel" state="checked" ref_value="1"/>
			<action trigger="value_changed" name="settings.second_usb_channel"/>
		</ds_toggle>
		<lv_label name="row_label_3" translation_tag="settings.system_logging"
				  style_grid_cell_column_pos="0" style_grid_cell_x_align="end"
				  style_grid_cell_row_pos="3" style_grid_cell_y_align="center"/>
		<ds_toggle name="system_logging"
				   style_grid_cell_column_pos="1" style_grid_cell_x_align="stretch"
				   style_grid_cell_row_pos="3" style_grid_cell_y_align="center">
			<bind_state_if_eq subject="system_logging" state="checked" ref_value="1"/>
			<action trigger="value_changed" name="settings.system_logging"/>
		</ds_toggle>

		<lv_obj name="controls" width="50%" height="content" flex_flow="row_wrap"
				style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center"
				style_grid_cell_column_pos="0" style_grid_cell_column_span="2" style_grid_cell_x_align="stretch"
				style_grid_cell_row_pos="4" style_grid_cell_y_align="center">
			<ds_button name="restart" translation_tag="settings.restart" width="150" height="100">
				<action trigger="clicked" name="settings.restart"/>
			</ds_button>
			<ds_button name="erase_and_restart" translation_tag="settings.erase_and_restart" width="150" height="100">
				<action trigger="clicked" name="settings.erase_and_restart"/>
			</ds_button>
			<ds_button name="reboot" translation_tag="settings.reboot" width="150" height="100">
				<action trigger="clicked" name="settings.reboot"/>
			</ds_button>
			<ds_button name="start_hardware_test" translation_tag="settings.start_hardware_test" width="150" height="100">
				<action trigger="clicked" name="settings.hardware_test"/>
			</ds_button>
			<ds_button name="run_buildroot_setup" translation_tag="settings.run_buildroot_setup" width="150" height="100">
				<bind_flag_if_eq subject="developer_mode" flag="hidden" ref_value="0"/>
				<action trigger="clicked" name="settings.buildroot_setup"/>
			</ds_button>
			<ds_button name="clear_duetscreen_cache" translation_tag="settings.clear_duetscreen_cache" width="150" height="100">
				<action trigger="clicked" name="settings.clear_cache"/>
			</ds_button>
			<ds_button name="upgrade_from_github" translation_tag="settings.upgrade_from_github" width="150" height="100">
				<action trigger="clicked" name="settings.upgrade_from_github"/>
			</ds_button>
			<ds_button name="send_config_json" translation_tag="settings.send_config_to_duet" width="150" height="100">
				<action trigger="clicked" name="settings.send_config"/>
			</ds_button>
		</lv_obj>

		<lv_label name="row_label_5" translation_tag="settings.storage_info"
				  style_grid_cell_column_pos="0" style_grid_cell_x_align="end"
				  style_grid_cell_row_pos="5" style_grid_cell_y_align="center"/>
		<lv_label name="storage_info" bind_text="storage_info"
				  style_grid_cell_column_pos="1" style_grid_cell_x_align="stretch"
				  style_grid_cell_row_pos="5" style_grid_cell_y_align="center"/>
		<lv_label name="row_label_6" translation_tag="settings.duetscreen_cache_size"
				  style_grid_cell_column_pos="0" style_grid_cell_x_align="end"
				  style_grid_cell_row_pos="6" style_grid_cell_y_align="center"/>
		<lv_label name="duetscreen_cache_size" bind_text="cache_size"
				  style_grid_cell_column_pos="1" style_grid_cell_x_align="stretch"
				  style_grid_cell_row_pos="6" style_grid_cell_y_align="center"/>

		<!-- In builds that have them -->
		<lv_label name="row_label_7" translation_tag="settings.debug_borders"
				  style_grid_cell_column_pos="0" style_grid_cell_x_align="end"
				  style_grid_cell_row_pos="7" style_grid_cell_y_align="center">
			<bind_flag_if_eq subject="debug_borders_shown" flag="hidden" ref_value="0"/>
		</lv_label>
		<ds_toggle name="debug_borders"
				   style_grid_cell_column_pos="1" style_grid_cell_x_align="stretch"
				   style_grid_cell_row_pos="7" style_grid_cell_y_align="center">
			<bind_flag_if_eq subject="debug_borders_shown" flag="hidden" ref_value="0"/>
			<bind_state_if_eq subject="debug_borders" state="checked" ref_value="1"/>
			<action trigger="value_changed" name="settings.debug_borders"/>
		</ds_toggle>
		<lv_label name="row_label_8" translation_tag="settings.enable_ssh"
				  style_grid_cell_column_pos="0" style_grid_cell_x_align="end"
				  style_grid_cell_row_pos="8" style_grid_cell_y_align="center">
			<bind_flag_if_eq subject="developer_mode" flag="hidden" ref_value="0"/>
		</lv_label>
		<ds_toggle name="enable_ssh"
				   style_grid_cell_column_pos="1" style_grid_cell_x_align="stretch"
				   style_grid_cell_row_pos="8" style_grid_cell_y_align="center">
			<bind_flag_if_eq subject="developer_mode" flag="hidden" ref_value="0"/>
			<bind_state_if_eq subject="ssh" state="checked" ref_value="1"/>
			<action trigger="value_changed" name="settings.ssh"/>
		</ds_toggle>
		<lv_label name="row_label_9" translation_tag="settings.enable_adb"
				  style_grid_cell_column_pos="0" style_grid_cell_x_align="end"
				  style_grid_cell_row_pos="9" style_grid_cell_y_align="center">
			<bind_flag_if_eq subject="developer_mode" flag="hidden" ref_value="0"/>
		</lv_label>
		<ds_toggle name="enable_adb"
				   style_grid_cell_column_pos="1" style_grid_cell_x_align="stretch"
				   style_grid_cell_row_pos="9" style_grid_cell_y_align="center">
			<bind_flag_if_eq subject="developer_mode" flag="hidden" ref_value="0"/>
			<bind_state_if_eq subject="adb" state="checked" ref_value="1"/>
			<action trigger="value_changed" name="settings.adb"/>
		</ds_toggle>
		<lv_label name="row_label_10" translation_tag="settings.enable_system_monitor"
				  style_grid_cell_column_pos="0" style_grid_cell_x_align="end"
				  style_grid_cell_row_pos="10" style_grid_cell_y_align="center">
			<bind_flag_if_eq subject="system_monitor_shown" flag="hidden" ref_value="0"/>
		</lv_label>
		<ds_toggle name="enable_system_monitor"
				   style_grid_cell_column_pos="1" style_grid_cell_x_align="stretch"
				   style_grid_cell_row_pos="10" style_grid_cell_y_align="center">
			<bind_flag_if_eq subject="system_monitor_shown" flag="hidden" ref_value="0"/>
			<bind_state_if_eq subject="system_monitor" state="checked" ref_value="1"/>
			<action trigger="value_changed" name="settings.system_monitor"/>
		</ds_toggle>
	</view>
</component>
