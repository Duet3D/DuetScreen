<!--
  The Developer settings page: logging, options for developers, the hardware test, and, last, what only some builds
  have (debug borders, SSH, ADB, the system monitor, the setup), a group hidden in builds that have none of it. Each
  setting is a row (ds_setting), applied as soon as it is changed.

  Fields and actions: src/UI/Presenters/Settings/DeveloperSettingsPresenter.h
-->
<component presenter="settings_developer">
	<view extends="lv_obj" width="100%" height="100%" flex_flow="column">
		<style name="card"/>

		<lv_label name="logging_title" translation_tag="tr.settings.groups.logging">
			<style name="setting_group_title"/>
		</lv_label>
		<lv_obj name="logging">
			<style name="setting_group"/>
			<ds_setting name="debug_level" title_tag="tr.settings.debug_level">
				<ds_choice name="choice" title_tag="tr.settings.debug_level" bind_options="presenter.debug_levels"
						   bind_selected="presenter.debug_level">
					<style name="setting_control"/>
					<action trigger="value_confirmed" name="presenter.settings.debug_level"/>
				</ds_choice>
			</ds_setting>
			<ds_setting name="system_logging" title_tag="tr.settings.system_logging"
						hint_tag="tr.settings.hints.system_logging">
				<ds_toggle name="switch">
					<bind_state_if_eq subject="presenter.system_logging" state="checked" ref_value="1"/>
					<action trigger="value_changed" name="presenter.settings.system_logging"/>
				</ds_toggle>
			</ds_setting>
		</lv_obj>

		<lv_label name="options_title" translation_tag="tr.settings.groups.options">
			<style name="setting_group_title"/>
		</lv_label>
		<lv_obj name="options">
			<style name="setting_group"/>
			<ds_setting name="enable_advanced_settings" title_tag="tr.settings.enable_advanced_settings"
						hint_tag="tr.settings.hints.advanced">
				<ds_toggle name="switch">
					<bind_state_if_eq subject="presenter.advanced_settings" state="checked" ref_value="1"/>
					<action trigger="value_changed" name="presenter.settings.advanced_settings"/>
				</ds_toggle>
			</ds_setting>
			<ds_setting name="enable_second_usb_channel" title_tag="tr.settings.enable_second_usb_channel">
				<ds_toggle name="switch">
					<bind_state_if_eq subject="presenter.second_usb_channel" state="checked" ref_value="1"/>
					<action trigger="value_changed" name="presenter.settings.second_usb_channel"/>
				</ds_toggle>
			</ds_setting>
		</lv_obj>

		<lv_label name="tools_title" translation_tag="tr.settings.groups.tools">
			<style name="setting_group_title"/>
		</lv_label>
		<lv_obj name="tools">
			<style name="setting_group"/>
			<ds_setting name="hardware_test" title_tag="tr.settings.hardware_test"
						hint_tag="tr.settings.hints.hardware_test">
				<ds_button name="start" translation_tag="tr.settings.start">
					<style name="setting_control"/>
					<action trigger="clicked" name="presenter.settings.hardware_test"/>
				</ds_button>
			</ds_setting>
		</lv_obj>

		<!-- In builds that have them -->
		<lv_label name="build_only_title" translation_tag="tr.settings.groups.build_only">
			<style name="setting_group_title"/>
			<bind_flag_if_eq subject="presenter.build_tools_shown" flag="hidden" ref_value="0"/>
		</lv_label>
		<lv_obj name="build_only">
			<style name="setting_group"/>
			<bind_flag_if_eq subject="presenter.build_tools_shown" flag="hidden" ref_value="0"/>
			<ds_setting name="debug_borders" title_tag="tr.settings.debug_borders">
				<bind_flag_if_eq subject="presenter.debug_borders_shown" flag="hidden" ref_value="0"/>
				<ds_toggle name="switch">
					<bind_state_if_eq subject="presenter.debug_borders" state="checked" ref_value="1"/>
					<action trigger="value_changed" name="presenter.settings.debug_borders"/>
				</ds_toggle>
			</ds_setting>
			<ds_setting name="enable_ssh" title_tag="tr.settings.enable_ssh">
				<bind_flag_if_eq subject="presenter.developer_mode" flag="hidden" ref_value="0"/>
				<ds_toggle name="switch">
					<bind_state_if_eq subject="presenter.ssh" state="checked" ref_value="1"/>
					<action trigger="value_changed" name="presenter.settings.ssh"/>
				</ds_toggle>
			</ds_setting>
			<ds_setting name="enable_adb" title_tag="tr.settings.enable_adb">
				<bind_flag_if_eq subject="presenter.developer_mode" flag="hidden" ref_value="0"/>
				<ds_toggle name="switch">
					<bind_state_if_eq subject="presenter.adb" state="checked" ref_value="1"/>
					<action trigger="value_changed" name="presenter.settings.adb"/>
				</ds_toggle>
			</ds_setting>
			<ds_setting name="enable_system_monitor" title_tag="tr.settings.enable_system_monitor">
				<bind_flag_if_eq subject="presenter.system_monitor_shown" flag="hidden" ref_value="0"/>
				<ds_toggle name="switch">
					<bind_state_if_eq subject="presenter.system_monitor" state="checked" ref_value="1"/>
					<action trigger="value_changed" name="presenter.settings.system_monitor"/>
				</ds_toggle>
			</ds_setting>
			<ds_setting name="run_buildroot_setup" title_tag="tr.settings.run_buildroot_setup">
				<bind_flag_if_eq subject="presenter.developer_mode" flag="hidden" ref_value="0"/>
				<ds_button name="run" translation_tag="tr.settings.run">
					<style name="setting_control"/>
					<action trigger="clicked" name="presenter.settings.buildroot_setup"/>
				</ds_button>
			</ds_setting>
		</lv_obj>
	</view>
</component>
