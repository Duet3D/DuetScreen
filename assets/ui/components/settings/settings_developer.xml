<!--
  The Developer settings page: logging, options for developers, the hardware test, and, last, what only some builds
  have (debug borders, SSH, ADB, the system monitor, the setup), a group hidden in builds that have none of it. Each
  setting is a row (ds_setting), applied as soon as it is changed.

  Data:     source.settings.* (src/UI/Xml/Data/SettingsSource.h; these are declared in
            src/UI/Presenters/Settings/DeveloperSettings.cpp)
  Actions:  actions.settings.set
            source.system.*_shown and developer_mode (src/UI/Xml/Data/SystemSource.h): what this build has
  Actions:  actions.system.hardware_test, actions.system.buildroot_setup
-->
<component>
	<view extends="lv_obj" width="100%" height="100%" flex_flow="column">
		<style name="card"/>
		<style name="setting_page"/>

		<ds_setting_group name="logging" title_tag="tr.settings.groups.logging">
			<ds_setting name="debug_level" title_tag="tr.settings.debug_level">
				<ds_choice name="choice" title_tag="tr.settings.debug_level" bind_options="source.settings.debug_level_options"
						   bind_selected="source.settings.debug_level">
					<style name="setting_value"/>
					<action trigger="value_confirmed" name="actions.settings.set" arg="debug_level"/>
				</ds_choice>
			</ds_setting>
			<ds_setting name="system_logging" title_tag="tr.settings.system_logging"
						hint_tag="tr.settings.hints.system_logging">
				<ds_toggle name="switch">
					<bind_state_if_eq subject="source.settings.system_logging" state="checked" ref_value="1"/>
					<action trigger="value_changed" name="actions.settings.set" arg="system_logging"/>
				</ds_toggle>
			</ds_setting>
		</ds_setting_group>

		<ds_setting_group name="options" title_tag="tr.settings.groups.options">
			<ds_setting name="enable_advanced_settings" title_tag="tr.settings.enable_advanced_settings"
						hint_tag="tr.settings.hints.advanced">
				<ds_toggle name="switch">
					<bind_state_if_eq subject="source.settings.advanced_settings" state="checked" ref_value="1"/>
					<action trigger="value_changed" name="actions.settings.set" arg="advanced_settings"/>
				</ds_toggle>
			</ds_setting>
			<ds_setting name="enable_second_usb_channel" title_tag="tr.settings.enable_second_usb_channel">
				<ds_toggle name="switch">
					<bind_state_if_eq subject="source.settings.second_usb_channel" state="checked" ref_value="1"/>
					<action trigger="value_changed" name="actions.settings.set" arg="second_usb_channel"/>
				</ds_toggle>
			</ds_setting>
		</ds_setting_group>

		<ds_setting_group name="tools" title_tag="tr.settings.groups.tools">
			<ds_setting name="hardware_test" title_tag="tr.settings.hardware_test"
						hint_tag="tr.settings.hints.hardware_test">
				<ds_button name="start" translation_tag="tr.settings.start">
					<style name="setting_control"/>
					<action trigger="clicked" name="actions.system.hardware_test"/>
				</ds_button>
			</ds_setting>
		</ds_setting_group>

		<!-- In builds that have them -->
		<ds_setting_group name="build_only" title_tag="tr.settings.groups.build_only">
			<bind_flag_if_eq subject="source.system.build_tools_shown" flag="hidden" ref_value="0"/>
			<ds_setting name="debug_borders" title_tag="tr.settings.debug_borders">
				<bind_flag_if_eq subject="source.system.debug_borders_shown" flag="hidden" ref_value="0"/>
				<ds_toggle name="switch">
					<bind_state_if_eq subject="source.settings.debug_borders" state="checked" ref_value="1"/>
					<action trigger="value_changed" name="actions.settings.set" arg="debug_borders"/>
				</ds_toggle>
			</ds_setting>
			<ds_setting name="enable_ssh" title_tag="tr.settings.enable_ssh">
				<bind_flag_if_eq subject="source.system.developer_mode" flag="hidden" ref_value="0"/>
				<ds_toggle name="switch">
					<bind_state_if_eq subject="source.settings.ssh" state="checked" ref_value="1"/>
					<action trigger="value_changed" name="actions.settings.set" arg="ssh"/>
				</ds_toggle>
			</ds_setting>
			<ds_setting name="enable_adb" title_tag="tr.settings.enable_adb">
				<bind_flag_if_eq subject="source.system.developer_mode" flag="hidden" ref_value="0"/>
				<ds_toggle name="switch">
					<bind_state_if_eq subject="source.settings.adb" state="checked" ref_value="1"/>
					<action trigger="value_changed" name="actions.settings.set" arg="adb"/>
				</ds_toggle>
			</ds_setting>
			<ds_setting name="enable_system_monitor" title_tag="tr.settings.enable_system_monitor">
				<bind_flag_if_eq subject="source.system.system_monitor_shown" flag="hidden" ref_value="0"/>
				<ds_toggle name="switch">
					<bind_state_if_eq subject="source.settings.system_monitor" state="checked" ref_value="1"/>
					<action trigger="value_changed" name="actions.settings.set" arg="system_monitor"/>
				</ds_toggle>
			</ds_setting>
			<ds_setting name="run_buildroot_setup" title_tag="tr.settings.run_buildroot_setup">
				<bind_flag_if_eq subject="source.system.developer_mode" flag="hidden" ref_value="0"/>
				<ds_button name="run" translation_tag="tr.settings.run">
					<style name="setting_control"/>
					<action trigger="clicked" name="actions.system.buildroot_setup"/>
				</ds_button>
			</ds_setting>
		</ds_setting_group>
	</view>
</component>
