<!--
  The theme's colours (Settings > Display > Colours, a page of its own): for a theme whose palette can be changed, its
  hues (on sliders showing every hue) and chroma, which change it as they are moved; then a swatch of each colour the
  theme gives the screen. Dark mode is on the Display page.

  Fields and actions: src/UI/Presenters/Settings/ThemePreviewPresenter.h. Values are typed on the shared number pad.
-->
<component presenter="settings_theme_preview">
	<view extends="lv_obj" width="100%" height="100%" flex_flow="column">
		<style name="card"/>

		<!-- The palette, if it can be changed -->
		<lv_label name="palette_title" translation_tag="tr.settings.groups.palette">
			<style name="setting_group_title"/>
			<bind_flag_if_eq subject="presenter.controls_shown" flag="hidden" ref_value="0"/>
		</lv_label>
		<lv_obj name="palette">
			<style name="setting_group"/>
			<bind_flag_if_eq subject="presenter.controls_shown" flag="hidden" ref_value="0"/>
			<ds_setting name="primary_hue" title_tag="tr.theme.primary_hue">
				<ds_hue_slider name="slider" label_tag="tr.theme.primary_hue" label_shown="false" numberpad="true"
							   bind_value="presenter.primary_hue" bind_lightness="presenter.primary.lightness"
							   bind_chroma="presenter.primary.chroma" width="60%" height="content">
					<action trigger="value_confirmed" name="presenter.preview.primary_hue"/>
				</ds_hue_slider>
			</ds_setting>
			<ds_setting name="secondary_hue" title_tag="tr.theme.secondary_hue">
				<ds_hue_slider name="slider" label_tag="tr.theme.secondary_hue" label_shown="false" numberpad="true"
							   bind_value="presenter.secondary_hue" bind_lightness="presenter.secondary.lightness"
							   bind_chroma="presenter.secondary.chroma" width="60%" height="content">
					<action trigger="value_confirmed" name="presenter.preview.secondary_hue"/>
				</ds_hue_slider>
			</ds_setting>
			<ds_setting name="chroma" title_tag="tr.theme.chroma">
				<ds_slider name="slider" label_tag="tr.theme.chroma" label_shown="false" numberpad="true" min="0"
						   max="0.4" increment="0.01" bind_value="presenter.chroma" value_scale="100" width="60%"
						   height="content">
					<action trigger="value_confirmed" name="presenter.preview.chroma"/>
				</ds_slider>
			</ds_setting>
		</lv_obj>

		<lv_label name="roles_title" translation_tag="tr.settings.groups.colour_roles">
			<style name="setting_group_title"/>
		</lv_label>
		<lv_obj name="roles">
			<style name="setting_group"/>
			<ds_list name="list" list="presenter.swatches" item="settings_theme_swatch" width="100%" height="content"
					 flex_flow="row_wrap" style_flex_main_place="center" style_flex_cross_place="center"
					 style_flex_track_place="start" style_pad_all="12">
				<style name="setting_row"/>
			</ds_list>
		</lv_obj>
	</view>
</component>
