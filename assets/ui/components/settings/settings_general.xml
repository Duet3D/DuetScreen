<!--
  The General settings page: the language and USB keyboard layout, and how the screen works the machine. Each setting
  is a row (ds_setting) in a group, stored as soon as it is changed.

  Fields and actions: src/UI/Presenters/Settings/GeneralSettingsPresenter.h
-->
<component presenter="settings_general">
	<view extends="lv_obj" width="100%" height="100%" flex_flow="column">
		<style name="card"/>

		<lv_label name="language_keyboard_title" translation_tag="tr.settings.groups.language_keyboard">
			<style name="setting_group_title"/>
		</lv_label>
		<lv_obj name="language_keyboard">
			<style name="setting_group"/>
			<ds_setting name="language" title_tag="tr.settings.language" hint_tag="tr.settings.hints.language">
				<ds_choice name="choice" title_tag="tr.settings.language" bind_options="presenter.languages"
						   bind_selected="presenter.language">
					<style name="setting_control"/>
					<action trigger="value_confirmed" name="presenter.settings.language"/>
				</ds_choice>
			</ds_setting>
			<ds_setting name="keyboard_layout" title_tag="tr.settings.keyboard_layout">
				<ds_choice name="choice" title_tag="tr.settings.keyboard_layout" bind_options="presenter.keyboard_layouts"
						   bind_selected="presenter.keyboard_layout">
					<style name="setting_control"/>
					<action trigger="value_confirmed" name="presenter.settings.keyboard_layout"/>
				</ds_choice>
			</ds_setting>
		</lv_obj>

		<lv_label name="machine_title" translation_tag="tr.settings.groups.machine">
			<style name="setting_group_title"/>
		</lv_label>
		<lv_obj name="machine">
			<style name="setting_group"/>
			<ds_setting name="show_confirmation_dialogs" title_tag="tr.settings.show_confirmation_dialogs"
						hint_tag="tr.settings.hints.confirmations">
				<ds_toggle name="switch">
					<bind_state_if_eq subject="presenter.confirmations" state="checked" ref_value="1"/>
					<action trigger="value_changed" name="presenter.settings.confirmations"/>
				</ds_toggle>
			</ds_setting>
			<ds_setting name="move_machine_position_mode" title_tag="tr.settings.move_machine_position_mode"
						hint_tag="tr.settings.hints.machine_coordinates">
				<ds_toggle name="switch">
					<bind_state_if_eq subject="presenter.machine_position_mode" state="checked" ref_value="1"/>
					<action trigger="value_changed" name="presenter.settings.machine_position_mode"/>
				</ds_toggle>
			</ds_setting>
			<!-- One of a few: the chosen one is checked -->
			<ds_setting name="job_progress_source" title_tag="tr.settings.job_progress_source"
						hint_tag="tr.settings.hints.job_progress">
				<lv_obj name="options" width="content" height="content" flex_flow="row" style_pad_all="0">
					<ds_button name="duration" translation_tag="tr.settings.job_progress_source_options.duration">
						<style name="setting_control"/>
						<bind_state_if_eq subject="presenter.progress_source" state="checked" ref_value="0"/>
						<action trigger="clicked" name="presenter.settings.progress_source" arg="0"/>
					</ds_button>
					<ds_button name="file" translation_tag="tr.settings.job_progress_source_options.file">
						<style name="setting_control"/>
						<bind_state_if_eq subject="presenter.progress_source" state="checked" ref_value="1"/>
						<action trigger="clicked" name="presenter.settings.progress_source" arg="1"/>
					</ds_button>
				</lv_obj>
			</ds_setting>
		</lv_obj>
	</view>
</component>
