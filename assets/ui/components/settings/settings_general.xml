<!--
  The General settings page: the language and USB keyboard layout, and how the screen works the machine. Each setting
  is a row (ds_setting) in a group, stored as soon as it is changed.

  Data:     source.settings.* (src/UI/Xml/Data/SettingsSource.h; these are declared in
            src/UI/Presenters/Settings/GeneralSettings.cpp)
  Actions:  actions.settings.set
-->
<component>
	<view extends="lv_obj" width="100%" height="100%" flex_flow="column">
		<style name="card"/>
		<style name="setting_page"/>

		<ds_setting_group name="language_keyboard" title_tag="tr.settings.groups.language_keyboard">
			<ds_setting name="language" title_tag="tr.settings.language" hint_tag="tr.settings.hints.language">
				<ds_choice name="choice" title_tag="tr.settings.language" bind_options="source.settings.language_options"
						   bind_selected="source.settings.language">
					<style name="setting_value"/>
					<action trigger="value_confirmed" name="actions.settings.set" arg="language"/>
				</ds_choice>
			</ds_setting>
			<ds_setting name="keyboard_layout" title_tag="tr.settings.keyboard_layout">
				<ds_choice name="choice" title_tag="tr.settings.keyboard_layout" bind_options="source.settings.keyboard_layout_options"
						   bind_selected="source.settings.keyboard_layout">
					<style name="setting_value"/>
					<action trigger="value_confirmed" name="actions.settings.set" arg="keyboard_layout"/>
				</ds_choice>
			</ds_setting>
		</ds_setting_group>

		<ds_setting_group name="machine" title_tag="tr.settings.groups.machine">
			<ds_setting name="show_confirmation_dialogs" title_tag="tr.settings.show_confirmation_dialogs"
						hint_tag="tr.settings.hints.confirmations">
				<ds_toggle name="switch">
					<bind_state_if_eq subject="source.settings.confirmations" state="checked" ref_value="1"/>
					<action trigger="value_changed" name="actions.settings.set" arg="confirmations"/>
				</ds_toggle>
			</ds_setting>
			<ds_setting name="move_machine_position_mode" title_tag="tr.settings.move_machine_position_mode"
						hint_tag="tr.settings.hints.machine_coordinates">
				<ds_toggle name="switch">
					<bind_state_if_eq subject="source.settings.machine_position_mode" state="checked" ref_value="1"/>
					<action trigger="value_changed" name="actions.settings.set" arg="machine_position_mode"/>
				</ds_toggle>
			</ds_setting>
			<!-- One of a few: the chosen one is checked -->
			<ds_setting name="units" title_tag="tr.settings.units" hint_tag="tr.settings.hints.units">
				<lv_obj name="options">
					<style name="setting_options"/>
					<settings_option name="mm" translation_tag="tr.settings.units_options.mm"
									 setting="units" value="0"/>
					<settings_option name="inches" translation_tag="tr.settings.units_options.inches"
									 setting="units" value="1"/>
				</lv_obj>
			</ds_setting>
			<ds_setting name="job_progress_source" title_tag="tr.settings.job_progress_source"
						hint_tag="tr.settings.hints.job_progress">
				<lv_obj name="options">
					<style name="setting_options"/>
					<settings_option name="duration" translation_tag="tr.settings.job_progress_source_options.duration"
									 setting="progress_source" value="0"/>
					<settings_option name="file" translation_tag="tr.settings.job_progress_source_options.file"
									 setting="progress_source" value="1"/>
				</lv_obj>
			</ds_setting>
		</ds_setting_group>
	</view>
</component>
