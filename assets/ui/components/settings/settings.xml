<!--
  The Settings page: general, connection, display and developer settings, in tabs down the left. Display's colours are
  a page of their own, opened from it.
-->
<component>
	<view extends="lv_obj" width="100%" height="100%" style_pad_all="0">
		<style name="bg_dark"/>
		<ds_tabs name="tabs" side="left" width="100%" height="100%">
			<ds_tabs-tab name="general" icon="settings_general.png" title_tag="tr.settings.tabs.general">
				<ds_view name="settings_general" view="settings_general" shown="true"/>
			</ds_tabs-tab>
			<ds_tabs-tab name="connection" icon="settings_connection.png" title_tag="tr.settings.tabs.connection">
				<ds_view name="settings_connection" view="settings_connection" shown="true"/>
			</ds_tabs-tab>
			<ds_tabs-tab name="display" icon="settings_display.png" title_tag="tr.settings.tabs.display">
				<ds_pages name="display_pages" width="100%" height="100%">
					<ds_pages-page name="display" title_tag="tr.settings.tabs.display">
						<ds_view name="settings_display" view="settings_display" shown="true"/>
					</ds_pages-page>
					<ds_pages-page name="colours" title_tag="tr.settings.colours">
						<ds_view name="settings_colours" view="settings_theme_preview" shown="true"/>
					</ds_pages-page>
				</ds_pages>
			</ds_tabs-tab>
			<ds_tabs-tab name="developer" icon="settings_developer.png" title_tag="tr.settings.tabs.developer">
				<ds_view name="settings_developer" view="settings_developer" shown="true"/>
			</ds_tabs-tab>
		</ds_tabs>
	</view>
</component>
