<!--
  The Display settings tab: the theme, font and icons, a preview of the theme (settings_theme_preview.xml), animations and the
  screen's rotation. Each is applied as soon as it is changed. First, a button to customise the home screen (the global
  action customise.start, src/UI/Presenters/Customise/CustomisePresenter.h).

  Fields and actions: src/UI/Presenters/Settings/DisplaySettingsPresenter.h
-->
<component presenter="settings_display">
	<view extends="lv_obj" width="100%" height="100%" style_layout="grid"
		  style_grid_column_dsc_array="content fr(1)"
		  style_grid_row_dsc_array="content content content content content content content">
		<style name="card"/>

		<lv_label name="row_label_0" translation_tag="tr.settings.customise"
				  style_grid_cell_column_pos="0" style_grid_cell_x_align="end"
				  style_grid_cell_row_pos="0" style_grid_cell_y_align="center"/>
		<ds_button name="customise" translation_tag="tr.settings.customise_start"
				   style_grid_cell_column_pos="1" style_grid_cell_x_align="stretch"
				   style_grid_cell_row_pos="0" style_grid_cell_y_align="center">
			<action trigger="clicked" name="actions.customise.start"/>
		</ds_button>

		<lv_label name="row_label_1" translation_tag="tr.settings.theme"
				  style_grid_cell_column_pos="0" style_grid_cell_x_align="end"
				  style_grid_cell_row_pos="1" style_grid_cell_y_align="center"/>
		<settings_dropdown name="theme" options="presenter.themes" selected="presenter.theme" action="presenter.settings.theme"
						  style_grid_cell_column_pos="1" style_grid_cell_x_align="stretch"
						  style_grid_cell_row_pos="1" style_grid_cell_y_align="center"/>
		<lv_label name="row_label_2" translation_tag="tr.settings.font"
				  style_grid_cell_column_pos="0" style_grid_cell_x_align="end"
				  style_grid_cell_row_pos="2" style_grid_cell_y_align="center"/>
		<settings_dropdown name="font" options="presenter.fonts" selected="presenter.font" action="presenter.settings.font"
						  style_grid_cell_column_pos="1" style_grid_cell_x_align="stretch"
						  style_grid_cell_row_pos="2" style_grid_cell_y_align="center"/>
		<lv_label name="row_label_3" translation_tag="tr.settings.icons"
				  style_grid_cell_column_pos="0" style_grid_cell_x_align="end"
				  style_grid_cell_row_pos="3" style_grid_cell_y_align="center"/>
		<settings_dropdown name="icons" options="presenter.icon_sets" selected="presenter.icon_set" action="presenter.settings.icon_set"
						  style_grid_cell_column_pos="1" style_grid_cell_x_align="stretch"
						  style_grid_cell_row_pos="3" style_grid_cell_y_align="center"/>

		<ds_view name="theme_preview" view="settings_theme_preview" shown="true" height="content"
				 style_grid_cell_column_pos="0" style_grid_cell_column_span="2" style_grid_cell_x_align="stretch"
				 style_grid_cell_row_pos="4" style_grid_cell_y_align="center"/>

		<lv_label name="row_label_5" translation_tag="tr.settings.enable_animations"
				  style_grid_cell_column_pos="0" style_grid_cell_x_align="end"
				  style_grid_cell_row_pos="5" style_grid_cell_y_align="center"/>
		<ds_toggle name="enable_animations"
				   style_grid_cell_column_pos="1" style_grid_cell_x_align="stretch"
				   style_grid_cell_row_pos="5" style_grid_cell_y_align="center">
			<bind_state_if_eq subject="presenter.animations" state="checked" ref_value="1"/>
			<action trigger="value_changed" name="presenter.settings.animations"/>
		</ds_toggle>
		<lv_label name="row_label_6" translation_tag="tr.settings.screen_rotation"
				  style_grid_cell_column_pos="0" style_grid_cell_x_align="end"
				  style_grid_cell_row_pos="6" style_grid_cell_y_align="center"/>
		<settings_dropdown name="screen_rotation" options="presenter.rotations" selected="presenter.rotation" action="presenter.settings.rotation"
						  style_grid_cell_column_pos="1" style_grid_cell_x_align="stretch"
						  style_grid_cell_row_pos="6" style_grid_cell_y_align="center"/>

	</view>
</component>
