<!--
  The theme preview: a swatch of each colour of the theme in use and, for a theme whose palette can be changed, its
  hues (on sliders showing every hue), chroma and dark mode, which change it as they are moved.

  Fields and actions: src/UI/Screens/Settings/ThemePreviewPresenter.h. Values are typed on the shared number pad.
-->
<component presenter="theme_preview">
	<view extends="lv_obj" width="100%" height="content" style_layout="grid"
		  style_grid_column_dsc_array="content fr(1)" style_grid_row_dsc_array="content content content content content">
		<lv_obj name="swatches" width="100%" height="content" flex_flow="column"
				style_grid_cell_column_pos="0" style_grid_cell_column_span="2" style_grid_cell_x_align="stretch"
				style_grid_cell_row_pos="0" style_grid_cell_y_align="center">
			<ds_list name="list" list="swatches" item="theme_swatch" width="100%" height="content" flex_flow="row_wrap"
					 style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="start"/>
		</lv_obj>

		<!-- The palette, if it can be changed -->
		<lv_label name="primary_hue_label" translation_tag="theme.primary_hue"
				  style_grid_cell_column_pos="0" style_grid_cell_x_align="end"
				  style_grid_cell_row_pos="1" style_grid_cell_y_align="center">
			<bind_flag_if_eq subject="controls_shown" flag="hidden" ref_value="0"/>
		</lv_label>
		<ds_hue_slider name="primary_hue_slider" label_tag="theme.primary_hue" label_shown="false" numberpad="true"
					   bind_value="primary_hue" bind_lightness="primary.lightness" bind_chroma="primary.chroma"
					   height="content"
					   style_grid_cell_column_pos="1" style_grid_cell_x_align="stretch"
					   style_grid_cell_row_pos="1" style_grid_cell_y_align="center">
			<bind_flag_if_eq subject="controls_shown" flag="hidden" ref_value="0"/>
			<action trigger="value_confirmed" name="preview.primary_hue"/>
		</ds_hue_slider>

		<lv_label name="secondary_hue_label" translation_tag="theme.secondary_hue"
				  style_grid_cell_column_pos="0" style_grid_cell_x_align="end"
				  style_grid_cell_row_pos="2" style_grid_cell_y_align="center">
			<bind_flag_if_eq subject="controls_shown" flag="hidden" ref_value="0"/>
		</lv_label>
		<ds_hue_slider name="secondary_hue_slider" label_tag="theme.secondary_hue" label_shown="false" numberpad="true"
					   bind_value="secondary_hue" bind_lightness="secondary.lightness"
					   bind_chroma="secondary.chroma" height="content"
					   style_grid_cell_column_pos="1" style_grid_cell_x_align="stretch"
					   style_grid_cell_row_pos="2" style_grid_cell_y_align="center">
			<bind_flag_if_eq subject="controls_shown" flag="hidden" ref_value="0"/>
			<action trigger="value_confirmed" name="preview.secondary_hue"/>
		</ds_hue_slider>

		<lv_label name="chroma_label" translation_tag="theme.chroma"
				  style_grid_cell_column_pos="0" style_grid_cell_x_align="end"
				  style_grid_cell_row_pos="3" style_grid_cell_y_align="center">
			<bind_flag_if_eq subject="controls_shown" flag="hidden" ref_value="0"/>
		</lv_label>
		<ds_slider name="chroma_slider" label_tag="theme.chroma" label_shown="false" numberpad="true" min="0" max="0.4"
				   increment="0.01" bind_value="chroma" value_scale="100" height="content"
				   style_grid_cell_column_pos="1" style_grid_cell_x_align="stretch"
				   style_grid_cell_row_pos="3" style_grid_cell_y_align="center">
			<bind_flag_if_eq subject="controls_shown" flag="hidden" ref_value="0"/>
			<action trigger="value_confirmed" name="preview.chroma"/>
		</ds_slider>

		<lv_label name="dark_mode_label" translation_tag="theme.dark_mode"
				  style_grid_cell_column_pos="0" style_grid_cell_x_align="end"
				  style_grid_cell_row_pos="4" style_grid_cell_y_align="center">
			<bind_flag_if_eq subject="controls_shown" flag="hidden" ref_value="0"/>
		</lv_label>
		<ds_toggle name="dark_mode"
				   style_grid_cell_column_pos="1" style_grid_cell_x_align="start"
				   style_grid_cell_row_pos="4" style_grid_cell_y_align="center">
			<bind_flag_if_eq subject="controls_shown" flag="hidden" ref_value="0"/>
			<bind_state_if_eq subject="dark" state="checked" ref_value="1"/>
			<action trigger="value_changed" name="preview.dark"/>
		</ds_toggle>
	</view>
</component>
