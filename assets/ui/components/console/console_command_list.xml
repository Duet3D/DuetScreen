<!--
  The G-code reference as a list: every G-code and what it does. It is the `console_command_list` widget, with a
  console presenter of its own; the console page shows the same rows in its reference dialog (console.xml).

  Fields and actions: src/UI/Presenters/Console/ConsolePresenter.h
-->
<component presenter="console">
	<view extends="lv_obj" width="100%" height="100%" flex_flow="column">
		<style name="card"/>
		<ds_list name="list" list="presenter.gcodes" item="console_gcode" windowed="true" item_height="44"
				 width="100%" flex_grow="1"/>
	</view>
</component>
