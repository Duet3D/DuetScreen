<!--
  One line of the console: when it arrived, then the command sent (emphasised) or the response.

  Fields:   a source.console.lines row: row.time, row.command, row.text (src/UI/Xml/Data/ConsoleSource.h)
-->
<component>
	<view extends="lv_spangroup" width="100%" height="content">
		<lv_spangroup-span bind_text="row.time" style="text_muted"/>
		<lv_spangroup-span bind_text="row.command" style="text_emphasis"/>
		<lv_spangroup-span bind_text="row.text" style="text"/>

		<action trigger="single_clicked" name="actions.navigation.open" arg="console"/>
	</view>
</component>
