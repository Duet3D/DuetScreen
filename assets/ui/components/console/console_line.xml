<!--
  One line of the console: when it arrived, then the command sent (emphasised), or the response or message. A line
  that reports an outcome is marked by its kind: a success edged, a warning or error edged and tinted.

  Fields:   a source.console.lines row: row.time, row.kind, row.text (src/UI/Xml/Data/ConsoleSource.h)
-->
<component>
	<view extends="lv_obj" width="100%" height="content" flex_flow="row" scrollable="false">
		<style name="console_line"/>
		<bind_style name="console_line_command" subject="row.kind" ref_value="1"/>
		<bind_style name="console_line_success" subject="row.kind" ref_value="2"/>
		<bind_style name="console_line_warning" subject="row.kind" ref_value="3"/>
		<bind_style name="console_line_error" subject="row.kind" ref_value="4"/>
		<action trigger="single_clicked" name="actions.navigation.open" arg="console"/>

		<lv_label name="time" bind_text="row.time" clickable="false">
			<style name="console_time"/>
		</lv_label>
		<lv_label name="text" bind_text="row.text" flex_grow="1" clickable="false"/>
	</view>
</component>
