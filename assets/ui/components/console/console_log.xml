<!--
  The console's latest lines, in a card, following the newest: the `console_log` widget (widgets/console/
  console_log.json). Tap it to open the console.

  Data:     the global console.lines (src/UI/Xml/Data/ConsoleSource.h)
-->
<component>
	<view extends="lv_obj" width="100%" height="100%" scrollable="false" flex_flow="column">
		<style name="card"/>
		<action trigger="clicked" name="actions.navigation.open" arg="console"/>
		<lv_label name="title" translation_tag="tr.side_bar.console" width="100%" long_mode="dots" clickable="false">
			<style name="widget_title"/>
		</lv_label>
		<ds_list name="output" list="console.lines" item="console_line" follow_end="true" width="100%" flex_grow="1"
				 flex_flow="column" style_pad_all="0" style_pad_row="0" clickable="false"/>
	</view>
</component>
