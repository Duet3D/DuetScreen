<!--
  A line showing what a widget the user drags has snapped to (an edge of another widget, or of the area), while
  customising a free layout. <ds_layout> places and sizes it (see src/UI/Xml/Layout/Snap.h).
-->
<component>
	<styles>
		<style name="guide" bg_color="#highlight" bg_opa="100%" radius="0" border_width="0" pad_all="0"/>
	</styles>

	<view extends="lv_obj" clickable="false" scrollable="false">
		<style name="guide"/>
	</view>
</component>
