<!--
  The edit overlay over each widget of a grid while the user customises the screen: as customise_item.xml, with a
  handle in the corner of the selected widget that resizes it when dragged. <ds_layout> finds the handle by its name.
-->
<component>
	<api>
		<prop name="key" type="string"/>
	</api>

	<styles>
		<style name="handle" bg_color="#highlight" bg_opa="100%" radius="#radius" pad_all="0"/>
	</styles>

	<view extends="customise_item" key="$key">
		<lv_obj name="handle" width="40" height="40" align="bottom_right" clickable="false" scrollable="false">
			<style name="handle"/>
			<bind_flag_if_not_eq subject="customise.selected" flag="hidden" ref_value="$key"/>
		</lv_obj>
	</view>
</component>
