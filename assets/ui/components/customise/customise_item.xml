<!--
  The edit overlay <ds_layout> puts over each widget of a strip while the user customises the screen: it takes the
  widget's touches (a tap selects it, a drag moves it along the strip) and shows whether it is selected. `key` is the
  value customise.selected has while it is (see src/UI/Xml/Data/CustomiseSource.h).
-->
<component>
	<api>
		<prop name="key" type="string"/>
	</api>

	<styles>
		<style name="frame" bg_color="#highlight" bg_opa="15%" radius="#radius"/>
		<style name="chosen" bg_opa="30%"/>
	</styles>

	<view extends="lv_obj" scrollable="false">
		<style name="frame"/>
		<style name="border_highlight"/>
		<style name="chosen" selector="checked"/>
		<bind_state_if_eq subject="customise.selected" state="checked" ref_value="$key"/>
	</view>
</component>
