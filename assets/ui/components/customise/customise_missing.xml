<!--
  Stands in for a placed widget that isn't installed (its bundle was removed), keeping its place in the layout until
  the bundle is back or the user removes it. `widget` is the missing widget's id.
-->
<component>
	<api>
		<prop name="widget" type="string" default="?"/>
	</api>

	<view extends="lv_obj" flex_flow="column" style_flex_main_place="center" style_flex_cross_place="center">
		<style name="card"/>
		<lv_label translation_tag="customise.missing" long_mode="wrap" width="100%" style_text_align="center"/>
		<lv_label text="$widget" long_mode="dots" width="100%" style_text_align="center"/>
	</view>
</component>
