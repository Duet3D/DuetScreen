<!--
  Customising the screen: the toolbar shown while the user customises, and its dialogs. The home screen hosts it over
  the pages, sidebar and status bar; it lets touches through but on its bar, which hides while one of its dialogs is
  open.

  The bar floats at the bottom of the screen until the user drags it by its grip, on its left, to wherever it is out
  of the way. It adds a widget where the user chose (the widget pool), changes the selected widget's settings, removes
  it, turns snapping on or off, undoes, resets the slot to its default, saves the layouts under a name (asked for) or
  loads a saved one, and ends customising, throwing the changes away or keeping them. Saved layouts are files in the
  screen's user folder (src/UI/Xml/Layout/LayoutLibrary.h). Widgets are selected, moved and resized on the screen
  itself (see src/UI/Widgets/Layout/DsLayout.h).

  Data:     source.customise.* (src/UI/Xml/Data/CustomiseSource.h)
  Fields and actions: src/UI/Presenters/Customise/CustomisePresenter.h
-->
<component presenter="customise">
	<!-- The view itself is always shown (navigation owns its hidden flag); what is in it shows while customising -->
	<view extends="lv_obj" width="100%" height="100%" floating="true" clickable="false" scrollable="false">
		<style name="pad_zero"/>

		<lv_obj name="toolbar" width="100%" height="100%" clickable="false" scrollable="false" flex_flow="column"
				style_flex_main_place="end" style_flex_cross_place="center" style_flex_track_place="center">
		<style name="pad_small"/>
		<bind_flag_if_eq subject="source.customise.editing" flag="hidden" ref_value="0"/>

		<lv_obj name="bar" width="content" height="content" scrollable="false" flex_flow="row"
				style_flex_cross_place="center" style_pad_column="#pad_small">
			<style name="card"/>
			<!-- Out of the way while any of its dialogs is open -->
			<bind_flag_if cond="presenter.catalogue_open eq 1 or presenter.settings_open eq 1 or presenter.save_open eq 1 or presenter.load_open eq 1"
						  flag="hidden"/>
			<!-- The grip: dragging it moves the bar -->
			<ds_move_handle name="grip" width="content" height="content" style_pad_all="0">
				<ds_icon name="grip_icon" icon="drag.png" width="32" height="48" clickable="false"/>
			</ds_move_handle>
			<ds_button name="add" translation_tag="tr.customise.add" icon="increment.png">
				<action trigger="clicked" name="actions.customise.open_catalogue"/>
			</ds_button>
			<ds_button name="configure" translation_tag="tr.customise.configure" icon="settings.png">
				<bind_state_if_eq subject="source.customise.can_configure" state="disabled" ref_value="0"/>
				<action trigger="clicked" name="presenter.customise.configure"/>
			</ds_button>
			<ds_button name="remove" translation_tag="tr.customise.remove" icon="delete.png">
				<bind_state_if_eq subject="source.customise.can_remove" state="disabled" ref_value="0"/>
				<action trigger="clicked" name="presenter.customise.remove"/>
			</ds_button>
			<!-- Checked while dragged widgets snap to the edges near them -->
			<ds_button name="snap" translation_tag="tr.customise.snap" icon="snap.png">
				<bind_flag_if_eq subject="source.customise.is_free" flag="hidden" ref_value="0"/>
				<bind_state_if_eq subject="source.customise.snap" state="checked" ref_value="1"/>
				<action trigger="clicked" name="presenter.customise.snap"/>
			</ds_button>
			<ds_button name="undo" translation_tag="tr.customise.undo" icon="undo.png">
				<bind_state_if_eq subject="source.customise.can_undo" state="disabled" ref_value="0"/>
				<action trigger="clicked" name="presenter.customise.undo"/>
			</ds_button>
			<ds_button name="reset" translation_tag="tr.customise.reset" icon="reset.png">
				<action trigger="clicked" name="presenter.customise.reset"/>
			</ds_button>
			<ds_button name="save" translation_tag="tr.customise.save" icon="save.png">
				<bind_state_if_eq subject="presenter.can_save" state="disabled" ref_value="0"/>
				<action trigger="clicked" name="presenter.customise.save"/>
			</ds_button>
			<ds_button name="load" translation_tag="tr.customise.load" icon="open.png">
				<action trigger="clicked" name="presenter.customise.load"/>
			</ds_button>
			<ds_button name="cancel" translation_tag="tr.common.cancel" icon="close.png">
				<action trigger="clicked" name="presenter.customise.cancel"/>
			</ds_button>
			<ds_button name="done" translation_tag="tr.customise.done" icon="done.png">
				<style name="action_btn"/>
				<action trigger="clicked" name="presenter.customise.done"/>
			</ds_button>
		</lv_obj>
		</lv_obj>

		<!-- The widget pool: the widgets that can go where the user chose, by category -->
		<ds_dialog name="catalogue_dialog" bind_open="presenter.catalogue_open" title_tag="tr.customise.add_title"
				   width="70%" height="80%" flex_flow="column">
			<ds_list name="list" list="presenter.catalogue" item="customise_catalogue_category" width="100%" flex_grow="1"
					 flex_flow="column"/>
		</ds_dialog>

		<!-- The selected widget's settings. Text is typed in place; a number or a choice is the next step. -->
		<ds_dialog name="settings_dialog" bind_open="presenter.settings_open" bind_title="source.customise.title"
				   flex_flow="column">
			<ds_list name="list" list="presenter.settings" item="customise_setting" width="100%" height="content"
					 flex_flow="column" style_pad_row="0"/>
			<ds_dialog_footer name="footer">
				<ds_button name="done" translation_tag="tr.customise.done">
					<style name="dialog_button"/>
					<style name="action_btn"/>
					<action trigger="clicked" name="actions.dialog.close"/>
				</ds_button>
			</ds_dialog_footer>
		</ds_dialog>

		<!-- Saving: the name to save the layouts as -->
		<ds_dialog name="save_dialog" bind_open="presenter.save_open" title_tag="tr.customise.save_title"
				   flex_flow="column">
			<ds_textarea name="name" bind_text="presenter.save_name" one_line="true" width="100%"
						 placeholder_tag="tr.customise.name_hint">
				<action trigger="value_changed" name="presenter.customise.save_name"/>
				<action trigger="ready" name="presenter.customise.save_ok"/>
			</ds_textarea>
			<lv_label name="problem" bind_text="presenter.save_problem" width="100%" long_mode="wrap">
				<style name="text_warning"/>
				<bind_flag_if_eq subject="presenter.save_problem" flag="hidden" ref_value=""/>
			</lv_label>
			<ds_dialog_footer name="footer">
				<ds_button name="cancel" translation_tag="tr.common.cancel">
					<style name="dialog_button"/>
					<action trigger="clicked" name="actions.dialog.close"/>
				</ds_button>
				<ds_button name="ok" translation_tag="tr.customise.save">
					<style name="dialog_button"/>
					<style name="action_btn"/>
					<action trigger="clicked" name="presenter.customise.save_ok"/>
				</ds_button>
			</ds_dialog_footer>
		</ds_dialog>

		<!-- Loading: the saved layouts; deleting one asks first, the next step -->
		<ds_dialog name="load_dialog" bind_open="presenter.load_open" title_tag="tr.customise.saved_title"
				   flex_flow="column">
			<lv_label name="none" translation_tag="tr.customise.none_saved" width="100%" long_mode="wrap">
				<bind_flag_if_eq subject="presenter.has_saved" flag="hidden" ref_value="1"/>
			</lv_label>
			<ds_list name="list" list="presenter.saved" item="customise_saved_layout" width="100%" height="content"
					 flex_flow="column" style_pad_row="0"/>
		</ds_dialog>
	</view>
</component>
