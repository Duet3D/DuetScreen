<!--
  Marks the empty place the user tapped in a free layout while customising: a new widget goes there, or as near as
  there is room. Tapping it opens the widget pool.
-->
<component>
	<styles>
		<style name="place" bg_color="#highlight" bg_opa="30%" radius="#radius"/>
	</styles>

	<view extends="lv_obj" scrollable="false">
		<style name="place"/>
		<style name="border_highlight"/>
		<lv_label name="plus" text="+" align="center" style_text_font="font_header"/>
		<action trigger="clicked" name="customise.open_catalogue"/>
	</view>
</component>
