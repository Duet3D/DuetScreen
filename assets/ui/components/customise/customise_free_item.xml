<!--
  The edit overlay over each widget of a free layout while the user customises the screen: as customise_item.xml, with
  crop-tool handles on the selected widget: a bracket on each corner (customise_corner_handle.xml) and a bar on each
  edge (customise_edge_handle.xml). They show where to drag: <ds_layout> resizes the widget from a drag that starts
  anywhere near an edge or corner (see DsLayout.h), so they needn't be hit exactly.
-->
<component>
	<api>
		<prop name="key" type="string"/>
	</api>

	<view extends="customise_item" key="$key">
		<customise_corner_handle name="handle_nw" key="$key" corner="top_left"/>
		<customise_corner_handle name="handle_ne" key="$key" corner="top_right"/>
		<customise_corner_handle name="handle_se" key="$key" corner="bottom_right"/>
		<customise_corner_handle name="handle_sw" key="$key" corner="bottom_left"/>
		<customise_edge_handle name="handle_n" key="$key" edge="top_mid"/>
		<customise_edge_handle name="handle_s" key="$key" edge="bottom_mid"/>
		<customise_edge_handle name="handle_e" key="$key" edge="right_mid" width="24" height="48" bar_width="5"
							   bar_height="32"/>
		<customise_edge_handle name="handle_w" key="$key" edge="left_mid" width="24" height="48" bar_width="5"
							   bar_height="32"/>
	</view>
</component>
