<!--
  One of the values a setting can take, checked if it is the current one. Tapping it chooses it.

  Fields:   an options row: row.value, row.title, row.chosen (src/UI/Presenters/Customise/CustomisePresenter.h)
-->
<component>
	<view extends="lv_obj" width="100%" height="content" scrollable="false">
		<style name="pad_zero"/>
		<ds_button name="option" bind_text="row.title" width="100%">
			<bind_state_if_eq subject="row.chosen" state="checked" ref_value="1"/>
			<action trigger="clicked" name="presenter.customise.choose"/>
		</ds_button>
	</view>
</component>
