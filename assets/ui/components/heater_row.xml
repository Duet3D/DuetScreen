<!--
  One heater: its name, its state (tap to cycle active, standby and off), its temperature, and its active and standby
  targets (tap to set). The state can't be changed while printing.

  Fields:   a heater row: heater, name, state, status, current, active, standby (src/UI/Xml/Data/HeaterRow.h)
-->
<component>
	<view extends="lv_obj" width="100%" height="content" flex_flow="row" style_text_align="center"
		  style_flex_main_place="space_between" style_flex_cross_place="center" style_flex_track_place="center">
		<style name="tool_list_heater"/>

		<lv_label name="label" bind_text="name" flex_grow="3" style_text_align="left"/>

		<ds_button name="status" bind_text="status" flex_grow="3">
			<style name="border_color_card" selector="checked"/>
			<style name="actionBtn"/>
			<bind_state_if_eq subject="machine.printing" state="disabled" ref_value="1"/>
			<action trigger="clicked" name="heaters.toggle"/>
		</ds_button>

		<lv_label name="current" bind_text="current" flex_grow="2"/>

		<ds_button name="active" bind_text="active" flex_grow="2">
			<style name="input"/>
			<action trigger="clicked" name="heaters.set_active"/>
		</ds_button>

		<ds_button name="standby" bind_text="standby" flex_grow="2">
			<style name="input"/>
			<action trigger="clicked" name="heaters.set_standby"/>
		</ds_button>
	</view>
</component>
