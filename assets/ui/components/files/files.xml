<!--
  The Files page: macros and jobs in tabs. While there is a job the Jobs tab is disabled, so the job can't be replaced.

  Each tab is a file browser with settings of its own (src/UI/Presenters/Presenters.cpp).
-->
<component>
	<view extends="lv_obj" width="100%" height="100%" style_pad_all="0">
		<ds_tabs name="tabs" side="left" tab_max_width="200" width="100%" height="100%">
			<style name="bg_dark"/>

			<ds_tabs-tab name="macros" icon="macros.png" title_tag="tr.file.macros">
				<ds_view name="files_macros" view="file_browser" presenter="files_macros" shown="true"/>
			</ds_tabs-tab>
			<ds_tabs-tab name="jobs" icon="job.png" title_tag="tr.file.jobs" bind_disabled="source.machine.job_active">
				<ds_view name="files_jobs" view="file_browser" presenter="files_jobs" shown="true"/>
			</ds_tabs-tab>
		</ds_tabs>
	</view>
</component>
