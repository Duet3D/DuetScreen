<!--
  One preset of a value selector, shown checked while it is the value chosen. Tap to use it; hold to change it.

  Fields:   a source.<selector>.choices row: row.text, row.selected (src/UI/Xml/View/ValueSelector.h)
  Actions:  actions.selector.pick, actions.selector.edit_choice (src/UI/Xml/View/SelectorActions.h)
-->
<component>
	<api>
		<!-- How the preset is written, e.g. "%s mm" (item.format on the list) -->
		<prop name="format" type="string" default="%s"/>
	</api>
	<view extends="ds_button" bind_text="row.text" bind_text-fmt="$format" height="100%" flex_grow="1"
		  style_min_height="content">
		<style name="long_press"/>
		<bind_state_if_eq subject="row.selected" state="checked" ref_value="1"/>
		<action trigger="clicked" name="actions.selector.pick"/>
		<action trigger="long_pressed" name="actions.selector.edit_choice"/>
	</view>
</component>
