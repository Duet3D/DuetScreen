<!--
  One babystep size. Tap to use it; hold to change it.

  Fields:   a steps row: text, selected (src/UI/Presenters/Common/BabyStepPresenter.h)
-->
<component>
	<view extends="ds_button" bind_text="text" long_mode="wrap" width="0" height="100%" flex_grow="1"
		  style_min_height="content">
		<bind_state_if_eq subject="selected" state="checked" ref_value="1"/>
		<action trigger="clicked" name="babystep.select"/>
		<action trigger="long_pressed" name="babystep.edit"/>
	</view>
</component>
