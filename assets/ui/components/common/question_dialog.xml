<!--
  A yes-or-no question with a title and text from subjects, over the widget it is written in, open while the
  subject named by `open` is non-zero.

      <question_dialog open="confirm" title="confirm_title" text="confirm_text"
                       confirm="move.confirm" close="move.close_dialog"/>

  `confirm` is raised by Yes; `close` by No, or when the question is closed any other way.
-->
<component>
	<api>
		<prop name="open" type="string"/>
		<prop name="title" type="string"/>
		<prop name="text" type="string"/>
		<prop name="confirm" type="string"/>
		<prop name="close" type="string"/>
	</api>

	<view extends="ds_modal" in_place="true" bind_open="$open" width="70%" height="content" flex_flow="column">
		<action trigger="dismissed" name="$close"/>

		<lv_obj name="header" width="100%" height="content" flex_flow="row">
			<style name="bg_color_header"/>
			<style name="text_header"/>
			<lv_label name="title" bind_text="$title"/>
		</lv_obj>

		<lv_obj name="body" width="100%" height="content" flex_flow="column">
			<lv_obj name="body_top" width="100%" height="content" flex_flow="row" style_pad_all="0">
				<lv_obj name="body_text" height="content" flex_grow="1" flex_flow="column" style_text_align="center"
						style_flex_main_place="start" style_flex_cross_place="center" style_flex_track_place="center">
					<lv_label name="text" bind_text="$text" width="100%"/>
				</lv_obj>
			</lv_obj>
		</lv_obj>

		<lv_obj name="pad" width="100%" flex_grow="1"/>

		<lv_obj name="footer" width="100%" height="content" flex_flow="row">
			<ds_button name="cancel" translation_tag="common.no" height="content" flex_grow="1">
				<action trigger="clicked" name="$close"/>
			</ds_button>
			<ds_button name="ok" translation_tag="common.yes" height="content" flex_grow="1">
				<style name="actionBtn"/>
				<action trigger="clicked" name="$confirm"/>
			</ds_button>
		</lv_obj>
	</view>
</component>
