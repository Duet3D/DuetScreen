<!--
  Babystepping: nudge Z up or down by the chosen step while printing, or reset. Hold a step to change its size.

  Data:     source.babystep.* (src/UI/Xml/Data/BabystepSource.h), shared by every babystepping panel
  Actions:  actions.babystep.* (src/UI/Presenters/Common/BabystepActions.h); actions.selector.* for the step sizes,
            typed on the shared number pad
-->
<component>
	<api>
		<!-- true where something else titles it already, e.g. its dialog -->
		<prop name="hide_title" type="bool" default="false"/>
	</api>
	<view extends="lv_obj" flex_flow="column"
		  style_flex_main_place="start" style_flex_cross_place="center" style_flex_track_place="center">
		<lv_label name="header" translation_tag="tr.babystep.header" hidden="$hide_title"/>

		<lv_obj name="button_panel" width="100%" flex_grow="1" flex_flow="column"
				style_flex_main_place="start" style_flex_cross_place="center" style_flex_track_place="center">
			<ds_button name="reset" bind_text="source.babystep.reset_text" width="100%" flex_grow="1" style_min_height="content">
				<style name="action_btn"/>
				<bind_state_if_eq subject="source.babystep.usable" state="disabled" ref_value="0"/>
				<action trigger="clicked" name="actions.babystep.reset"/>
			</ds_button>
			<ds_button name="increment" icon="babystep_increment.png" width="100%" flex_grow="3">
				<style name="action_btn"/>
				<bind_state_if_eq subject="source.babystep.usable" state="disabled" ref_value="0"/>
				<action trigger="clicked" name="actions.babystep.up"/>
			</ds_button>
			<ds_button name="decrement" icon="babystep_decrement.png" width="100%" flex_grow="3">
				<style name="action_btn"/>
				<bind_state_if_eq subject="source.babystep.usable" state="disabled" ref_value="0"/>
				<action trigger="clicked" name="actions.babystep.down"/>
			</ds_button>
			<ds_list name="value_list" list="source.babystep.step.choices" item="value_selector_choice" item.format="%s mm"
					 item.long_mode="wrap" item.width="0" width="100%" flex_grow="2"
					 style_min_height="content" flex_flow="row" style_pad_all="0"
					 style_flex_main_place="start" style_flex_cross_place="start" style_flex_track_place="start"/>
		</lv_obj>
	</view>
</component>
