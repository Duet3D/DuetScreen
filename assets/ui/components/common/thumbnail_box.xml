<!--
  A job's thumbnail, scaled to fit a box and centred in it. The box keeps its room while there is no thumbnail, so
  what is beside it stays lined up. Give it a size; it lets taps through to what it is in.

      <thumbnail_box name="picture" src="source.job.thumbnail" width="40" height="40"/>

  Props:    src  the name of the thumbnail's path, e.g. `source.job.thumbnail` or `row.thumbnail`
-->
<component>
	<api>
		<prop name="src" type="string"/>
	</api>
	<view extends="lv_obj" flex_flow="row" scrollable="false" clickable="false" style_flex_main_place="center"
		  style_flex_cross_place="center" style_flex_track_place="center">
		<style name="pad_zero"/>
		<ds_thumbnail name="thumbnail" bind_src="$src" inner_align="contain" height="100%" style_max_width="100%"/>
	</view>
</component>
