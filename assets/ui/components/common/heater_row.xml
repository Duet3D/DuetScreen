<!--
  One heater as a row: its colour key on the temperature graph (tap to show or hide its line), its name, its state
  (tap to cycle active, standby and off; coloured as the gauges colour it; not while printing), its temperature, and
  its active and standby targets (tap to set one). A row whose heater doesn't exist isn't shown.

      <heater_row label="…" active="…|format:tr.units.degrees" standby="…|format:tr.units.degrees"/>

  Props:    label, active, standby: the names of its name and its two targets, which a tool's heater and a bed's
            differ in (tools_tool_heater.xml, tools_bed_heater.xml)
  Fields:   a row whose row.value is the heater number: a row of a tool's heaters, or of om.heat.bedHeaters or
            chamberHeaters; its state and temperature are om.heat.heaters[{row.value}]
  Actions:  actions.heater.* (src/UI/Presenters/Control/Temperature/HeaterActions.h), from the row
-->
<component>
	<api>
		<prop name="label" type="string"/>
		<prop name="active" type="string"/>
		<prop name="standby" type="string"/>
	</api>
	<view extends="lv_obj" height="content" flex_flow="row" scrollable="false"
		  style_flex_cross_place="center" style_flex_track_place="center">
		<style name="setting_row"/>
		<bind_flag_if cond="row.value|int lt 0" flag="hidden"/>
		<!-- The graph's series are its heaters' sensors (source.temperature.temperatures) -->
		<ds_graph_key name="graph_key" history="source.temperature.temperatures"
					  bind_key="om.heat.heaters[{row.value}].sensor|int"/>
		<lv_label name="label" bind_text="$label" flex_grow="1" long_mode="dots">
			<style name="setting_title"/>
		</lv_label>
		<ds_button name="state" bind_text="om.heat.heaters[{row.value}].state|translate:tr.temperature.status" width="96"
				   height="content" style_min_height="36">
			<style name="action_btn"/>
			<bind_style_if_eq name="heater_standby" subject="om.heat.heaters[{row.value}].state" ref_value="standby"/>
			<bind_style_if_eq name="heater_off" subject="om.heat.heaters[{row.value}].state" ref_value="off"/>
			<bind_style_if_eq name="heater_fault" subject="om.heat.heaters[{row.value}].state" ref_value="fault"/>
			<bind_state_if_eq subject="source.machine.printing" state="disabled" ref_value="1"/>
			<action trigger="clicked" name="actions.heater.toggle"/>
		</ds_button>
		<lv_label name="current" bind_text="om.heat.heaters[{row.value}].current|fixed:1" width="76"
				  style_text_align="right">
			<style name="reading"/>
		</lv_label>
		<!-- Each target: what it is over its value, tap to set it -->
		<lv_obj name="active" width="84" height="content" flex_flow="column" scrollable="false"
				style_flex_cross_place="center" style_flex_track_place="center">
			<style name="btn"/>
			<style name="pressed" selector="pressed"/>
			<action trigger="clicked" name="actions.heater.set_active"/>
			<lv_label name="title" translation_tag="tr.tools.active" clickable="false">
				<style name="text_muted"/>
			</lv_label>
			<lv_label name="value" bind_text="$active" clickable="false"/>
		</lv_obj>
		<lv_obj name="standby" width="84" height="content" flex_flow="column" scrollable="false"
				style_flex_cross_place="center" style_flex_track_place="center">
			<style name="btn"/>
			<style name="pressed" selector="pressed"/>
			<action trigger="clicked" name="actions.heater.set_standby"/>
			<lv_label name="title" translation_tag="tr.tools.standby" clickable="false">
				<style name="text_muted"/>
			</lv_label>
			<lv_label name="value" bind_text="$standby" clickable="false"/>
		</lv_obj>
	</view>
</component>
