<!--
  One file or folder in the file browser's list, a row as the job widget's are (job_recent_row.xml): its picture, then
  its name over its detail (its job's time and filament, else its date and size). A file's picture is its thumbnail, or
  a file icon until it has one; a folder's is a folder icon in the accent colour, and a chevron ends its row. Tap it to
  open it. The list sets its size.

  Fields:   a files row: row.name, row.detail, row.thumbnail, row.is_folder
            (src/UI/Presenters/FileBrowser/FileBrowserPresenter.h)
-->
<component>
	<view extends="lv_obj" width="100%" height="64" flex_flow="row" scrollable="false" style_radius="#radius"
		  style_flex_cross_place="center" style_flex_track_place="center">
		<style name="setting_row"/>
		<style name="pressed" selector="pressed"/>
		<action trigger="clicked" name="presenter.files.open"/>

		<file_browser_picture name="picture" width="48" height="48"/>
		<lv_obj name="about" width="1" height="content" flex_grow="1" flex_flow="column" scrollable="false"
				clickable="false" style_pad_all="0">
			<lv_label name="label" bind_text="row.name" width="100%" long_mode="dots">
				<style name="setting_title"/>
			</lv_label>
			<lv_label name="detail" bind_text="row.detail" width="100%" long_mode="dots">
				<style name="setting_hint"/>
			</lv_label>
		</lv_obj>
		<chevron name="chevron">
			<bind_flag_if_eq subject="row.is_folder" flag="hidden" ref_value="0"/>
		</chevron>
	</view>
</component>
