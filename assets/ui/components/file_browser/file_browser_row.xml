<!--
  One file or folder in the file browser's list: its name and date, with the file's thumbnail or a folder icon on the
  right. Tap to open it. The list sets its size.

  Fields:   a files row: name, date, thumbnail, is_folder (src/UI/Screens/File/FileBrowserPresenter.h)
-->
<component>
	<view extends="lv_obj" width="100%" height="90" scrollable="false" style_layout="grid"
		  style_grid_column_dsc_array="fr(3) content" style_grid_row_dsc_array="content fr(1) content content">
		<style name="file"/>
		<style name="folder" selector="checked"/>
		<bind_state_if_eq subject="is_folder" state="checked" ref_value="1"/>
		<action trigger="clicked" name="files.open"/>

		<!-- Room for a thumbnail is kept while it loads, so the text doesn't move when it arrives -->
		<lv_obj name="thumb_box" width="72" height="72" style_pad_all="0" scrollable="false"
				style_grid_cell_column_pos="1" style_grid_cell_column_span="1" style_grid_cell_x_align="end"
				style_grid_cell_row_pos="0" style_grid_cell_row_span="4" style_grid_cell_y_align="start">
			<bind_flag_if_eq subject="is_folder" flag="hidden" ref_value="1"/>
			<lv_image name="thumb" bind_src="thumbnail" inner_align="contain" width="100%" height="100%">
				<bind_flag_if_eq subject="thumbnail" flag="hidden" ref_value=""/>
			</lv_image>
		</lv_obj>
		<ds_icon name="folder_icon" icon="folder.png" width="72" height="72"
				 style_grid_cell_column_pos="1" style_grid_cell_column_span="1" style_grid_cell_x_align="end"
				 style_grid_cell_row_pos="0" style_grid_cell_row_span="4" style_grid_cell_y_align="start">
			<bind_flag_if_eq subject="is_folder" flag="hidden" ref_value="0"/>
		</ds_icon>
		<lv_label name="label" bind_text="name" width="100%" height="content" long_mode="dots"
				  style_text_align="left"
				  style_grid_cell_column_pos="0" style_grid_cell_column_span="1" style_grid_cell_x_align="stretch"
				  style_grid_cell_row_pos="0" style_grid_cell_row_span="1" style_grid_cell_y_align="start">
			<style name="text_emphasis" selector="checked"/>
			<bind_state_if_eq subject="is_folder" state="checked" ref_value="1"/>
		</lv_label>
		<lv_label name="date" bind_text="date"
				  style_grid_cell_column_pos="0" style_grid_cell_column_span="1" style_grid_cell_x_align="stretch"
				  style_grid_cell_row_pos="3" style_grid_cell_row_span="1" style_grid_cell_y_align="end">
			<style name="text_muted"/>
		</lv_label>
	</view>
</component>
