<!--
  The file browser's dialog: start a job (with its details and thumbnail, and an offer to delete it instead: a
  question, the next step), or run a macro. Open while `dialog` is set.

  Fields and actions: dialog, dialog_*, info_*; files.confirm, files.ask_delete, files.close_dialog
  (src/UI/Presenters/FileBrowser/FileBrowserPresenter.h)
-->
<component>
	<styles>
		<!-- With a thumbnail beside it, the text lines up on the left -->
		<style name="beside_image" text_align="left"/>
	</styles>

	<view extends="ds_dialog" name="file_browser_dialog" bind_open="presenter.dialog" bind_title="presenter.dialog_title"
		  flex_flow="column">
		<action trigger="dismissed" name="presenter.files.close_dialog"/>

		<lv_obj name="body" width="100%" height="content" flex_flow="column">
			<lv_obj name="body_top" width="100%" height="content" flex_flow="row" style_pad_all="0">
				<lv_obj name="body_text" height="content" flex_grow="1" flex_flow="column" style_text_align="center"
						style_flex_main_place="start" style_flex_cross_place="center" style_flex_track_place="center">
					<bind_style name="beside_image" subject="presenter.dialog_has_image" ref_value="1"/>
					<lv_label name="text" bind_text="presenter.dialog_text" width="100%"/>

					<!-- The job's details -->
					<lv_obj name="file_info_cont" width="100%" height="content" style_layout="grid"
							style_grid_column_dsc_array="content fr(1)"
							style_grid_row_dsc_array="content content content content content content">
						<bind_flag_if_eq subject="presenter.info_shown" flag="hidden" ref_value="0"/>

						<lv_label translation_tag="tr.file.start_print.date" style_grid_cell_column_pos="0"
								  style_grid_cell_x_align="start" style_grid_cell_row_pos="0" style_grid_cell_y_align="start">
							<style name="text_muted"/>
						</lv_label>
						<lv_label bind_text="presenter.info_date" style_grid_cell_column_pos="1" style_grid_cell_x_align="stretch"
								  style_grid_cell_row_pos="0" style_grid_cell_y_align="start"/>

						<lv_label translation_tag="tr.file.start_print.size" style_grid_cell_column_pos="0"
								  style_grid_cell_x_align="start" style_grid_cell_row_pos="1" style_grid_cell_y_align="start">
							<style name="text_muted"/>
						</lv_label>
						<lv_label bind_text="presenter.info_size" style_grid_cell_column_pos="1" style_grid_cell_x_align="stretch"
								  style_grid_cell_row_pos="1" style_grid_cell_y_align="start"/>

						<lv_label translation_tag="tr.file.start_print.generated_by" style_grid_cell_column_pos="0"
								  style_grid_cell_x_align="start" style_grid_cell_row_pos="2" style_grid_cell_y_align="start">
							<style name="text_muted"/>
						</lv_label>
						<lv_label bind_text="presenter.info_generated_by" style_grid_cell_column_pos="1"
								  style_grid_cell_x_align="stretch" style_grid_cell_row_pos="2"
								  style_grid_cell_y_align="start"/>

						<lv_label translation_tag="tr.file.start_print.print_time" style_grid_cell_column_pos="0"
								  style_grid_cell_x_align="start" style_grid_cell_row_pos="3" style_grid_cell_y_align="start">
							<style name="text_muted"/>
						</lv_label>
						<lv_label bind_text="presenter.info_print_time" style_grid_cell_column_pos="1"
								  style_grid_cell_x_align="stretch" style_grid_cell_row_pos="3"
								  style_grid_cell_y_align="start"/>

						<lv_label translation_tag="tr.file.start_print.height" style_grid_cell_column_pos="0"
								  style_grid_cell_x_align="start" style_grid_cell_row_pos="4" style_grid_cell_y_align="start">
							<style name="text_muted"/>
						</lv_label>
						<lv_label bind_text="presenter.info_height" style_grid_cell_column_pos="1" style_grid_cell_x_align="stretch"
								  style_grid_cell_row_pos="4" style_grid_cell_y_align="start"/>

						<lv_label translation_tag="tr.file.start_print.layer_height" style_grid_cell_column_pos="0"
								  style_grid_cell_x_align="start" style_grid_cell_row_pos="5" style_grid_cell_y_align="start">
							<style name="text_muted"/>
						</lv_label>
						<lv_label bind_text="presenter.info_layer_height" style_grid_cell_column_pos="1"
								  style_grid_cell_x_align="stretch" style_grid_cell_row_pos="5"
								  style_grid_cell_y_align="start"/>
					</lv_obj>
				</lv_obj>

				<lv_image name="image" bind_src="presenter.dialog_image" inner_align="contain" width="50%" height="200"
						  style_min_width="50" style_max_width="300" style_min_height="50" style_max_height="300">
					<bind_flag_if_eq subject="presenter.dialog_has_image" flag="hidden" ref_value="0"/>
				</lv_image>
			</lv_obj>
		</lv_obj>

		<ds_dialog_footer name="footer">
			<!-- Deleting, apart from what the dialog is for, on the left -->
			<ds_button name="delete" text="&#xF2ED;" width="content">
				<bind_flag_if_eq subject="presenter.dialog_can_delete" flag="hidden" ref_value="0"/>
				<action trigger="clicked" name="presenter.files.ask_delete"/>
			</ds_button>
			<!-- Pushes the delete button left; it goes with it, so the buttons on the right keep to the edge -->
			<lv_obj name="spacer" height="1" flex_grow="1" clickable="false" style_bg_opa="0" style_border_width="0">
				<bind_flag_if_eq subject="presenter.dialog_can_delete" flag="hidden" ref_value="0"/>
			</lv_obj>
			<ds_button name="cancel" translation_tag="tr.common.cancel">
				<style name="dialog_button"/>
				<action trigger="clicked" name="presenter.files.close_dialog"/>
			</ds_button>
			<ds_button name="ok" translation_tag="tr.common.ok">
				<style name="dialog_button"/>
				<style name="action_btn"/>
				<action trigger="clicked" name="presenter.files.confirm"/>
			</ds_button>
		</ds_dialog_footer>
	</view>
</component>
