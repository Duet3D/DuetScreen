<!--
  One file or folder in the file browser's grid: its picture (file_browser_picture.xml) as large as the tile allows,
  then its name; the list shows more about each (file_browser_row.xml). A folder is edged in the accent colour. Tap it
  to open it. The list sets its size.

  Fields:   a files row: row.name, row.is_folder, and the picture's
            (src/UI/Presenters/FileBrowser/FileBrowserPresenter.h)
-->
<component>
	<view extends="lv_obj" width="150" height="170" scrollable="false" flex_flow="column"
		  style_flex_main_place="start" style_flex_cross_place="center" style_flex_track_place="start">
		<style name="file"/>
		<style name="folder" selector="checked"/>
		<style name="pressed" selector="pressed"/>
		<bind_state_if_eq subject="row.is_folder" state="checked" ref_value="1"/>
		<action trigger="clicked" name="presenter.files.open"/>

		<file_browser_picture name="picture" width="100%" height="72" flex_grow="1"/>
		<lv_label name="label" bind_text="row.name" width="100%" height="content" long_mode="dots"
				  style_max_height="content" style_text_align="center" clickable="false">
			<style name="setting_title"/>
		</lv_label>
	</view>
</component>
