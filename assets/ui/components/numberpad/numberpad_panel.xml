<!--
  A number pad: what is asked for, the box showing what has been typed with a button to clear it, and the number keys.
  Shown in a dialog by the shared number pad (numberpad.xml), and beside the sliders of the speed and extrusion factor
  dialogs.

      <numberpad_panel entry="pad" header="pad.header" text="pad.text" accepted="pad.accepted"
                       confirmable="pad.confirmable" signed="pad.signed"/>

  `entry` is the entry's id, the arg of its actions; the others name its fields. The presenter showing it owns a
  NumberEntry, which declares those fields and handles the actions (src/UI/Xml/View/NumberEntry.h).
-->
<component>
	<api>
		<prop name="entry" type="string"/>
		<prop name="header" type="string"/>
		<prop name="text" type="string"/>
		<prop name="accepted" type="string"/>
		<prop name="confirmable" type="string"/>
		<prop name="signed" type="string"/>
	</api>

	<view extends="lv_obj" flex_flow="column" scrollable="false">
		<style name="pad_zero"/>
		<lv_label name="header" bind_text="$header" width="100%" height="content">
			<bind_flag_if_eq subject="$header" flag="hidden" ref_value=""/>
		</lv_label>

		<lv_obj name="text_row" width="100%" height="content" flex_flow="row" scrollable="false"
				style_flex_main_place="start" style_flex_cross_place="center" style_flex_track_place="start">
			<style name="pad_small"/>
			<ds_textarea name="text" bind_text="$text" bind_accepted_chars="$accepted" one_line="true" keyboard="none"
						 height="content" flex_grow="1" scrollable="false">
				<action trigger="value_changed" name="numberpad.typed" arg="$entry"/>
			</ds_textarea>
			<ds_button name="clear" text="&#xF2ED;" width="20%" height="100%">
				<action trigger="clicked" name="numberpad.clear" arg="$entry"/>
			</ds_button>
		</lv_obj>

		<ds_keyboard name="keys" mode="numberpad" textarea="text" bind_ok_enabled="$confirmable"
					 bind_sign_enabled="$signed" width="100%" flex_grow="1" style_min_width="100">
			<action trigger="ready" name="numberpad.confirm" arg="$entry"/>
		</ds_keyboard>
	</view>
</component>
