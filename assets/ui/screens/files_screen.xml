<!--
  The Files page: macros and jobs in tabs. While there is a job the Jobs tab is disabled, so the job can't be replaced.

  Each tab is a file browser with settings of its own (src/UI/Screens/XmlScreens.cpp).
-->
<component>
	<view extends="lv_obj" width="100%" height="100%" style_pad_all="0">
		<ds_tabs name="tabs" width="100%" height="100%">
			<style name="bg_dark"/>

			<ds_tabs-tab name="macros" title_tag="file.macros">
				<ds_view name="files_macros" view="file_browser" presenter="files_macros" shown="true"/>
			</ds_tabs-tab>
			<ds_tabs-tab name="jobs" title_tag="file.jobs" bind_disabled="machine.job_active">
				<ds_view name="files_jobs" view="file_browser" presenter="files_jobs" shown="true"/>
			</ds_tabs-tab>
		</ds_tabs>
	</view>
</component>
