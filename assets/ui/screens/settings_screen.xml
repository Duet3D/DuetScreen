<!--
  The Settings page: general, connection, display and developer settings, in tabs.

  The developer tab is a C++ view (src/UI/Screens/XmlScreens.cpp) for now.
-->
<component>
	<view extends="lv_obj" width="100%" height="100%" style_pad_all="0">
		<style name="bg_dark"/>
		<ds_tabs name="tabs" width="100%" height="100%">
			<ds_tabs-tab name="general" title_tag="settings.tabs.general">
				<ds_view name="general_settings" view="settings_general" shown="true"/>
			</ds_tabs-tab>
			<ds_tabs-tab name="connection" title_tag="settings.tabs.connection">
				<ds_view name="connection_settings" view="settings_connection" shown="true"/>
			</ds_tabs-tab>
			<ds_tabs-tab name="display" title_tag="settings.tabs.display">
				<ds_view name="display_settings" view="settings_display" shown="true"/>
			</ds_tabs-tab>
			<ds_tabs-tab name="developer" title_tag="settings.tabs.developer">
				<ds_view name="developer_settings" view="developer_settings" shown="true"/>
			</ds_tabs-tab>
		</ds_tabs>
	</view>
</component>
