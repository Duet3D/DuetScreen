/* The dashboard: the tool list and temperature graph on the left, the jobs, macros and status on the right.
   A grid of 10x6 cells; the user's own layout (made on the screen) can change its size. */
{
  "format": 1,
  "slot": "dashboard",
  "kind": "grid",
  "columns": 10,
  "rows": 6,
  "items": [
    {
      "id": "tools",
      "widget": "tools",
      "x": 0,
      "y": 0,
      "w": 6,
      "h": 3
    },
    {
      "id": "temperature_graph",
      "widget": "temperature_graph",
      "x": 0,
      "y": 3,
      "w": 6,
      "h": 3
    },
    {
      "id": "files",
      "widget": "files",
      "x": 6,
      "y": 0,
      "w": 4,
      "h": 6
    }
  ]
}
