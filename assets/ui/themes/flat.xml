<!--
  Flat: dark and borderless. Surfaces are told apart by their tone alone, with no borders, outlines, gradients or
  shadows; a teal accent marks actions and an amber one standby.
-->
<theme name="flat" extends="base">
	<palette primary_hue="200" secondary_hue="70" chroma="0.01" dark="true"/>

	<consts>
		<const name="radius" value="4"/>
	</consts>

	<styles>
		<style name="card" border_width="0"/>
		<!-- A dialog stands out by its tone alone, a step lighter than a card -->
		<style name="modal" border_width="0" shadow_opa="0" bg_color="#bg_light"/>
		<style name="btn" border_width="0"/>
		<!-- A choice is filled with the muted accent, without an edge -->
		<style name="btn_checked" outline_width="0"/>
		<style name="tab_btn" border_width="0"/>
		<!-- The tools are a flat list in their card (tool_list_tool copied the base theme's card), a hairline between
			 each; the selected one is tinted with the muted accent -->
		<style name="tool_list_tool" bg_opa="0" radius="0" border_width="1" border_side="bottom"
			   border_color="#border_muted"/>
		<style name="tool_selected" outline_width="0" bg_color="#primary_muted" bg_opa="45%" border_color="#border_muted"/>
		<style name="object_cancel_base" border_width="0"/>
		<style name="input" border_width="0" bg_color="#bg_light" bg_opa="100%"/>

		<style name="chart_bg" border_width="0"/>
		<style name="list_btn" border_width="0"/>
		<style name="btnm_btn" border_width="0"/>
		<style name="keyboard_button" border_width="0"/>
		<style name="slider_knob" border_width="0" bg_color="#primary"/>
		<style name="cb_marker" border_width="0" bg_color="#bg_light"/>
		<style name="bg_color_header" bg_color="#bg_light"/>
	</styles>
</theme>
