<!-- Flat: no borders or gradients; buttons are outlined in the accent colour. -->
<theme name="flat" extends="base">
	<palette primary_hue="80" secondary_hue="30" chroma="0" dark="true"/>

	<styles>
		<style name="card" border_width="0"/>

		<style name="btn" bg_color="#bg_light" bg_grad_dir="none" text_color="#primary"/>
		<style name="btn_checked" border_color="#primary"/>
		<style name="action_btn" bg_color="#secondary" bg_grad_dir="none" text_color="#text" recolor="#text"/>

		<style name="card" bg_color="#bg" bg_grad_dir="none"/>

		<style name="icon_recolor" recolor="#primary"/>

		<!-- Folders look like the restyled buttons -->
		<style name="folder" copy="btn"/>
	</styles>
</theme>
