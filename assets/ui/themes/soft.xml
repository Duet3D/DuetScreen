<!--
  Soft: light and friendly. Rounded shapes, soft shadows instead of borders and pastel accents: periwinkle for
  actions, mint for standby. Cards are white on a pale screen; controls are pale chips lifted by a shadow.
-->
<theme name="soft" extends="base">
	<palette primary_hue="275" secondary_hue="170" chroma="0.05" dark="false">
		<!-- Light: white cards on a pale screen, pale chips on the cards, pastel accents -->
		<color name="bg_dark" lightness="0.93" when="light"/>
		<color name="bg" lightness="1.0" when="light"/>
		<color name="bg_light" lightness="0.955" when="light"/>
		<color name="primary" lightness="0.72" when="light"/>
		<color name="secondary" lightness="0.8" when="light"/>
		<!-- Dark: soft, not black; the shadows can't lift anything, so cards are told apart by tone -->
		<color name="bg_dark" lightness="0.2" when="dark"/>
		<color name="bg" lightness="0.25" when="dark"/>
		<color name="bg_light" lightness="0.32" when="dark"/>
	</palette>

	<fonts>
		<font name="header" size="18" weight="600" style="bold"/>
		<font name="emphasis" size="14" weight="600" style="bold"/>
	</fonts>

	<consts>
		<const name="radius" value="12"/>
		<const name="pad" value="6"/>
	</consts>

	<styles>
		<!-- Soft shadows instead of borders -->
		<style name="card" border_width="0" shadow_width="16" shadow_spread="0" shadow_offset_y="3" shadow_opa="8%"
			   shadow_color="0x000000"/>
		<style name="tool_list_tool" border_width="0" bg_color="#bg_light" shadow_opa="0"/>
		<style name="btn" border_width="0" shadow_width="6" shadow_offset_y="2" shadow_opa="12%" shadow_color="0x000000"/>
		<style name="input" border_width="0" bg_color="#bg_light" bg_opa="100%"/>
		<style name="tool_selected" border_width="0" outline_width="2" bg_color="#primary_muted"/>

		<!-- Pressed: a lighter tint -->
		<style name="pressed" recolor_opa="15"/>

		<style name="scrollbar" width="6" bg_opa="30%"/>
		<style name="chart_bg" border_width="0"/>
		<style name="list_btn" border_width="0"/>
		<style name="btnm_btn" border_width="0" shadow_width="4" shadow_offset_y="1" shadow_opa="10%"
			   shadow_color="0x000000"/>
		<style name="keyboard_button" radius="10" border_width="0" shadow_width="4" shadow_offset_y="1" shadow_opa="10%"
			   shadow_color="0x000000"/>
		<style name="slider_knob" border_width="0" bg_color="0xffffff" shadow_width="8" shadow_offset_y="2"
			   shadow_opa="25%" shadow_color="0x000000"/>
		<style name="cb_marker" radius="6"/>
		<style name="bar_label_bg" radius="circle"/>
		<style name="gauge_bar" radius="circle"/>
		<style name="gauge_bar_indic" radius="circle"/>

		<!-- Files and folders follow the restyled buttons -->
		<style name="folder" copy="btn"/>
		<style name="file" merge="btn bg_light"/>
	</styles>
</theme>
