<!--
  3D: raised, bevelled controls. Light-to-dark gradients suggest light from above, and a soft shadow lifts every
  control off its card; a chosen control is pressed in, its gradient inverted and its shadow gone. Actions are a
  raised blue, standby amber. lighten()/darken() change a palette colour's lightness (see Theme.h).
-->
<theme name="3d" extends="base">
	<palette primary_hue="240" secondary_hue="70" chroma="0.02" dark="false">
		<color name="primary" chroma="0.13"/>
		<color name="primary" lightness="0.66" when="light"/>
		<color name="bg_dark" lightness="0.9" when="light"/>
		<color name="bg_light" lightness="0.97" when="light"/>
	</palette>

	<fonts>
		<font name="normal" size="14" weight="450" style="normal"/>
		<font name="emphasis" size="14" weight="600" style="bold"/>
	</fonts>

	<consts>
		<const name="radius" value="7"/>
	</consts>

	<styles>
		<!-- Cards: lit from above, with a drop shadow -->
		<style name="card" bg_color="lighten(#bg, 0.01)" bg_grad_color="darken(#bg, 0.03)" bg_grad_dir="ver"
			   border_color="#border" border_opa="60%" shadow_width="10" shadow_offset_y="3" shadow_color="0x000000"
			   shadow_opa="12%"/>
		<style name="tool_list_tool" shadow_opa="0" bg_grad_dir="none"/>

		<!-- Buttons: raised, a highlight along the top, a shadow below -->
		<style name="btn" bg_color="lighten(#bg_light, 0.03)" bg_grad_color="darken(#bg_light, 0.08)" bg_grad_dir="ver"
			   border_color="#border" shadow_width="5" shadow_offset_y="2" shadow_color="0x000000" shadow_opa="20%"/>
		<style name="action_btn" bg_color="lighten(#primary, 0.08)" bg_grad_color="darken(#primary, 0.08)"
			   bg_grad_dir="ver" border_color="darken(#primary, 0.18)"/>
		<style name="heater_standby" bg_color="lighten(#secondary, 0.06)" bg_grad_color="darken(#secondary, 0.08)"
			   bg_grad_dir="ver" border_color="darken(#secondary, 0.18)"/>
		<style name="heater_off" bg_color="lighten(#bg_light, 0.03)" bg_grad_color="darken(#bg_light, 0.08)"
			   bg_grad_dir="ver" border_color="#border"/>
		<style name="heater_fault" bg_color="lighten(#error, 0.06)" bg_grad_color="darken(#error, 0.08)"
			   bg_grad_dir="ver" border_color="darken(#error, 0.18)"/>
		<style name="unhomed" bg_color="lighten(#secondary, 0.06)" bg_grad_color="darken(#secondary, 0.08)"
			   bg_grad_dir="ver" border_color="darken(#secondary, 0.18)"/>
		<!-- Chosen: pressed in, the gradient inverted and no shadow -->
		<style name="btn_checked" bg_color="darken(#primary_muted, 0.06)" bg_grad_color="#primary_muted"
			   bg_grad_dir="ver" shadow_opa="0"/>
		<style name="tab_btn" bg_grad_dir="none"/>

		<style name="pressed" recolor="0x000000" recolor_opa="25"/>
		<style name="knob" shadow_width="6" shadow_offset_y="2" shadow_color="0x000000" shadow_opa="30%"/>

		<!-- Keys: raised like the buttons -->
		<style name="btnm_btn" bg_color="lighten(#bg_light, 0.03)" bg_grad_color="darken(#bg_light, 0.08)"
			   bg_grad_dir="ver" border_color="#border" shadow_width="3" shadow_offset_y="1" shadow_color="0x000000"
			   shadow_opa="20%"/>
		<style name="btnm_btn_checked" bg_color="lighten(#primary, 0.06)" bg_grad_color="darken(#primary, 0.08)"
			   bg_grad_dir="ver"/>
		<style name="keyboard_button" bg_color="lighten(#bg_light, 0.03)" bg_grad_color="darken(#bg_light, 0.08)"
			   bg_grad_dir="ver" border_color="#border" shadow_width="3" shadow_offset_y="1" shadow_color="0x000000"
			   shadow_opa="20%"/>
		<style name="keyboard_button_checked_bg" bg_color="lighten(#primary, 0.06)"
			   bg_grad_color="darken(#primary, 0.08)" bg_grad_dir="ver"/>

		<!-- Tracks are inset grooves; knobs are raised -->
		<style name="bar" bg_grad_color="lighten(#highlight, 0.06)" bg_grad_dir="ver"/>
		<style name="slider" bg_color="darken(#highlight, 0.04)" bg_grad_color="lighten(#highlight, 0.04)"
			   bg_grad_dir="ver"/>
		<style name="slider_indic" bg_color="lighten(#primary, 0.06)" bg_grad_color="darken(#primary, 0.08)"
			   bg_grad_dir="ver"/>
		<style name="slider_knob" bg_color="0xffffff" bg_grad_color="darken(#bg_light, 0.1)" bg_grad_dir="ver"
			   shadow_width="6" shadow_offset_y="2" shadow_color="0x000000" shadow_opa="30%"/>
		<style name="bg_switch" bg_grad_color="lighten(#highlight, 0.06)" bg_grad_dir="ver"/>
		<style name="switch_knob" shadow_width="5" shadow_offset_y="2" shadow_color="0x000000" shadow_opa="25%"/>
		<style name="cb_marker" bg_color="darken(#bg, 0.04)" bg_grad_color="#bg" bg_grad_dir="ver"/>

		<!-- E-stop: a red gradient of its own (LVGL's palette red, lightened 1 to darkened 3) -->
		<style name="estop" bg_color="0xef5350" bg_grad_color="0xc62828" bg_grad_dir="ver"
			   shadow_width="8" shadow_offset_y="3" shadow_color="0xb71c1c" shadow_opa="40%"/>

		<!-- Files and folders follow the restyled buttons -->
		<style name="folder" copy="btn"/>
		<style name="file" merge="btn bg_light"/>
	</styles>
</theme>
