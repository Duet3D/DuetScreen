<!--
  Neon: a near-black screen with glowing, outlined controls. Actions are drawn in neon pink, standby in neon yellow;
  a choice is lit up, filled and glowing. Text stays white, and neon text is bright enough to read at a glance.
-->
<theme name="neon" extends="base">
	<palette primary_hue="345" secondary_hue="95" chroma="0.03" dark="true">
		<!-- Saturated accents, drawn as outlines and text rather than filled behind text: bright on the dark screen,
			 deep enough to read on a light one -->
		<color name="primary" chroma="0.19"/>
		<color name="secondary" chroma="0.17"/>
		<color name="primary" lightness="0.72" when="dark"/>
		<color name="secondary" lightness="0.88" when="dark"/>
		<color name="primary" lightness="0.56" when="light"/>
		<color name="secondary" lightness="0.6" when="light"/>
		<color name="primary_muted" from="primary" lightness="0.36" chroma="0.12" when="dark"/>
		<color name="secondary_muted" from="secondary" lightness="0.38" chroma="0.08" when="dark"/>
		<color name="primary_muted" from="primary" lightness="0.9" chroma="0.06" when="light"/>
		<color name="secondary_muted" from="secondary" lightness="0.9" chroma="0.06" when="light"/>
		<!-- Dark: a darker screen, for the glow -->
		<color name="bg_dark" lightness="0.12" when="dark"/>
		<color name="bg" lightness="0.165" when="dark"/>
		<color name="bg_light" lightness="0.22" when="dark"/>
	</palette>

	<styles>
		<!-- Cards: a faint pink edge and glow -->
		<style name="card" border_color="#primary" border_opa="35%" shadow_width="14" shadow_spread="0"
			   shadow_color="#primary" shadow_opa="12%" shadow_offset_x="0" shadow_offset_y="0"/>

		<style name="dialog" border_opa="70%" shadow_color="#primary" shadow_opa="30%" shadow_offset_y="0"/>

		<!-- Actions: outlined in neon, with neon text and icons, and a glow -->
		<style name="action_btn" bg_color="#bg_light" border_color="#primary" text_color="#primary" recolor="#primary"
			   shadow_width="10" shadow_color="#primary" shadow_opa="25%" shadow_spread="0"/>
		<!-- A choice: lit up -->
		<style name="btn_checked" bg_color="#primary_muted" text_color="#text" recolor="#text" shadow_width="14"
			   shadow_color="#primary" shadow_opa="45%" shadow_spread="1"/>
		<style name="tab_btn" shadow_width="0"/>
		<style name="tool_selected" shadow_width="18" shadow_color="#primary" shadow_opa="35%" shadow_spread="1"/>

		<!-- Heater states in the same outlined style; a fault is filled, to be seen -->
		<style name="heater_standby" bg_color="#bg_light" border_color="#secondary" text_color="#secondary"
			   shadow_color="#secondary"/>
		<style name="heater_off" shadow_width="0"/>
		<style name="heater_fault" text_color="#text" shadow_color="#error"/>
		<style name="unhomed" bg_color="#bg_light" border_color="#secondary" text_color="#secondary" recolor="#secondary"
			   shadow_color="#secondary"/>

		<!-- Pressed: brighten a little -->
		<style name="pressed" recolor="0xffffff" recolor_opa="25"/>

		<style name="knob" shadow_width="10" shadow_color="#primary" shadow_opa="50%"/>
		<style name="slider_knob" bg_color="#primary" border_width="0" shadow_width="10" shadow_color="#primary"
			   shadow_opa="50%"/>
		<style name="scrollbar" bg_color="#primary" bg_opa="50%"/>

		<style name="keyboard_button_checked_bg" bg_color="#primary_muted"/>
		<style name="btnm_btn_checked" bg_color="#primary_muted"/>

		<style name="estop" shadow_width="16" shadow_color="0xf44336" shadow_opa="45%"/>
	</styles>
</theme>
