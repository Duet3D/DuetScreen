			<xs:attribute name="style_blur_quality" type="xs:string">
				<xs:annotation><xs:documentation>Set whether to prefer speed or precision. Add a part or state after a dash to style only that, e.g. `-pressed`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="style_blur_backdrop" type="bool">
				<xs:annotation><xs:documentation>true: blur the background first, false: blur the widget. Add a part or state after a dash to style only that, e.g. `-pressed`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="flex_grow" type="xs:string">
				<xs:annotation><xs:documentation>Set flex grow to fill the available space in the track</xs:documentation></xs:annotation>
