			<xs:attribute name="focused" type="bool">
				<xs:annotation><xs:documentation>Mark widget as focused</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="focus_key" type="bool">
				<xs:annotation><xs:documentation>Mark widget as focused via key navigation</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="edited" type="bool">
				<xs:annotation><xs:documentation>Mark widget as being edited (e.g. text input)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="hovered" type="bool">
				<xs:annotation><xs:documentation>Mark widget as hovered by a pointer</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="pressed" type="bool">
				<xs:annotation><xs:documentation>Mark widget as pressed</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="scrolled" type="bool">
				<xs:annotation><xs:documentation>Mark widget as being scrolled</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="disabled" type="bool">
				<xs:annotation><xs:documentation>Disable widget interaction</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="hidden" type="bool">
				<xs:annotation><xs:documentation>Make the object hidden. (Like it wasn't there at all)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="clickable" type="bool">
				<xs:annotation><xs:documentation>Make the object clickable by the input devices</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="click_focusable" type="bool">
				<xs:annotation><xs:documentation>Add focused state to the object when clicked</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="scrollable" type="bool">
				<xs:annotation><xs:documentation>Make the object scrollable</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="scroll_elastic" type="bool">
				<xs:annotation><xs:documentation>Allow scrolling inside but with slower speed</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="scroll_momentum" type="bool">
				<xs:annotation><xs:documentation>Make the object scroll further when 'thrown'</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="scroll_one" type="bool">
				<xs:annotation><xs:documentation>Allow scrolling only one snappable children</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="scroll_chain_hor" type="bool">
				<xs:annotation><xs:documentation>Allow propagating the horizontal scroll to a parent</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="scroll_chain_ver" type="bool">
				<xs:annotation><xs:documentation>Allow propagating the vertical scroll to a parent</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="scroll_chain" type="bool">
				<xs:annotation><xs:documentation>SCROLL_CHAIN_HOR and SCROLL_CHAIN_VER</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="scroll_on_focus" type="bool">
				<xs:annotation><xs:documentation>Automatically scroll object to make it visible when focused</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="scroll_with_arrow" type="bool">
				<xs:annotation><xs:documentation>Allow scrolling the focused object with arrow keys</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="snappable" type="bool">
				<xs:annotation><xs:documentation>If scroll snap is enabled on the parent it can snap to this object</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="press_lock" type="bool">
				<xs:annotation><xs:documentation>Keep the object pressed even if the press slid from the object</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="event_bubble" type="bool">
				<xs:annotation><xs:documentation>Propagate the events to the parent too</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="event_trickle" type="bool">
				<xs:annotation><xs:documentation>Send events to children first</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="state_trickle" type="bool">
				<xs:annotation><xs:documentation>Propagate state changes to children</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="gesture_bubble" type="bool">
				<xs:annotation><xs:documentation>Propagate the gestures to the parent</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="adv_hittest" type="bool">
				<xs:annotation><xs:documentation>Allow performing more accurate hit (click) test. E.g. consider rounded corners.</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="ignore_layout" type="bool">
				<xs:annotation><xs:documentation>Make the object not positioned by the layouts</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="floating" type="bool">
				<xs:annotation><xs:documentation>Do not scroll the object when the parent scrolls and ignore layout</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="send_draw_task_events" type="bool">
				<xs:annotation><xs:documentation>Send `LV_EVENT_DRAW_TASK_ADDED` events</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="overflow_visible" type="bool">
				<xs:annotation><xs:documentation>Do not clip the children to the parent's ext draw size</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="radio_button" type="bool">
				<xs:annotation><xs:documentation>Allow only one radio_button sibling to be checked (can't be bound: LVGL 9.6 gives it no flag bit)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="flex_in_new_track" type="bool">
				<xs:annotation><xs:documentation>Start a new flex track on this item</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_checked" type="subject">
				<xs:annotation><xs:documentation>Bind widget’s checked state to a subject</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="hidden_if_prop_eq" type="xs:string">
				<xs:annotation><xs:documentation>`$prop|value`: hide the object when the prop equals the value. Decided once, at creation</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="hidden_if_prop_not_eq" type="xs:string">
				<xs:annotation><xs:documentation>`$prop|value`: hide the object unless the prop equals the value. Decided once, at creation</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="hidden_if_empty" type="xs:string">
				<xs:annotation><xs:documentation>Hide the object when the value, typically a `$prop`, is empty. Decided once, at creation</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="moves_machine" type="bool">
				<xs:annotation><xs:documentation>true: disabled while the `machine_motion_blocked` subject is 1, for controls that move the machine</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
</xs:schema>
