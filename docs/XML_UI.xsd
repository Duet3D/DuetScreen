	<xs:simpleType name="translation">
		<xs:union memberTypes="translation.names xs:string"/>
	</xs:simpleType>
	<xs:group name="anyContent">
		<xs:sequence>
			<xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
		</xs:sequence>
	</xs:group>
	<xs:element name="component">
		<xs:annotation><xs:documentation>A component: an `&lt;api&gt;` of props, `&lt;consts&gt;`, `&lt;styles&gt;`, `&lt;subjects&gt;`, and its `&lt;view&gt;`.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attribute name="presenter" type="presenter">
				<xs:annotation><xs:documentation>The presenter that gives its view names and handles its actions</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="api">
		<xs:annotation><xs:documentation>The props the component takes</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="prop">
		<xs:annotation><xs:documentation>A prop: `&lt;my_component title=&quot;…&quot;/&gt;` sets `$title` inside the component</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attribute name="name" type="xs:string">
				<xs:annotation><xs:documentation>Its name</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="type" type="xs:string">
				<xs:annotation><xs:documentation>Its type, e.g. string</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="default" type="xs:string">
				<xs:annotation><xs:documentation>Its value when not given</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="view">
		<xs:annotation><xs:documentation>The component's root widget. Takes every attribute of the widget it extends.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attribute name="extends" type="widget">
				<xs:annotation><xs:documentation>The widget, or component, it is (default lv_obj)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="style">
		<xs:annotation><xs:documentation>Inside a widget: add the style called `name`. Inside `&lt;styles&gt;`: define a style.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attribute name="name" type="style">
				<xs:annotation><xs:documentation>The style</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="selector" type="xs:string">
				<xs:annotation><xs:documentation>The part and state it applies to</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_bar">
		<xs:annotation><xs:documentation>A progress bar that draws its value as text, inside the filled part when it fits Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attribute name="min" type="xs:string">
				<xs:annotation><xs:documentation>Bottom of the range (default 0)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="max" type="xs:string">
				<xs:annotation><xs:documentation>Top of the range (default 100)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_min" type="subject">
				<xs:annotation><xs:documentation>Follow an int subject for the bottom of the range, e.g. a heater's minimum</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_max" type="subject">
				<xs:annotation><xs:documentation>Follow an int subject for the top of the range, e.g. a heater's maximum</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_value" type="subject">
				<xs:annotation><xs:documentation>Follow an int subject for the value</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="label_format" type="xs:string">
				<xs:annotation><xs:documentation>fmt format for the value's text (default &quot;{}&quot;)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_bar_marker">
		<xs:annotation><xs:documentation>A value marked on a bar, such as a heater's target temperature above its current-temperature bar: a button showing the value, placed along the bar where the value falls and pointing at it with a triangle (the indicator part's background colour). Its x position is set from the value; set its y with `align` and `y`. Drag it along the bar to choose a value, raising `value_confirmed` with it when released (the marker shows the dragged value until the subject changes), or tap it to raise `clicked`; a drag doesn't raise `clicked`. Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attribute name="bar" type="xs:string">
				<xs:annotation><xs:documentation>Name of the sibling bar it marks, written before the marker. The bar spans its parent's width (e.g. width=&quot;100%&quot;), as the marker is placed by percentages of that width</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="min" type="xs:string">
				<xs:annotation><xs:documentation>Bottom of the scale the value is on (default 0)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="max" type="xs:string">
				<xs:annotation><xs:documentation>Top of the scale the value is on (default 100)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_min" type="subject">
				<xs:annotation><xs:documentation>Follow an int subject for the bottom of the scale</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_max" type="subject">
				<xs:annotation><xs:documentation>Follow an int subject for the top of the scale</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_value" type="subject">
				<xs:annotation><xs:documentation>Follow an int subject for the value marked</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="label_format" type="xs:string">
				<xs:annotation><xs:documentation>fmt format for the value's text (default &quot;{}&quot;)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_button">
		<xs:annotation><xs:documentation>A button showing text, an icon or both Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attribute name="text" type="xs:string">
				<xs:annotation><xs:documentation>The text shown, if there is no `translation_tag`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="translation_tag" type="translation">
				<xs:annotation><xs:documentation>Translation key for the text; follows language changes</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_text" type="subject">
				<xs:annotation><xs:documentation>Follow a text or int subject for the text</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_text-fmt" type="xs:string">
				<xs:annotation><xs:documentation>printf format for `bind_text`, e.g. &quot;%d°C&quot; (default &quot;%s&quot; for text, &quot;%d&quot; for an int)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="icon" type="xs:string">
				<xs:annotation><xs:documentation>Icon file from the icon set, e.g. &quot;fan.png&quot;</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="checkable" type="xs:string">
				<xs:annotation><xs:documentation>&quot;true&quot; to make the button toggle its `checked` state when clicked</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="long_mode" type="xs:string">
				<xs:annotation><xs:documentation>What the label does with text too long for it: wrap, dots, scroll, scroll_circular or clip</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="flash_on" type="subject">
				<xs:annotation><xs:documentation>Flash the button briefly, in its `user_1` state, whenever this subject changes, e.g. `responses.count`; style the flash with `&lt;style … selector=&quot;user_1&quot;/&gt;`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_dropdown">
		<xs:annotation><xs:documentation>A drop-down list whose options and text follow subjects. The option chosen reaches a `value_changed` action as its text (ActionArgs::text()) and its index (ActionArgs::value()). Also takes every lv_dropdown attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attribute name="bind_options" type="subject">
				<xs:annotation><xs:documentation>Follow a text subject holding the options, one per line</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_text" type="subject">
				<xs:annotation><xs:documentation>Follow a text subject shown on the button instead of the chosen option, e.g. what is loaded</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_selected" type="subject">
				<xs:annotation><xs:documentation>Follow an int subject for the index of the option shown chosen, kept when the options change</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_graph">
		<xs:annotation><xs:documentation>A line graph of a history, with a legend whose buttons show and hide series. Series are coloured by position from LVGL's palette (red, pink, purple, …). The graph starts with what was recorded before it was built, and follows series being added, removed and renamed. Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attribute name="history" type="list">
				<xs:annotation><xs:documentation>The history shown (required), looked up like a list: the enclosing rows, the view's presenter, then the globals</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="seconds" type="xs:string">
				<xs:annotation><xs:documentation>The X axis shows the last this-many seconds, labelled -seconds to 0 (default 60)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="y_min" type="xs:string">
				<xs:annotation><xs:documentation>Bottom of the Y axis (default 0)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="y_max" type="xs:string">
				<xs:annotation><xs:documentation>Top of the Y axis (default 100)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_y_max" type="subject">
				<xs:annotation><xs:documentation>Follow an int subject that raises the top of the Y axis above `y_max`, e.g. to fit a heater's limit</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_heatmap">
		<xs:annotation><xs:documentation>A colour map of a surface, such as a bed's height map, with X and Y scales, a grid, a title, and the colour scale beside it Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attribute name="bind_surface" type="subject">
				<xs:annotation><xs:documentation>The surface subject to show; redrawn whenever it changes</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_title" type="subject">
				<xs:annotation><xs:documentation>Follow a text subject for the title shown above the map</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="resolution" type="xs:string">
				<xs:annotation><xs:documentation>Pixels the map is drawn with along each side, scaled to fit (default 200)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_hue_slider">
		<xs:annotation><xs:documentation>A `&lt;ds_slider&gt;` for a hue, 0 to 360, whose track shows every hue at a lightness and chroma, so the slider is a colour picker, e.g. for a theme's primary colour. `min` and `max` default to 0 and 360. Also takes every ds_slider attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attribute name="bind_lightness" type="subject">
				<xs:annotation><xs:documentation>Follow an int subject for the OKLCH lightness the hues are shown at, in thousandths (0.65 is 650)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_chroma" type="subject">
				<xs:annotation><xs:documentation>Follow an int subject for the OKLCH chroma the hues are shown at, in thousandths</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="min" type="xs:string">
				<xs:annotation><xs:documentation>Bottom of the range, may have a fraction (default 0)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="max" type="xs:string">
				<xs:annotation><xs:documentation>Top of the range, may have a fraction (default 100)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="increment" type="xs:string">
				<xs:annotation><xs:documentation>Step of the -/+ buttons, may have a fraction, e.g. &quot;0.01&quot; (default 1)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="decimals" type="xs:string">
				<xs:annotation><xs:documentation>Decimal places the value is shown with (default 2)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="label" type="xs:string">
				<xs:annotation><xs:documentation>The label, if there is no `label_tag`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="label_tag" type="translation">
				<xs:annotation><xs:documentation>Translation key for the label</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_label" type="subject">
				<xs:annotation><xs:documentation>Follow a text subject for the label</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="label_shown" type="xs:string">
				<xs:annotation><xs:documentation>&quot;false&quot; to hide the label, which still heads the number pad (default true)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_value" type="subject">
				<xs:annotation><xs:documentation>Follow an int subject for the value</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="value_scale" type="xs:string">
				<xs:annotation><xs:documentation>How much `bind_value` is scaled by, for a value with a fraction, e.g. a chroma of 0.02 held as 2 with value_scale=&quot;100&quot; (default 1)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="send" type="xs:string">
				<xs:annotation><xs:documentation>`confirmed` to raise `value_confirmed` when an edit is finished (default), or `change` on every movement, for a setting seen as it changes such as brightness</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="out_of_range" type="xs:string">
				<xs:annotation><xs:documentation>Let a typed value go past the slider's `upper` end, `lower` end or `both`, e.g. a timeout longer than the slider reaches</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="numberpad" type="xs:string">
				<xs:annotation><xs:documentation>&quot;true&quot; to type the value on a number pad when the value is tapped: the one hosted nearest the slider, else the shared `numberpad` (default false)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_icon">
		<xs:annotation><xs:documentation>An icon from the icon set chosen in the settings, coloured by the theme. It follows icon set changes. Also takes every lv_image attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attribute name="icon" type="xs:string">
				<xs:annotation><xs:documentation>Icon file from the icon set, e.g. &quot;folder.png&quot;</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_keyboard">
		<xs:annotation><xs:documentation>An on-screen keyboard with DuetScreen's key layouts. A `&lt;ds_textarea&gt;` brings it up and types into it, so it is usually written `hidden=&quot;true&quot;`. Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attribute name="mode" type="xs:string">
				<xs:annotation><xs:documentation>Key layout: `text` (default), `text_upper` or `number`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_list">
		<xs:annotation><xs:documentation>A container with one component per row of a list. Each item is built in a scope of its own holding its row's fields, so names are found in the row first, then where the list is written. With `windowed`, only the rows on screen are built, so a folder of a thousand files costs a screenful of widgets; every item then has the same size, and the list places them itself (its own layout is ignored), with its style_pad_row and style_pad_column as the gaps. Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attribute name="list" type="list">
				<xs:annotation><xs:documentation>The list shown (required), looked up like a subject: the enclosing rows first (so a tool card can show `list=&quot;heaters&quot;`), then the view's presenter, then the globals</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="item" type="component">
				<xs:annotation><xs:documentation>The component built for each row (required)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="windowed" type="xs:string">
				<xs:annotation><xs:documentation>&quot;true&quot; to build only the rows on screen, building and deleting rows as the list scrolls (default false)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="item_height" type="xs:string">
				<xs:annotation><xs:documentation>Windowed: each item's height in pixels (required when windowed)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="item_width" type="xs:string">
				<xs:annotation><xs:documentation>Windowed: each item's width in pixels, or `content` for each item's own width (column flow only; the list scrolls sideways); the list's full width if not given</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="flow" type="xs:string">
				<xs:annotation><xs:documentation>Windowed: `column` for one item per line (default), `row_wrap` for as many per line as fit</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="follow_end" type="xs:string">
				<xs:annotation><xs:documentation>&quot;true&quot; to keep a list that isn't windowed showing its last rows as rows are added, like a log, unless the user has scrolled back (default false)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_modal">
		<xs:annotation><xs:documentation>A dialog over the main window with a dimmed backdrop. Its subject alone decides whether it is open, so a presenter opens and closes it by setting a subject. Closed any other way (tapped outside, the back button, navigation closing every modal), it raises `dismissed` so the presenter can update the subject; closing it by its subject raises nothing. The content is laid out in the dialog's card, which the lv_obj attributes apply to. Unless `in_place`, it is deleted with the widget it was written in. Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attribute name="bind_open" type="subject">
				<xs:annotation><xs:documentation>Open while this subject is non-zero (int) or non-empty (text), or, with `open_value`, equal to it</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="open_value" type="xs:string">
				<xs:annotation><xs:documentation>The value `bind_open` must have for the dialog to be open</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="blocking" type="xs:string">
				<xs:annotation><xs:documentation>&quot;true&quot; so that tapping outside doesn't close it (default false)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="in_place" type="xs:string">
				<xs:annotation><xs:documentation>&quot;true&quot; to stay in the widget it is written in rather than move to the main window, so the backdrop covers only that widget, e.g. alerts covering the whole screen (default false)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_password_toggle">
		<xs:annotation><xs:documentation>An eye button that shows what is typed in a password box while it is checked, and hides it again when unchecked. Tapping it doesn't take the focus from the box, so the keyboard stays up. Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attribute name="textarea" type="xs:string">
				<xs:annotation><xs:documentation>Name of the password box: the nearest `ds_textarea` of that name around the button, e.g. its sibling</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_plot">
		<xs:annotation><xs:documentation>An X/Y area with scales and a grid, such as the bed with its objects, whose content is widgets placed by X/Y position. `&lt;ds_plot_layer&gt;`s written inside it are kept over its drawing area, and `&lt;ds_plot_rect&gt;`s inside a layer are kept at their X/Y bounds. Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attribute name="title" type="xs:string">
				<xs:annotation><xs:documentation>The title above the area, if there is no `title_tag`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="title_tag" type="translation">
				<xs:annotation><xs:documentation>Translation key for the title</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_title" type="subject">
				<xs:annotation><xs:documentation>Follow a text subject for the title</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="title_style" type="style">
				<xs:annotation><xs:documentation>A theme style for the title, e.g. `text_emphasis`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_detail" type="subject">
				<xs:annotation><xs:documentation>Follow a text subject shown after the title</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="x_min" type="xs:string">
				<xs:annotation><xs:documentation>Left of the span (default 0)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="x_max" type="xs:string">
				<xs:annotation><xs:documentation>Right of the span (default 100)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="y_min" type="xs:string">
				<xs:annotation><xs:documentation>Bottom of the span (default 0)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="y_max" type="xs:string">
				<xs:annotation><xs:documentation>Top of the span (default 100)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_x_min" type="subject">
				<xs:annotation><xs:documentation>Follow an int subject for `x_min`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_x_max" type="subject">
				<xs:annotation><xs:documentation>Follow an int subject for `x_max`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_y_min" type="subject">
				<xs:annotation><xs:documentation>Follow an int subject for `y_min`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_y_max" type="subject">
				<xs:annotation><xs:documentation>Follow an int subject for `y_max`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="resolution" type="xs:string">
				<xs:annotation><xs:documentation>Pixels the grid is drawn with along each side, scaled to fit (default 200)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_plot_layer">
		<xs:annotation><xs:documentation>A layer written inside a `&lt;ds_plot&gt;`, kept exactly over its drawing area, for widgets placed by X/Y position such as `&lt;ds_plot_rect&gt;`s. It doesn't scroll and has no padding; the plot sets its position and size. Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_plot_rect">
		<xs:annotation><xs:documentation>A rectangle kept at its X/Y bounds over a `&lt;ds_plot&gt;`, e.g. an object on the bed. It is written inside a `&lt;ds_plot_layer&gt;` of the plot, directly or deeper (in a list row, say), and hidden while its bounds are outside the plot's span. It sets its own position and size. Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attribute name="x1" type="xs:string">
				<xs:annotation><xs:documentation>X of one corner, in the plot's units</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="y1" type="xs:string">
				<xs:annotation><xs:documentation>Y of that corner</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="x2" type="xs:string">
				<xs:annotation><xs:documentation>X of the opposite corner</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="y2" type="xs:string">
				<xs:annotation><xs:documentation>Y of the opposite corner</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_x1" type="subject">
				<xs:annotation><xs:documentation>Follow an int subject for `x1`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_y1" type="subject">
				<xs:annotation><xs:documentation>Follow an int subject for `y1`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_x2" type="subject">
				<xs:annotation><xs:documentation>Follow an int subject for `x2`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_y2" type="subject">
				<xs:annotation><xs:documentation>Follow an int subject for `y2`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_slider">
		<xs:annotation><xs:documentation>A slider with a label, its value and -/+ buttons, and optionally a number pad. Raises `value_confirmed` with the value when the user finishes an edit (releases it, presses -/+ or types a value), or with `send=&quot;change&quot;` on every movement. Values written by `bind_value` are not edits and raise nothing, so a view can show live data and send changes without echoing the data back to the printer. Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attribute name="min" type="xs:string">
				<xs:annotation><xs:documentation>Bottom of the range, may have a fraction (default 0)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="max" type="xs:string">
				<xs:annotation><xs:documentation>Top of the range, may have a fraction (default 100)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="increment" type="xs:string">
				<xs:annotation><xs:documentation>Step of the -/+ buttons, may have a fraction, e.g. &quot;0.01&quot; (default 1)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="decimals" type="xs:string">
				<xs:annotation><xs:documentation>Decimal places the value is shown with (default 2)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="label" type="xs:string">
				<xs:annotation><xs:documentation>The label, if there is no `label_tag`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="label_tag" type="translation">
				<xs:annotation><xs:documentation>Translation key for the label</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_label" type="subject">
				<xs:annotation><xs:documentation>Follow a text subject for the label</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="label_shown" type="xs:string">
				<xs:annotation><xs:documentation>&quot;false&quot; to hide the label, which still heads the number pad (default true)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_value" type="subject">
				<xs:annotation><xs:documentation>Follow an int subject for the value</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="value_scale" type="xs:string">
				<xs:annotation><xs:documentation>How much `bind_value` is scaled by, for a value with a fraction, e.g. a chroma of 0.02 held as 2 with value_scale=&quot;100&quot; (default 1)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="send" type="xs:string">
				<xs:annotation><xs:documentation>`confirmed` to raise `value_confirmed` when an edit is finished (default), or `change` on every movement, for a setting seen as it changes such as brightness</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="out_of_range" type="xs:string">
				<xs:annotation><xs:documentation>Let a typed value go past the slider's `upper` end, `lower` end or `both`, e.g. a timeout longer than the slider reaches</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="numberpad" type="xs:string">
				<xs:annotation><xs:documentation>&quot;true&quot; to type the value on a number pad when the value is tapped: the one hosted nearest the slider, else the shared `numberpad` (default false)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_tabs">
		<xs:annotation><xs:documentation>A row of tab buttons over the selected tab's content. Each tab is a `&lt;ds_tabs-tab&gt;` inside it; the first starts selected. Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_tabs-tab">
		<xs:annotation><xs:documentation>One tab of a `&lt;ds_tabs&gt;`, written inside it. Its content is the tab's page; the lv_obj attributes apply to that page. Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attribute name="title" type="xs:string">
				<xs:annotation><xs:documentation>The tab button's text, if there is no `title_tag`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="title_tag" type="translation">
				<xs:annotation><xs:documentation>Translation key for the tab button's text</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_disabled" type="subject">
				<xs:annotation><xs:documentation>Disable the tab's button while this int subject is non-zero</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="select_on" type="subject">
				<xs:annotation><xs:documentation>Select the tab whenever this subject changes to a non-empty text or non-zero int, e.g. the status tab when a job starts: `select_on=&quot;job.file&quot;`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_textarea">
		<xs:annotation><xs:documentation>A text box that brings up an on-screen keyboard while it is being edited. The keyboard's own close key always puts it away. Raises `focused`, `defocused`, `ready` and `cancel` as the edit starts and ends, and `value_changed` on every edit; handlers read the text with ActionArgs::text(). Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attribute name="bind_text" type="subject">
				<xs:annotation><xs:documentation>Follow a text subject: the box shows its value whenever it changes to something other than what is in the box, so a presenter that keeps the subject equal to the edits can replace the text at any time</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_accepted_chars" type="subject">
				<xs:annotation><xs:documentation>Follow a text subject for the characters that may be typed; empty for any</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="keyboard_mode" type="xs:string">
				<xs:annotation><xs:documentation>Keyboard layout to show: `text` (default), `text_upper` or `number`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_keyboard_mode" type="subject">
				<xs:annotation><xs:documentation>Follow a text subject for the keyboard layout, as `keyboard_mode`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="keyboard" type="xs:string">
				<xs:annotation><xs:documentation>The keyboard to use: the nearest lv_keyboard of that name around the box (e.g. one in the same view), else the view of that name (default `keyboard`, the shared one); `none` for a box edited another way, such as a number pad</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="hide_keyboard_on_ready" type="xs:string">
				<xs:annotation><xs:documentation>Put the keyboard away when its OK key is pressed (default true)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="hide_keyboard_on_defocus" type="xs:string">
				<xs:annotation><xs:documentation>Put the keyboard away when the box loses focus (default true)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="one_line" type="xs:string">
				<xs:annotation><xs:documentation>&quot;true&quot; for a single line of text</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="password_mode" type="xs:string">
				<xs:annotation><xs:documentation>&quot;true&quot; to show dots for the characters, e.g. for a password</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="placeholder" type="xs:string">
				<xs:annotation><xs:documentation>Text shown while the box is empty</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="placeholder_tag" type="translation">
				<xs:annotation><xs:documentation>Translation key for the placeholder, instead of `placeholder`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_thumbnail">
		<xs:annotation><xs:documentation>An image as tall as its parent's content and as wide as its aspect ratio needs, so a thumbnail beside some text is as large as it can be without making the row taller. With no image it takes no width. Also takes every lv_image attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attribute name="bind_src" type="subject">
				<xs:annotation><xs:documentation>Follow a text subject holding an image path; empty shows no image</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_toggle">
		<xs:annotation><xs:documentation>An on/off setting, drawn as the build's toggle (a check box or a switch), so every setting looks the same. Raises `value_changed` when it is changed; the action's value is 1 when turned on and 0 when off. Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_view">
		<xs:annotation><xs:documentation>A view inside a screen, e.g. a page of the home screen, registered with navigation as its `name` (default: its `view`) so it can be opened with `nav.open`. A view starts hidden, like any screen that isn't open. Every lv_obj attribute works except `hidden`, which navigation owns. Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attribute name="view" type="view">
				<xs:annotation><xs:documentation>The XML component shown (with its presenter), or if there is no such component, a C++ view</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="presenter" type="presenter">
				<xs:annotation><xs:documentation>Show the component with this registered presenter instead of the one it names, so one component can show different data in different places</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="home" type="xs:string">
				<xs:annotation><xs:documentation>&quot;true&quot; to make it a home screen: shown when nothing else is open (default false)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="shown" type="xs:string">
				<xs:annotation><xs:documentation>&quot;true&quot; to show it without taking part in navigation, for always-present parts such as a status bar or the page in a tab: shown, and its presenter active, whenever what it is in is shown (default false)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="action">
		<xs:annotation><xs:documentation>Written `&lt;action&gt;` inside any widget: run the named action when the widget raises the trigger event. The action is looked for in the presenters of the views the widget is in, innermost first, then in the global actions.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attribute name="name" type="action">
				<xs:annotation><xs:documentation>The action to run (required)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="trigger" type="trigger">
				<xs:annotation><xs:documentation>The event that runs it (default `clicked`): an LVGL event name such as `value_changed` or `long_pressed`, `value_confirmed` (a DuetScreen widget's edit is finished) or `dismissed` (a `&lt;ds_modal&gt;` was closed by the user)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="arg" type="xs:string">
				<xs:annotation><xs:documentation>Passed to the handler. `{value}` is replaced by the edited value, and `{name}` by the current value of the subject `name`, looked up from where the `&lt;action&gt;` is written</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="babystep">
		<xs:annotation><xs:documentation>Component from assets/ui/components/common/babystep.xml, with presenter babystep.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="babystep_step">
		<xs:annotation><xs:documentation>Component from assets/ui/components/common/babystep_step.xml.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="confirm_dialog">
		<xs:annotation><xs:documentation>Component from assets/ui/components/common/confirm_dialog.xml.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attribute name="open" type="xs:string">
				<xs:annotation><xs:documentation>Prop `open` (string)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="title_tag" type="xs:string">
				<xs:annotation><xs:documentation>Prop `title_tag` (string)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="text_tag" type="xs:string">
				<xs:annotation><xs:documentation>Prop `text_tag` (string)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="confirm" type="xs:string">
				<xs:annotation><xs:documentation>Prop `confirm` (string)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="close" type="xs:string">
				<xs:annotation><xs:documentation>Prop `close` (string)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="console">
		<xs:annotation><xs:documentation>Component from assets/ui/components/console/console.xml, with presenter console.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="console_gcode">
		<xs:annotation><xs:documentation>Component from assets/ui/components/console/console_gcode.xml.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="console_line">
		<xs:annotation><xs:documentation>Component from assets/ui/components/console/console_line.xml.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="control">
