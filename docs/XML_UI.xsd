		</xs:attribute>
		<xs:attribute name="grid_cell_row_pos" type="xs:string">
			<xs:annotation><xs:documentation>Set cell's row</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="grid_cell_row_span" type="xs:string">
			<xs:annotation><xs:documentation>How many rows the cell should span</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="grid_cell_y_align" type="lv_grid_align">
			<xs:annotation><xs:documentation>How to align the cell vertically</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="opa" type="xs:string">
			<xs:annotation><xs:documentation>Scale down the opacity of the widget and all its children</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="opa_layered" type="xs:string">
			<xs:annotation><xs:documentation>Create a snapshot from the widget and blend it with opacity</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="anim_duration" type="xs:string">
			<xs:annotation><xs:documentation>Set animation duration in ms (e.g. for label scroll)</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="blend_mode" type="lv_blend_mode">
			<xs:annotation><xs:documentation>Set how to blend colors</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="transform_width" type="xs:string">
			<xs:annotation><xs:documentation>Change the width without affecting the layouts</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="transform_height" type="xs:string">
			<xs:annotation><xs:documentation>Change the height without affecting the layouts</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="translate_x" type="xs:string">
			<xs:annotation><xs:documentation>Offset in X after the layouts are calculated</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="translate_y" type="xs:string">
			<xs:annotation><xs:documentation>Offset in Y after the layouts are calculated</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="translate_radial" type="xs:string">
			<xs:annotation><xs:documentation>Translate radial</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="transform_scale_x" type="xs:string">
			<xs:annotation><xs:documentation>Scale X (256=100%)</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="transform_scale_y" type="xs:string">
			<xs:annotation><xs:documentation>Scale Y (256=100%)</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="transform_rotation" type="xs:string">
			<xs:annotation><xs:documentation>Rotate (0.1° units)</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="transform_pivot_x" type="xs:string">
			<xs:annotation><xs:documentation>Set pivot X</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="transform_pivot_y" type="xs:string">
			<xs:annotation><xs:documentation>Set pivot Y</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="transform_skew_x" type="xs:string">
			<xs:annotation><xs:documentation>Skew X (no SW render)</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="transform_skew_y" type="xs:string">
			<xs:annotation><xs:documentation>Skew Y (no SW render)</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="bitmap_mask_src" type="image">
			<xs:annotation><xs:documentation>Set bitmap mask (A8 or L8)</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="rotary_sensitivity" type="xs:string">
			<xs:annotation><xs:documentation>Set rotary sensitivity for Crown input devices</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="recolor" type="xs:string">
			<xs:annotation><xs:documentation>Mix this color to the widget and all its children</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="recolor_opa" type="xs:string">
			<xs:annotation><xs:documentation>The intensity of recoloring</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="color_filter_opa" type="xs:string">
			<xs:annotation><xs:documentation>The intensity of the color filter</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="blur_radius" type="xs:string">
			<xs:annotation><xs:documentation>The radius of the blurring</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="blur_quality" type="xs:string">
			<xs:annotation><xs:documentation>Set whether to prefer speed or precision</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="blur_backdrop" type="bool">
			<xs:annotation><xs:documentation>true: blur the background first, false: blur the widget</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="transition" type="xs:string">
			<xs:annotation><xs:documentation>`&lt;props&gt; &lt;duration&gt; [easing] [delay]`, e.g. `bg_color|border_color 200ms ease_out`</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="transition_props" type="xs:string">
			<xs:annotation><xs:documentation>The properties that animate, `|` or `,` separated</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="transition_duration" type="xs:string">
			<xs:annotation><xs:documentation>How long, in ms (`200` or `200ms`)</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="transition_easing" type="lv_transition_easing">
			<xs:annotation><xs:documentation>How it speeds up and slows down</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="transition_delay" type="xs:string">
			<xs:annotation><xs:documentation>How long before it starts, in ms (`50` or `50ms`)</xs:documentation></xs:annotation>
		</xs:attribute>
	</xs:attributeGroup>
	<xs:attributeGroup name="value_selector.attributes">
		<xs:attribute name="selector" type="xs:string">
			<xs:annotation><xs:documentation>Prop `selector` (string)</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="title" type="xs:string">
			<xs:annotation><xs:documentation>Prop `title` (string)</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="value" type="xs:string">
			<xs:annotation><xs:documentation>Prop `value` (string)</xs:documentation></xs:annotation>
		</xs:attribute>
		<xs:attribute name="choices" type="xs:string">
			<xs:annotation><xs:documentation>Prop `choices` (string)</xs:documentation></xs:annotation>
		</xs:attribute>
	</xs:attributeGroup>
	<xs:element name="component">
		<xs:annotation><xs:documentation>A component: an `&lt;api&gt;` of props, `&lt;consts&gt;`, `&lt;styles&gt;`, `&lt;subjects&gt;`, and its `&lt;view&gt;`.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attribute name="presenter" type="presenter">
				<xs:annotation><xs:documentation>The presenter that gives its view names and handles its actions</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="api">
		<xs:annotation><xs:documentation>The props the component takes</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="consts">
		<xs:annotation><xs:documentation>The component's consts, written `#name` in its attributes</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="styles">
		<xs:annotation><xs:documentation>The component's styles, each a `&lt;style name=&quot;…&quot; …/&gt;`</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="subjects">
		<xs:annotation><xs:documentation>The component's own subjects</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="prop">
		<xs:annotation><xs:documentation>A prop: `&lt;my_component title=&quot;…&quot;/&gt;` sets `$title` inside the component</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attribute name="name" type="xs:string">
				<xs:annotation><xs:documentation>Its name</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="type" type="xs:string">
				<xs:annotation><xs:documentation>Its type, e.g. string</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="default" type="xs:string">
				<xs:annotation><xs:documentation>Its value when not given</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="view">
		<xs:annotation><xs:documentation>The component's root widget. Takes every attribute of the widget it extends.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attribute name="extends" type="widget">
				<xs:annotation><xs:documentation>The widget, or component, it is (default lv_obj)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attributeGroup ref="lv_obj.attributes"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="style">
		<xs:annotation><xs:documentation>Inside a widget: add the style called `name`. Inside `&lt;styles&gt;`: define a style.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attribute name="name" type="style">
				<xs:annotation><xs:documentation>The style</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="selector" type="selector">
				<xs:annotation><xs:documentation>The part and state it applies to</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="parts" type="xs:string">
				<xs:annotation><xs:documentation>Several parts at once, comma separated, e.g. main,indicator,knob; with a state in `selector`, the state applies to each</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attributeGroup ref="styledef.attributes"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_bar">
		<xs:annotation><xs:documentation>A progress bar that draws its value as text, inside the filled part when it fits Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attributeGroup ref="ds_bar.attributes"/>
			<xs:attributeGroup ref="lv_obj.attributes"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_bar_marker">
		<xs:annotation><xs:documentation>A value marked on a bar, such as a heater's target temperature above its current-temperature bar: a button showing the value, placed along the bar where the value falls and pointing at it with a triangle (the indicator part's background colour). Its x position is set from the value; set its y with `align` and `y`. Drag it along the bar to choose a value, raising `value_confirmed` with it when released (the marker shows the dragged value until the subject changes), or tap it to raise `clicked`; a drag doesn't raise `clicked`. Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attributeGroup ref="ds_bar_marker.attributes"/>
			<xs:attributeGroup ref="lv_obj.attributes"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_button">
		<xs:annotation><xs:documentation>A button showing text, an icon or both Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attributeGroup ref="ds_button.attributes"/>
			<xs:attribute name="name" type="xs:string">
				<xs:annotation><xs:documentation>Object name (for lv_obj_find_by_name or debugging)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="x" type="size">
				<xs:annotation><xs:documentation>Set X position (px or %)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="y" type="size">
				<xs:annotation><xs:documentation>Set Y position (px or %)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="height" type="size">
				<xs:annotation><xs:documentation>Set height (px, % or content)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="width" type="size">
				<xs:annotation><xs:documentation>Set width (px, % or content)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="align" type="lv_align">
				<xs:annotation><xs:documentation>Align on parent</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="ext_click_area" type="xs:string">
				<xs:annotation><xs:documentation>Extra clickable area around object in px</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="scroll_snap_x" type="lv_scroll_snap">
				<xs:annotation><xs:documentation>Snap children horizontally</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="scroll_snap_y" type="lv_scroll_snap">
				<xs:annotation><xs:documentation>Snap children vertically</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="scrollbar_mode" type="lv_scrollbar_mode">
				<xs:annotation><xs:documentation>Set the scrollbar mode</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="scroll_dir" type="lv_dir">
				<xs:annotation><xs:documentation>Directions the object can be scrolled in</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="ext_draw_size" type="xs:string">
				<xs:annotation><xs:documentation>Extra area around the object it may draw in, in px, e.g. so a child dragged out of it isn't clipped</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="style_height" type="size">
				<xs:annotation><xs:documentation>Set height (px, %, or content). Add a part or state after a dash to style only that, e.g. `-pressed`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="style_min_height" type="size">
				<xs:annotation><xs:documentation>Set min height (px, %, or content). Add a part or state after a dash to style only that, e.g. `-pressed`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="style_max_height" type="size">
				<xs:annotation><xs:documentation>Set max height (px, %, or content). Add a part or state after a dash to style only that, e.g. `-pressed`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="style_width" type="size">
				<xs:annotation><xs:documentation>Set width (px, %, or content). Add a part or state after a dash to style only that, e.g. `-pressed`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="style_min_width" type="size">
				<xs:annotation><xs:documentation>Set min width (px, %, or content). Add a part or state after a dash to style only that, e.g. `-pressed`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="style_max_width" type="size">
				<xs:annotation><xs:documentation>Set max width (px, %, or content). Add a part or state after a dash to style only that, e.g. `-pressed`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="style_length" type="size">
				<xs:annotation><xs:documentation>Set length (used by some widgets). Add a part or state after a dash to style only that, e.g. `-pressed`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="style_pad_top" type="xs:string">
				<xs:annotation><xs:documentation>Keep this distance on the top from the content inside. Add a part or state after a dash to style only that, e.g. `-pressed`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="style_pad_bottom" type="xs:string">
				<xs:annotation><xs:documentation>Keep this distance on the bottom from the content inside. Add a part or state after a dash to style only that, e.g. `-pressed`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="style_pad_left" type="xs:string">
				<xs:annotation><xs:documentation>Keep this distance on the left from the content inside. Add a part or state after a dash to style only that, e.g. `-pressed`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="style_pad_right" type="xs:string">
				<xs:annotation><xs:documentation>Keep this distance on the right from the content inside. Add a part or state after a dash to style only that, e.g. `-pressed`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="style_pad_hor" type="xs:string">
				<xs:annotation><xs:documentation>Set both left and right padding. Add a part or state after a dash to style only that, e.g. `-pressed`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="style_pad_ver" type="xs:string">
				<xs:annotation><xs:documentation>Set both top and bottom padding. Add a part or state after a dash to style only that, e.g. `-pressed`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="style_pad_all" type="xs:string">
				<xs:annotation><xs:documentation>Set padding in all 4 directions. Add a part or state after a dash to style only that, e.g. `-pressed`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="style_pad_row" type="xs:string">
				<xs:annotation><xs:documentation>Set padding between rows of layouts. Add a part or state after a dash to style only that, e.g. `-pressed`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="style_pad_column" type="xs:string">
				<xs:annotation><xs:documentation>Set padding between columns of layouts. Add a part or state after a dash to style only that, e.g. `-pressed`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="style_pad_gap" type="xs:string">
				<xs:annotation><xs:documentation>Set both the row and the column padding. Add a part or state after a dash to style only that, e.g. `-pressed`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="style_pad_radial" type="xs:string">
				<xs:annotation><xs:documentation>Set radial padding. Add a part or state after a dash to style only that, e.g. `-pressed`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="style_margin_top" type="xs:string">
				<xs:annotation><xs:documentation>Keep distance above the widget when used in a layout. Add a part or state after a dash to style only that, e.g. `-pressed`</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="style_margin_bottom" type="xs:string">
				<xs:annotation><xs:documentation>Keep distance below the widget when used in a layout. Add a part or state after a dash to style only that, e.g. `-pressed`</xs:documentation></xs:annotation>
