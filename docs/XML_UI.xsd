				<xs:annotation><xs:documentation>Set flex grow to fill the available space in the track</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="flex_flow" type="lv_flex_flow">
				<xs:annotation><xs:documentation>Set flex flow direction (row, column, etc.)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="checked" type="bool">
				<xs:annotation><xs:documentation>Mark widget as checked (e.g. switch or checkbox)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="focused" type="bool">
				<xs:annotation><xs:documentation>Mark widget as focused</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="focus_key" type="bool">
				<xs:annotation><xs:documentation>Mark widget as focused via key navigation</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="edited" type="bool">
				<xs:annotation><xs:documentation>Mark widget as being edited (e.g. text input)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="hovered" type="bool">
				<xs:annotation><xs:documentation>Mark widget as hovered by a pointer</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="pressed" type="bool">
				<xs:annotation><xs:documentation>Mark widget as pressed</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="scrolled" type="bool">
				<xs:annotation><xs:documentation>Mark widget as being scrolled</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="disabled" type="bool">
				<xs:annotation><xs:documentation>Disable widget interaction</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="hidden" type="bool">
				<xs:annotation><xs:documentation>Make the object hidden. (Like it wasn't there at all)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="clickable" type="bool">
				<xs:annotation><xs:documentation>Make the object clickable by the input devices</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="click_focusable" type="bool">
				<xs:annotation><xs:documentation>Add focused state to the object when clicked</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="scrollable" type="bool">
				<xs:annotation><xs:documentation>Make the object scrollable</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="scroll_elastic" type="bool">
				<xs:annotation><xs:documentation>Allow scrolling inside but with slower speed</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="scroll_momentum" type="bool">
				<xs:annotation><xs:documentation>Make the object scroll further when 'thrown'</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="scroll_one" type="bool">
				<xs:annotation><xs:documentation>Allow scrolling only one snappable children</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="scroll_chain_hor" type="bool">
				<xs:annotation><xs:documentation>Allow propagating the horizontal scroll to a parent</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="scroll_chain_ver" type="bool">
				<xs:annotation><xs:documentation>Allow propagating the vertical scroll to a parent</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="scroll_chain" type="bool">
				<xs:annotation><xs:documentation>SCROLL_CHAIN_HOR and SCROLL_CHAIN_VER</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="scroll_on_focus" type="bool">
				<xs:annotation><xs:documentation>Automatically scroll object to make it visible when focused</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="scroll_with_arrow" type="bool">
				<xs:annotation><xs:documentation>Allow scrolling the focused object with arrow keys</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="snappable" type="bool">
				<xs:annotation><xs:documentation>If scroll snap is enabled on the parent it can snap to this object</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="press_lock" type="bool">
				<xs:annotation><xs:documentation>Keep the object pressed even if the press slid from the object</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="event_bubble" type="bool">
				<xs:annotation><xs:documentation>Propagate the events to the parent too</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="event_trickle" type="bool">
				<xs:annotation><xs:documentation>Send events to children first</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="state_trickle" type="bool">
				<xs:annotation><xs:documentation>Propagate state changes to children</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="gesture_bubble" type="bool">
				<xs:annotation><xs:documentation>Propagate the gestures to the parent</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="adv_hittest" type="bool">
				<xs:annotation><xs:documentation>Allow performing more accurate hit (click) test. E.g. consider rounded corners.</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="ignore_layout" type="bool">
				<xs:annotation><xs:documentation>Make the object not positioned by the layouts</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="floating" type="bool">
				<xs:annotation><xs:documentation>Do not scroll the object when the parent scrolls and ignore layout</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="send_draw_task_events" type="bool">
				<xs:annotation><xs:documentation>Send `LV_EVENT_DRAW_TASK_ADDED` events</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="overflow_visible" type="bool">
				<xs:annotation><xs:documentation>Do not clip the children to the parent's ext draw size</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="radio_button" type="bool">
				<xs:annotation><xs:documentation>Allow only one radio_button sibling to be checked (can't be bound: LVGL 9.6 gives it no flag bit)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="flex_in_new_track" type="bool">
				<xs:annotation><xs:documentation>Start a new flex track on this item</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_checked" type="subject">
				<xs:annotation><xs:documentation>Bind widget’s checked state to a subject</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="hidden_if_prop_eq" type="xs:string">
				<xs:annotation><xs:documentation>`$prop|value`: hide the object when the prop equals the value. Decided once, at creation</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="hidden_if_prop_not_eq" type="xs:string">
				<xs:annotation><xs:documentation>`$prop|value`: hide the object unless the prop equals the value. Decided once, at creation</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="hidden_if_empty" type="xs:string">
				<xs:annotation><xs:documentation>Hide the object when the value, typically a `$prop`, is empty. Decided once, at creation</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="moves_machine" type="bool">
				<xs:annotation><xs:documentation>true: disabled while the `machine_motion_blocked` subject is 1, for controls that move the machine</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_dropdown">
		<xs:annotation><xs:documentation>A drop-down list whose options and text follow subjects. The option chosen reaches a `value_changed` action as its text (ActionArgs::text()) and its index (ActionArgs::value()). Also takes every lv_dropdown attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attributeGroup ref="ds_dropdown.attributes"/>
			<xs:attribute name="text" type="xs:string">
				<xs:annotation><xs:documentation>Set text displayed instead of the selected option label</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="options" type="xs:string">
				<xs:annotation><xs:documentation>Set options as a newline (`\n`) separated string</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="selected" type="xs:string">
				<xs:annotation><xs:documentation>Select an option by index (0-based)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="symbol" type="xs:string">
				<xs:annotation><xs:documentation>Set a symbol shown next to the dropdown</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="bind_value" type="subject">
				<xs:annotation><xs:documentation>Bind the selected option index to a subject</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="options_tag" type="xs:string">
				<xs:annotation><xs:documentation>Translation tags for the options, newline (`\n`) separated; the options follow language changes, keeping the selection</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attributeGroup ref="lv_obj.attributes"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_graph">
		<xs:annotation><xs:documentation>A line graph of a history, with a legend whose buttons show and hide series. Series are coloured by position from LVGL's palette (red, pink, purple, …). The graph starts with what was recorded before it was built, and follows series being added, removed and renamed. Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attributeGroup ref="ds_graph.attributes"/>
			<xs:attributeGroup ref="lv_obj.attributes"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_heatmap">
		<xs:annotation><xs:documentation>A colour map of a surface, such as a bed's height map, with X and Y scales, a grid, a title, and the colour scale beside it Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attributeGroup ref="ds_heatmap.attributes"/>
			<xs:attributeGroup ref="lv_obj.attributes"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_hue_slider">
		<xs:annotation><xs:documentation>A `&lt;ds_slider&gt;` for a hue, 0 to 360, whose track shows every hue at a lightness and chroma, so the slider is a colour picker, e.g. for a theme's primary colour. `min` and `max` default to 0 and 360. Also takes every ds_slider attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attributeGroup ref="ds_hue_slider.attributes"/>
			<xs:attributeGroup ref="ds_slider.attributes"/>
			<xs:attributeGroup ref="lv_obj.attributes"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_icon">
		<xs:annotation><xs:documentation>An icon from the icon set chosen in the settings, coloured by the theme. It follows icon set changes. Also takes every lv_image attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attributeGroup ref="ds_icon.attributes"/>
			<xs:attributeGroup ref="lv_image.attributes"/>
			<xs:attributeGroup ref="lv_obj.attributes"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_keyboard">
		<xs:annotation><xs:documentation>An on-screen keyboard with DuetScreen's key layouts. A `&lt;ds_textarea&gt;` brings it up and types into it, so it is usually written `hidden=&quot;true&quot;`; or, with `textarea`, it always types into one box, as the number pad's keys do. Its OK key raises `ready`. Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attributeGroup ref="ds_keyboard.attributes"/>
			<xs:attributeGroup ref="lv_obj.attributes"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_list">
		<xs:annotation><xs:documentation>A container with one component per row of a list. Each item is built in a scope of its own holding its row's fields, so names are found in the row first, then where the list is written. With `windowed`, only the rows on screen are built, so a folder of a thousand files costs a screenful of widgets; every item then has the same size, and the list places them itself (its own layout is ignored), with its style_pad_row and style_pad_column as the gaps. Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attributeGroup ref="ds_list.attributes"/>
			<xs:attributeGroup ref="lv_obj.attributes"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_modal">
		<xs:annotation><xs:documentation>A dialog over the main window with a dimmed backdrop. Its subject alone decides whether it is open, so a presenter opens and closes it by setting a subject. Closed any other way (tapped outside, the back button, navigation closing every modal), it raises `dismissed` so the presenter can update the subject; closing it by its subject raises nothing. The content is laid out in the dialog's card, which the lv_obj attributes apply to. Unless `in_place`, it is deleted with the widget it was written in. Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attributeGroup ref="ds_modal.attributes"/>
			<xs:attributeGroup ref="lv_obj.attributes"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_password_toggle">
		<xs:annotation><xs:documentation>An eye button that shows what is typed in a password box while it is checked, and hides it again when unchecked. Tapping it doesn't take the focus from the box, so the keyboard stays up. Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attributeGroup ref="ds_password_toggle.attributes"/>
			<xs:attributeGroup ref="lv_obj.attributes"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_plot">
		<xs:annotation><xs:documentation>An X/Y area with scales and a grid, such as the bed with its objects, whose content is widgets placed by X/Y position. `&lt;ds_plot_layer&gt;`s written inside it are kept over its drawing area, and `&lt;ds_plot_rect&gt;`s inside a layer are kept at their X/Y bounds. Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attributeGroup ref="ds_plot.attributes"/>
			<xs:attributeGroup ref="lv_obj.attributes"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_plot_layer">
		<xs:annotation><xs:documentation>A layer written inside a `&lt;ds_plot&gt;`, kept exactly over its drawing area, for widgets placed by X/Y position such as `&lt;ds_plot_rect&gt;`s. It doesn't scroll and has no padding; the plot sets its position and size. Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attributeGroup ref="lv_obj.attributes"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_plot_rect">
		<xs:annotation><xs:documentation>A rectangle kept at its X/Y bounds over a `&lt;ds_plot&gt;`, e.g. an object on the bed. It is written inside a `&lt;ds_plot_layer&gt;` of the plot, directly or deeper (in a list row, say), and hidden while its bounds are outside the plot's span. It sets its own position and size. Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attributeGroup ref="ds_plot_rect.attributes"/>
			<xs:attributeGroup ref="lv_obj.attributes"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_slider">
		<xs:annotation><xs:documentation>A slider with a label, its value and -/+ buttons, and optionally a number pad. Raises `value_confirmed` with the value when the user finishes an edit (releases it, presses -/+ or types a value), or with `send=&quot;change&quot;` on every movement. Values written by `bind_value` are not edits and raise nothing, so a view can show live data and send changes without echoing the data back to the printer. Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attributeGroup ref="ds_slider.attributes"/>
			<xs:attributeGroup ref="lv_obj.attributes"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_tabs">
		<xs:annotation><xs:documentation>A row of tab buttons over the selected tab's content. Each tab is a `&lt;ds_tabs-tab&gt;` inside it; the first starts selected. Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attributeGroup ref="lv_obj.attributes"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_tabs-tab">
		<xs:annotation><xs:documentation>One tab of a `&lt;ds_tabs&gt;`, written inside it. Its content is the tab's page; the lv_obj attributes apply to that page. Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attributeGroup ref="ds_tabs-tab.attributes"/>
			<xs:attributeGroup ref="lv_obj.attributes"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_textarea">
		<xs:annotation><xs:documentation>A text box that brings up an on-screen keyboard while it is being edited. The keyboard's own close key always puts it away. Raises `focused`, `defocused`, `ready` and `cancel` as the edit starts and ends, and `value_changed` on every edit; handlers read the text with ActionArgs::text(). Text written by `bind_text` is not an edit and raises nothing, so a handler can store each edit in the subject the box shows. Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attributeGroup ref="ds_textarea.attributes"/>
			<xs:attributeGroup ref="lv_obj.attributes"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_thumbnail">
		<xs:annotation><xs:documentation>An image as tall as its parent's content and as wide as its aspect ratio needs, so a thumbnail beside some text is as large as it can be without making the row taller. With no image it takes no width. Also takes every lv_image attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attributeGroup ref="ds_thumbnail.attributes"/>
			<xs:attribute name="src" type="image">
				<xs:annotation><xs:documentation>Set the image source (file, symbol, or variable)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="inner_align" type="lv_image_align">
				<xs:annotation><xs:documentation>Align and scale the image inside</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="rotation" type="xs:string">
				<xs:annotation><xs:documentation>Rotate the image (degrees)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="scale_x" type="xs:string">
				<xs:annotation><xs:documentation>Scale horizontally (100 = original)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="scale_y" type="xs:string">
				<xs:annotation><xs:documentation>Scale vertically (100 = original)</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="pivot_x" type="xs:string">
				<xs:annotation><xs:documentation>Set the pivot X for rotation/scaling</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attribute name="pivot_y" type="xs:string">
				<xs:annotation><xs:documentation>Set the pivot Y for rotation/scaling</xs:documentation></xs:annotation>
			</xs:attribute>
			<xs:attributeGroup ref="lv_obj.attributes"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_toggle">
		<xs:annotation><xs:documentation>An on/off setting, drawn as the build's toggle (a check box or a switch), so every setting looks the same. Raises `value_changed` when it is changed; the action's value is 1 when turned on and 0 when off. Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attributeGroup ref="lv_obj.attributes"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="ds_view">
		<xs:annotation><xs:documentation>A view inside a screen, e.g. a page of the home screen, registered with navigation as its `name` (default: its `view`) so it can be opened with `nav.open`. A view starts hidden, like any screen that isn't open. Every lv_obj attribute works except `hidden`, which navigation owns. Also takes every lv_obj attribute.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attributeGroup ref="ds_view.attributes"/>
			<xs:attributeGroup ref="lv_obj.attributes"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="action">
		<xs:annotation><xs:documentation>Written `&lt;action&gt;` inside any widget: run the named action when the widget raises the trigger event. The action is looked for in the presenters of the views the widget is in, innermost first, then in the global actions.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attributeGroup ref="lv_obj-action.attributes"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="lv_arc">
		<xs:annotation><xs:documentation>LVGL's lv_arc widget.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attributeGroup ref="lv_arc.attributes"/>
			<xs:attributeGroup ref="lv_obj.attributes"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="lv_bar">
		<xs:annotation><xs:documentation>LVGL's lv_bar widget.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attributeGroup ref="lv_bar.attributes"/>
			<xs:attributeGroup ref="lv_obj.attributes"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="lv_button">
		<xs:annotation><xs:documentation>LVGL's lv_button widget.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attributeGroup ref="lv_obj.attributes"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="lv_buttonmatrix">
		<xs:annotation><xs:documentation>LVGL's lv_buttonmatrix widget.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attributeGroup ref="lv_buttonmatrix.attributes"/>
			<xs:attributeGroup ref="lv_obj.attributes"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="lv_calendar">
		<xs:annotation><xs:documentation>LVGL's lv_calendar widget.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attributeGroup ref="lv_calendar.attributes"/>
			<xs:attributeGroup ref="lv_obj.attributes"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="lv_calendar-header_arrow">
		<xs:annotation><xs:documentation>Add arrow buttons for navigating months.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="lv_calendar-header_dropdown">
		<xs:annotation><xs:documentation>Add a dropdown for selecting months or years.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="lv_canvas">
		<xs:annotation><xs:documentation>LVGL's lv_canvas widget.</xs:documentation></xs:annotation>
		<xs:complexType>
			<xs:group ref="anyContent"/>
			<xs:attributeGroup ref="lv_obj.attributes"/>
			<xs:anyAttribute processContents="lax"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="lv_chart">
